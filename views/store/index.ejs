    const c = ALL_CURRENCIES.find(item => item.key === currKey);
    if (c && c.icon) {
      return `<span class="material-symbols-outlined ${sizeClass} rounded-full flex items-center justify-center text-[15px] ${c.iconColor || 'text-emerald-500 bg-emerald-50'} border border-emerald-200 shrink-0 font-bold">${c.icon}</span>`;
    }
    const imgSrc = (c && c.img) ? c.img : `/${currKey.toLowerCase()}.png`;
    return `<img src="${imgSrc}" onerror="this.src='/logo.png'" class="${sizeClass} object-contain rounded-full bg-slate-50 shrink-0">`;
  }

  function refreshCurrencyBadges() {
    document.querySelectorAll('.curr-badge-slot').forEach(el => {
      const key = el.getAttribute('data-curr');
      if (key && !el.hasChildNodes()) {
        el.innerHTML = renderCurrencyBadge(key, 'w-5 h-5');
      }
    });
