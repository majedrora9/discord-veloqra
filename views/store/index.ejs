<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - المتجر والخدمات</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Veloqra">
  <meta property="og:title" content="Veloqra Store">
  <meta property="og:description" content="متجر الكتروني متاح للجميع - بيع وشراء">
  <meta property="og:image" content="/logo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css"/>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffe27a',
              gold: '#ffe27a'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    body.modal-lock, html.modal-lock {
      overflow: hidden !important;
      height: 100vh !important;
      touch-action: none;
    }

    .page-clean-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }
    .page-clean-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.9) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }
    .page-clean-header nav span, .page-clean-header nav a {
      color: #0a122c !important;
    }
    .page-clean-header nav .hidden.md\:flex a:hover { color: #4287f5 !important; }
    .page-clean-header nav .hidden.md\:block a {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }

    .store-card-modern {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.25rem;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      position: relative;
    }
    .store-card-modern:hover {
      border-color: #cbd5e1;
      transform: translateY(-4px);
      box-shadow: 0 16px 32px -8px rgba(10, 18, 44, 0.08);
    }

    .store-card-pinned {
      background: #ffffff !important;
      border: 2px solid #FFE27A !important;
      box-shadow: 0 10px 25px -5px rgba(255, 226, 122, 0.35) !important;
    }

    .custom-modal-scroll::-webkit-scrollbar {
      width: 5px;
    }
    .custom-modal-scroll::-webkit-scrollbar-track {
      background: #f8fafc;
    }
    .custom-modal-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }

    .trash-btn-circle {
      width: 30px;
      height: 30px;
      border-radius: 9999px;
      background-color: #fee2e2;
      color: #ef4444;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid #fecaca;
      cursor: pointer;
    }
    .trash-btn-circle:hover {
      background-color: #fecaca;
      color: #dc2626;
      transform: scale(1.08);
    }
    .trash-btn-circle .material-symbols-outlined {
      font-size: 16px;
      color: #ef4444;
    }

    .pin-btn-circle {
      width: 30px;
      height: 30px;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .pin-btn-circle.pinned {
      background: #fff8db;
      border: 1px solid #ffe27a;
      color: #b45309;
    }
    .pin-btn-circle.unpinned {
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      color: #94a3b8;
    }
    .pin-btn-circle:hover {
      transform: scale(1.08);
    }

    #appToast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(120%);
      padding: 0.85rem 1.5rem;
      border-radius: 1.25rem;
      font-size: 0.85rem;
      font-weight: 700;
      z-index: 999999;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #appToast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .custom-select-wrap {
      position: relative;
      width: 100%;
    }
    .custom-select-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
      padding: 0.55rem 0.8rem;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 700;
      color: #0a122c;
      transition: all 0.2s ease;
      width: 100%;
    }
    .custom-select-trigger:hover {
      border-color: #4287f5;
    }
    .custom-select-dropdown {
      position: absolute;
      top: calc(100% + 5px);
      right: 0;
      left: 0;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      box-shadow: 0 15px 35px -5px rgba(10, 18, 44, 0.15);
      z-index: 100;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 240px;
    }
    .custom-select-dropdown.active {
      display: flex;
    }
    .custom-select-search {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid #f1f5f9;
      background: #f8fafc;
    }
    .custom-select-options {
      overflow-y: auto;
      max-height: 180px;
    }
    .custom-select-option {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.85rem;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      transition: background 0.15s ease;
    }
    .custom-select-option:hover {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .quick-prices-popover {
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%);
      width: 260px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.25rem;
      padding: 0.85rem;
      box-shadow: 0 15px 35px -5px rgba(10, 18, 44, 0.16);
      z-index: 40;
      display: none;
    }
    .quick-prices-popover.active {
      display: block;
    }
  </style>
</head>
<body class="loading-active text-slate-800 antialiased selection:bg-[#ffe27a] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="simple-spinner"></div>
  </div>

  <div id="appToast" class="flex items-center gap-2.5 shadow-2xl border">
    <span class="material-symbols-outlined text-lg" id="toastIcon">check_circle</span>
    <span id="toastMsg">تمت العملية بنجاح</span>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('../partials/header') %>
  </header>

  <main class="w-full relative flex-1 py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          متجر فيلوكرا الإلكتروني
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base mt-2">
          تصفح العروض الحصرية والخدمات المتنوعة مع خيارات دفع متعددة وضمان كامل
        </p>
      </div>

      <!-- قسم البحث والإجراءات -->
      <div class="mb-10 p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/90 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex-1 w-full">
          <div class="relative w-full">
            <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">search</span>
            <input 
              type="text" 
              id="liveSearchInput"
              value="<%= currentSearch %>" 
              oninput="handleLiveSearch(this.value)"
              placeholder="ابحث عن منتج، وصف، أو اسم بائع..." 
              autocomplete="off"
              class="w-full pr-11 pl-4 py-3 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-medium focus:outline-none focus:border-blue-500 transition-all shadow-2xs"
            >
          </div>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <% if (user) { %>
            <a href="/store/publish" class="flex-1 md:flex-initial flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-[#ffe27a] hover:bg-[#ffd000] text-[#070b1a] text-xs font-bold transition-all shadow-sm cursor-pointer no-underline">
              <span class="material-symbols-outlined text-base">add</span>
              <span>نشر منتج</span>
            </a>
          <% } %>

          <button type="button" onclick="openCartModal()" class="flex-1 md:flex-initial relative flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-[#0a122c] hover:bg-[#1e293b] text-white text-xs font-bold transition-all shadow-sm cursor-pointer border-none">
            <span class="material-symbols-outlined text-base">shopping_cart</span>
            <span>السلة</span>
            <span id="cartCountBadge" class="px-2 py-0.5 rounded-full bg-[#ffd000] text-[#0a122c] text-[10px] font-extrabold hidden font-mono">0</span>
          </button>
        </div>
      </div>

      <!-- الحاوية الأساسية للنتائج -->
      <div id="storeResultsArea">
        <% if (!items || items.length === 0) { %>
          <div class="py-16 px-4 rounded-2xl text-center max-w-md mx-auto">
            <div class="w-14 h-14 rounded-2xl text-slate-400 flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-3xl">production_quantity_limits</span>
            </div>
            <h4 class="text-sm font-extrabold text-slate-800">لا يوجد منتجات معروضة حالياً</h4>
          </div>
        <% } else { %>
          <%
            // تعريف مصفوفات الرموز والأسماء في أعلى البلوك لضمان الوصول إليها دائماً
            const currencyNamesMapLocal = {
              'USD_SHAM': '$', 'USD_PAYPAL': '$', 'SYP_CASH': 'ل.س', 'SYP_SHAM': 'ل.س', 'SYP_PAYMERA': 'ل.س',
              'SYP_MTN': 'ل.س', 'SYP_SYRIATEL': 'ل.س', 'IQD_CASH': 'د.ع',
              'IQD_ASIACELL': 'د.ع', 'IQD_QI': 'د.ع', 'TRY_PAPARA': 'TL', 'TRY_CASH': 'TL',
              'LBP_WHISH': 'L.L', 'JOD_CLIQ': 'د.أ', 'JOD_ORANGE': 'د.أ', 'EGP_VODAFONE': 'ج.م',
              'EGP_INSTAPAY': 'ج.م', 'SAR_STCPAY': 'ر.س', 'SAR_URPAY': 'ر.س', 'VELO_COIN': 'Coin',
              'DZD_BARIDIMOB': 'د.ج', 'DZD_CASH': 'د.ج', 'MAD_CIH': 'د.م', 'MAD_CASH': 'د.م',
              'TND_D17': 'د.ت', 'TND_FLOUCI': 'د.ت'
            };

            const currencyFullNamesMapLocal = {
              'SYP_CASH': 'ليرة سورية (نقداً)', 'IQD_CASH': 'دينار عراقي (نقداً)', 'SYP_SHAM': 'ليرة سورية (شام كاش)',
              'SYP_PAYMERA': 'ليرة سورية (بايميرا)', 'SYP_MTN': 'ليرة سورية (ام تي ان كاش)', 'SYP_SYRIATEL': 'ليرة سورية (سيرياتيل كاش)',
              'IQD_ASIACELL': 'دينار عراقي (آسيا سيل)', 'IQD_QI': 'دينار عراقي (بنك الرافدين Qi)', 'USD_SHAM': 'دولار (شام كاش)', 
              'USD_PAYPAL': 'دولار (PayPal)', 'VELO_COIN': 'فيلو كوين', 'TRY_PAPARA': 'ليرة تركية (بابارا)', 'TRY_CASH': 'ليرة تركية (كاش)',
              'LBP_WHISH': 'ويش موني (لبنان)', 'JOD_CLIQ': 'دينار أردني (كليك)', 'JOD_ORANGE': 'دينار أردني (أورنج)',
              'EGP_VODAFONE': 'جنيه مصري (فودافون كاش)', 'EGP_INSTAPAY': 'جنيه مصري (إنستاباي)', 'SAR_STCPAY': 'ريال سعودي (STC Pay)', 'SAR_URPAY': 'ريال سعودي (Urpay)',
              'DZD_BARIDIMOB': 'بريدي موب (الجزائر)', 'DZD_CASH': 'دينار جزائري (كاش)', 'MAD_CIH': 'CIH Bank (المغرب)', 'MAD_CASH': 'درهم مغربي (كاش)',
              'TND_D17': 'D17 (تونس)', 'TND_FLOUCI': 'Flouci (تونس)'
            };
          %>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="storeContainer">
            <% items.forEach((item, index) => { %>
              <% 
                const isOwner = user && String(user.id) === String(item.seller.discordId);
                const canManage = isOwner || isStaffOrAdmin;
                const isPinned = Boolean(item.isPinned);
                const isOutOfStock = (item.quantity !== -1) && ((item.quantity || 0) <= 0);
              %>
              <div id="store-item-card-<%= item._id %>" class="store-card-modern <%= isPinned ? 'store-card-pinned' : '' %>" onclick="handleItemCardClick('<%= item.type %>', '<%= item._id %>', <%= JSON.stringify(item) %>)">
                <div>
                  <div class="relative w-full h-40 rounded-xl bg-slate-100 overflow-hidden mb-3 border border-slate-100 cursor-pointer">
                    <img id="card-img-<%= index %>" src="<%= (item.images && item.images.length > 0) ? item.images[0] : '/logo.png' %>" class="w-full h-full object-cover <%= isOutOfStock ? 'grayscale opacity-75' : '' %>" onerror="this.src='/logo.png'">
                    
                    <% if (item.images && item.images.length > 1) { %>
                      <button type="button" onclick="event.stopPropagation(); prevCardImage(<%= index %>, <%= JSON.stringify(item.images) %>)" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition-all cursor-pointer border-none z-10">
                        <span class="material-symbols-outlined text-sm">chevron_right</span>
                      </button>
                      <button type="button" onclick="event.stopPropagation(); nextCardImage(<%= index %>, <%= JSON.stringify(item.images) %>)" class="absolute left-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition-all cursor-pointer border-none z-10">
                        <span class="material-symbols-outlined text-sm">chevron_left</span>
                      </button>
                    <% } %>

                    <% if (isOutOfStock) { %>
                      <span class="absolute top-2.5 right-2.5 px-3 py-1 rounded-full text-[10px] font-black backdrop-blur-md shadow-2xs bg-slate-800/90 text-rose-300 border border-slate-600">
                        نفذت الكمية
                      </span>
                    <% } else if (item.type === 'multi') { %>
                      <span class="absolute top-2.5 right-2.5 px-3 py-1 rounded-full text-[10px] font-black backdrop-blur-md shadow-2xs bg-[#0a122c]/85 text-[#ffd000]">
                        متعدد البيع
                      </span>
                    <% } %>

                    <span id="pin-badge-<%= item._id %>" class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#FFE27A] text-[#854d0e] border border-[#fde047] flex items-center gap-1 shadow-xs <%= isPinned ? '' : 'hidden' %>">
                      <span class="material-symbols-outlined text-xs">star</span>
                      <span>مثبت</span>
                    </span>
                  </div>

                  <h3 class="font-bold text-sm sm:text-base mb-1 truncate text-slate-900"><%= item.title %></h3>
                  <% if (item.description && item.description.trim()) { %>
                    <p class="text-slate-500 text-xs leading-relaxed mb-3 line-clamp-2 min-h-[34px]">
                      <%= item.description %>
                    </p>
                  <% } else { %>
                    <div class="min-h-[34px] mb-3"></div>
                  <% } %>

                  <% if (item.type === 'single') { %>
                    <div class="my-2 relative w-full flex justify-center" onclick="event.stopPropagation()">
                      <button type="button" onclick="toggleQuickPrices('popover-<%= index %>')" class="group flex items-center gap-1.5 py-1 px-2 rounded-xl hover:bg-slate-50 transition-all cursor-pointer border-none bg-transparent">
                        <% if (item.singlePricing?.allowedCurrencies?.length > 0) { %>
                          <% const firstCurr = item.singlePricing.allowedCurrencies[0]; %>
                          <span class="curr-badge-slot shrink-0" data-curr="<%= firstCurr.currency %>"></span>
                          <span class="font-mono font-black text-lg text-[#0a122c] group-hover:text-blue-600 transition-colors"><%= firstCurr.price %></span>
                          <span class="text-xs text-slate-500 font-sans font-bold group-hover:text-blue-500 transition-colors"><%= currencyNamesMapLocal[firstCurr.currency] || firstCurr.currency %></span>
                        <% } else { %>
                          <span class="text-blue-600 font-bold text-sm font-sans hover:underline">طرق الدفع والأسعار</span>
                        <% } %>
                      </button>

                      <div id="popover-<%= index %>" class="quick-prices-popover">
                        <span class="text-[10px] font-bold text-slate-400 block mb-2 pb-1.5 border-b border-slate-100">طرق الدفع المقبولة:</span>
                        <div class="space-y-1.5 max-h-48 overflow-y-auto custom-modal-scroll">
                          <% (item.singlePricing?.allowedCurrencies || []).forEach(curr => { %>
                            <div class="flex items-center justify-between text-xs py-2 px-2.5 rounded-xl bg-slate-50 border border-slate-100/80">
                              <div class="flex items-center gap-2 min-w-0">
                                <span class="curr-badge-slot shrink-0" data-curr="<%= curr.currency %>"></span>
                                <span class="font-bold text-[11px] text-slate-700 truncate"><%= currencyFullNamesMapLocal[curr.currency] || curr.currency %></span>
                              </div>
                              <span class="font-mono font-black text-[#0a122c] shrink-0 text-xs"><%= curr.price %></span>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  <% } %>
                </div>

                <div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between mb-3 mt-1">
                    <a 
                      href="/users/<%= item.seller.discordId %>" 
                      onclick="event.stopPropagation()" 
                      class="flex items-center gap-2 group/seller hover:opacity-80 transition-opacity"
                      title="زيارة الملف الشخصي"
                    >
                      <img src="<%= item.seller.avatar || '/logo.png' %>" class="w-6 h-6 rounded-full object-cover border border-slate-200" onerror="this.src='/logo.png'">
                      <span class="text-xs font-bold text-slate-700 group-hover/seller:text-blue-600 transition-colors">@<%= item.seller.username %></span>
                    </a>

                    <div class="flex items-center gap-1.5" onclick="event.stopPropagation()">
                      <% if (isStaffOrAdmin) { %>
                        <button type="button" id="pin-btn-<%= item._id %>" onclick="togglePinItem('<%= item._id %>')" class="pin-btn-circle <%= isPinned ? 'pinned' : 'unpinned' %>" title="<%= isPinned ? 'إلغاء التثبيت' : 'تثبيت الإعلان في المقدمة' %>">
                          <span class="material-symbols-outlined text-base"><%= isPinned ? 'star' : 'star_outline' %></span>
                        </button>
                      <% } %>

                      <% if (canManage) { %>
                        <a href="/store/edit/<%= item._id %>" class="w-7 h-7 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 flex items-center justify-center transition-all cursor-pointer border border-blue-200 no-underline" title="تعديل المنتج">
                          <span class="material-symbols-outlined text-xs">edit</span>
                        </a>

                        <button type="button" onclick="confirmDeleteItem('<%= item._id %>', '<%= item.title.replace(/'/g, "\\'") %>')" class="trash-btn-circle" title="حذف المنتج">
                          <span class="material-symbols-outlined">delete</span>
                        </button>
                      <% } %>
                    </div>
                  </div>

                  <div class="w-full" onclick="event.stopPropagation()">
                    <% if (isOutOfStock) { %>
                      <button type="button" disabled class="w-full py-2.5 px-4 rounded-xl bg-slate-100 text-slate-400 text-xs font-bold shadow-none flex items-center justify-center gap-1 cursor-not-allowed border-none">
                        <span class="material-symbols-outlined text-sm">block</span>
                        <span>لايوجد كمية متوفرة</span>
                      </button>
                    <% } else if (item.type === 'multi') { %>
                      <a href="/store/product/<%= item._id %>" class="w-full py-2.5 px-4 rounded-xl bg-[#0a122c] hover:bg-[#1e293b] text-white text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-1.5 cursor-pointer no-underline">
                        <span class="material-symbols-outlined text-base">visibility</span>
                        <span>استعراض</span>
                      </a>
                    <% } else { %>
                      <% 
                        const defCurr = (item.singlePricing?.allowedCurrencies && item.singlePricing.allowedCurrencies.length > 0) ? item.singlePricing.allowedCurrencies[0] : { currency: 'SYP_CASH', price: 0 };
                      %>
