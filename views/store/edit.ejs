<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تعديل <%= item.title %> - Veloqra Store</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffe27a',
              gold: '#ffe27a'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    .page-clean-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }
    .page-clean-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.9) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }
    .page-clean-header nav span, .page-clean-header nav a {
      color: #0a122c !important;
    }
    .page-clean-header nav .hidden.md\:flex a:hover { color: #4287f5 !important; }
    .page-clean-header nav .hidden.md\:block a {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }

    .trash-btn-circle {
      width: 28px;
      height: 28px;
      border-radius: 9999px;
      background-color: #fee2e2;
      color: #ef4444;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      border: 1px solid #fecaca;
      cursor: pointer;
    }
    .trash-btn-circle:hover {
      background-color: #fecaca;
      color: #dc2626;
      transform: scale(1.08);
    }
    .trash-btn-circle .material-symbols-outlined {
      font-size: 15px;
    }

    #appToast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(120%);
      padding: 0.85rem 1.5rem;
      border-radius: 1.25rem;
      font-size: 0.85rem;
      font-weight: 700;
      z-index: 999999;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #appToast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .edit-actions {
      position: sticky;
      bottom: 1.5rem;
      z-index: 20;
      padding: 0.85rem;
      border-radius: 1.25rem;
      border: 1px solid #e2e8f0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 10px 25px -5px rgba(10, 18, 44, 0.12);
    }

    .custom-select-wrap {
      position: relative;
      width: 100%;
    }
    .custom-select-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
      padding: 0.45rem 0.75rem;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      color: #0a122c;
      transition: all 0.2s ease;
      width: 100%;
    }
    .custom-select-trigger:hover {
      border-color: #4287f5;
    }
    .custom-select-dropdown {
      position: absolute;
      top: calc(100% + 5px);
      right: 0;
      left: 0;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      box-shadow: 0 15px 35px -5px rgba(10, 18, 44, 0.15);
      z-index: 100;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 220px;
    }
    .custom-select-dropdown.active {
      display: flex;
    }
    .custom-select-search {
      padding: 0.45rem 0.65rem;
      border-bottom: 1px solid #f1f5f9;
      background: #f8fafc;
    }
    .custom-select-options {
      overflow-y: auto;
      max-height: 160px;
    }
    .custom-select-option {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      transition: background 0.15s ease;
    }
    .custom-select-option:hover {
      background: #eff6ff;
      color: #1d4ed8;
    }
  </style>
</head>
<body class="loading-active text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="simple-spinner"></div>
  </div>

  <div id="appToast" class="flex items-center gap-2.5 shadow-2xl border">
    <span class="material-symbols-outlined text-lg" id="toastIcon">check_circle</span>
    <span id="toastMsg">تمت العملية بنجاح</span>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('../partials/header') %>
  </header>

  <main class="w-full relative flex-1 py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-3 mb-8">
        <a href="/store" class="h-10 px-3 sm:px-4 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 no-underline">
          <span class="material-symbols-outlined text-xl">arrow_forward</span>
          <span class="text-xs font-bold hidden sm:inline">العودة للمتجر</span>
        </a>
        <div class="min-w-0">
          <span class="text-[11px] font-bold text-blue-600 block">إدارة وتعديل العرض</span>
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight truncate">تعديل: <%= item.title %></h1>
        </div>
      </div>

      <form id="editForm" onsubmit="submitEditProduct(event)" class="space-y-6">
        <input type="hidden" id="editItemId" value="<%= item._id %>">
        <input type="hidden" id="editItemType" value="<%= item.type || 'single' %>">

        <!-- 1. المعلومات الأساسية -->
        <section class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-7 space-y-4 shadow-2xs">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-xl">edit_note</span>
            </div>
            <div>
              <h2 class="text-sm font-black text-slate-900">المعلومات الأساسية</h2>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="editTitle" class="text-xs font-bold text-slate-700">عنوان المنتج <span class="text-rose-500">*</span></label>
              <span id="titleCounter" class="text-[10px] font-mono text-slate-400"><%= (item.title || '').length %> / 40</span>
            </div>
            <input
              type="text"
              id="editTitle"
              required
              maxlength="40"
              value="<%= item.title %>"
              oninput="document.getElementById('titleCounter').textContent = this.value.length + ' / 40'"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-500 transition-colors"
            >
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="editDesc" class="text-xs font-bold text-slate-700">الوصف والملاحظات (اختياري)</label>
              <span id="descCounter" class="text-[10px] font-mono text-slate-400"><%= (item.description || '').length %> / 800</span>
            </div>
            <textarea
              id="editDesc"
              rows="4"
              maxlength="800"
              oninput="document.getElementById('descCounter').textContent = this.value.length + ' / 800'"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm focus:outline-none focus:bg-white focus:border-blue-500 transition-colors leading-relaxed"
            ><%= item.description || '' %></textarea>
          </div>
        </section>

        <!-- 2. الكميات والأسعار المحدثة -->
        <section class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-7 space-y-4 shadow-2xs">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-xl">payments</span>
            </div>
            <div>
              <h2 class="text-sm font-black text-slate-900">إدارة الأسعار والمخزون</h2>
              <p class="text-[11px] text-slate-400 font-medium">نوع العرض: <%= item.type === 'multi' ? 'متعدد المبيعات' : 'بيع فردي' %></p>
            </div>
          </div>

          <% if (item.type === 'single') { %>
            <% const isInf = Number(item.quantity) === -1; %>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
              <div class="flex items-center justify-between">
                <label for="editQuantity" class="text-xs font-bold text-slate-700">الكمية المتوفرة</label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" id="editSingleInfiniteCheckbox" <%= isInf ? 'checked' : '' %> onchange="toggleEditSingleInfinite(this)" class="rounded text-blue-600 focus:ring-0">
                  <span class="text-xs font-bold text-slate-600">كمية غير محدودة (لانهائي -1)</span>
                </label>
              </div>
              <input
                type="number"
                id="editQuantity"
                value="<%= item.quantity !== undefined ? item.quantity : 1 %>"
                min="-1"
                max="999"
                <%= isInf ? 'disabled' : '' %>
                dir="ltr"
                class="w-32 px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-bold font-mono text-center outline-none focus:border-blue-500 <%= isInf ? 'opacity-40 bg-slate-200' : '' %>"
              >
            </div>

            <!-- أسعار البيع الفردي -->
            <div class="space-y-3 pt-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-700">طرق الدفع والأسعار المقبولة:</span>
                <button type="button" onclick="addSingleEditCurrencyRow()" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer border-none bg-transparent">
                  <span class="material-symbols-outlined text-sm">add</span> إضافة عملة أخرى
                </button>
              </div>
              <div id="singleCurrencyEditRows" class="space-y-2">
                <% ((item.singlePricing && item.singlePricing.allowedCurrencies) || []).forEach(sc => { %>
                  <div class="flex items-center gap-2 currency-edit-row">
                    <div class="custom-select-wrap flex-1 min-w-0">
                      <input type="hidden" class="single-curr-key" value="<%= sc.currency %>">
                      <div class="custom-select-trigger" onclick="toggleCustomSelect(this)">
                        <div class="flex items-center gap-2 min-w-0">
                          <div class="currency-badge-slot shrink-0" data-curr="<%= sc.currency %>"></div>
                          <span class="selected-text truncate"><%= sc.currency %></span>
                        </div>
                        <span class="material-symbols-outlined text-sm shrink-0">expand_more</span>
                      </div>
                      <div class="custom-select-dropdown">
                        <div class="custom-select-search">
                          <input type="text" placeholder="بحث عن العملة..." class="w-full px-2.5 py-1 text-xs bg-white border border-slate-200 rounded-lg outline-none" oninput="filterCustomSelectOptions(this)">
                        </div>
                        <div class="custom-select-options"></div>
                      </div>
                    </div>
                    <input type="number" min="0" step="any" value="<%= sc.price %>" placeholder="السعر" class="single-curr-price w-28 sm:w-32 shrink-0 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono font-bold outline-none focus:bg-white focus:border-blue-500" dir="ltr">
                    <button type="button" onclick="this.closest('.currency-edit-row').remove()" class="trash-btn-circle shrink-0"><span class="material-symbols-outlined">delete</span></button>
                  </div>
                <% }) %>
              </div>
            </div>

          <% } else { %>

            <!-- أسعار وكميات البيع المتعدد -->
            <div class="space-y-4" id="editMultiSubItemsContainer">
              <span class="text-xs font-bold text-slate-700 block">العناصر الفرعية المتوفرة (يمكنك تعديل الكمية والأسعار وإضافة عملات):</span>
              
              <% (item.subItems || []).forEach((sub, idx) => { %>
                <% 
                  const subId = sub._id || idx;
                  const isSubInf = Number(sub.quantity) === -1;
                  const curQty = sub.quantity !== undefined ? sub.quantity : 1;
                  const subCurrencies = sub.allowedCurrencies || (sub.currency ? [{ currency: sub.currency, price: sub.price }] : []);
                %>
                <div class="edit-sub-item-block p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3.5" data-sub-id="<%= subId %>">
                  <div class="flex items-center justify-between gap-2">
                    <input type="text" value="<%= sub.title %>" placeholder="عنوان العنصر" class="sub-title flex-1 min-w-0 px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold outline-none focus:border-blue-500">
                    <span class="text-xs font-mono font-bold text-slate-400 bg-white px-2 py-1 rounded-lg border border-slate-200">#<%= idx + 1 %></span>
                  </div>
                  
                  <input type="text" value="<%= sub.description || '' %>" placeholder="وصف موجز لهذا العنصر (اختياري)" class="sub-desc w-full px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs outline-none focus:border-blue-500">
                  
                  <!-- كمية العنصر -->
                  <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-white border border-slate-200 text-xs">
                    <div class="flex items-center gap-2">
                      <label class="font-bold text-slate-700">الكمية:</label>
                      <input 
                        type="number" 
                        value="<%= curQty %>" 
                        min="-1" 
                        max="999" 
                        dir="ltr"
                        <%= isSubInf ? 'disabled' : '' %> 
                        class="sub-qty-input w-20 px-2.5 py-1 rounded-lg bg-slate-50 border border-slate-200 text-center font-mono font-bold outline-none focus:border-blue-500 <%= isSubInf ? 'opacity-40 bg-slate-200' : '' %>"
                      >
                    </div>
                    <label class="flex items-center gap-1.5 cursor-pointer select-none">
                      <input type="checkbox" <%= isSubInf ? 'checked' : '' %> onchange="toggleEditSubItemInfinite(this)" class="rounded text-blue-600 focus:ring-0">
                      <span class="text-slate-600 font-bold text-[11px]">كمية غير محدودة (-1)</span>
                    </label>
                  </div>

                  <!-- أسعار وعملات هذا العنصر -->
                  <div class="pt-2 border-t border-slate-200/80 space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-bold text-slate-600">العملات والأسعار لهذا العنصر:</span>
                      <button type="button" onclick="addSubItemCurrencyEditRow(this)" class="text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer border-none bg-transparent">
                        <span class="material-symbols-outlined text-sm">add</span> عملة إضافية
                      </button>
                    </div>

                    <div class="sub-item-currencies-container space-y-2">
                      <% subCurrencies.forEach(sc => { %>
                        <div class="flex items-center gap-2 sub-curr-edit-row">
                          <div class="custom-select-wrap flex-1 min-w-0">
                            <input type="hidden" class="sub-curr-key" value="<%= sc.currency %>">
                            <div class="custom-select-trigger" onclick="toggleCustomSelect(this)">
                              <div class="flex items-center gap-2 min-w-0">
                                <div class="currency-badge-slot shrink-0" data-curr="<%= sc.currency %>"></div>
                                <span class="selected-text truncate"><%= sc.currency %></span>
                              </div>
                              <span class="material-symbols-outlined text-sm shrink-0">expand_more</span>
                            </div>
                            <div class="custom-select-dropdown">
                              <div class="custom-select-search">
                                <input type="text" placeholder="بحث عن العملة..." class="w-full px-2.5 py-1 text-xs bg-white border border-slate-200 rounded-lg outline-none" oninput="filterCustomSelectOptions(this)">
                              </div>
                              <div class="custom-select-options"></div>
                            </div>
                          </div>

                          <input type="number" min="0" step="any" value="<%= sc.price %>" placeholder="السعر" class="sub-curr-price w-28 sm:w-32 shrink-0 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs font-mono font-bold outline-none focus:border-blue-500" dir="ltr">
                          <button type="button" onclick="this.closest('.sub-curr-edit-row').remove()" class="trash-btn-circle shrink-0">
                            <span class="material-symbols-outlined">delete</span>
                          </button>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                </div>
              <% }) %>
            </div>

          <% } %>
        </section>

        <!-- 3. الشروط -->
        <section class="rounded-2xl bg-white border border-slate-200 p-5 sm:p-7 space-y-4 shadow-2xs">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-xl">tune</span>
            </div>
            <div>
              <h2 class="text-sm font-black text-slate-900">شروط الطلب والتواصل</h2>
            </div>
          </div>

          <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div>
              <label for="editRequireLogin" class="text-xs font-bold text-slate-800 block">هل تريد ان يكون المستخدم مسجلاً دخول؟</label>
              <p class="text-[11px] text-slate-500 mt-0.5">عند تفعيل الخيار، لن يستطيع الزوار غير المسجلين طلب هذا المنتج</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="editRequireLogin" name="requireLogin" <%= item.requireLogin ? 'checked' : '' %> class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:bg-blue-600 transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-transform peer-checked:after:translate-x-5"></div>
            </label>
          </div>

          <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-amber-50 border border-amber-200">
            <div>
              <label for="editRequirePhone" class="text-xs font-bold text-amber-900 block flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-amber-600">phone_iphone</span>
                <span>هل يتطلب هذا المنتج رقماً من المشتري؟</span>
              </label>
              <p class="text-[11px] text-amber-700 mt-0.5">طلب تحديد الدولة ورقم هاتف المستلم قبل إرسال السلة (لشحن الرصيد والخطوط)</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="editRequirePhone" name="requirePhoneNumber" <%= item.requirePhoneNumber ? 'checked' : '' %> class="sr-only peer">
              <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:bg-amber-500 transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-transform peer-checked:after:translate-x-5"></div>
            </label>
          </div>
        </section>

        <div class="edit-actions flex items-center gap-3">
          <button type="submit" id="submitEditBtn" class="flex-1 py-3 px-5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md transition-colors cursor-pointer border-none flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-base">save</span>
            <span>حفظ التعديلات والأسعار</span>
          </button>
          <a href="/store" class="py-3 px-5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer border border-slate-200 no-underline text-center">
            إلغاء
          </a>
        </div>
      </form>

    </div>
  </main>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    const ALL_CURRENCIES = [
      // العملات الحالية
      { key: 'SYP_CASH', name: 'ليرة سورية (نقداً)', icon: 'payments', iconColor: 'text-emerald-500 bg-emerald-50' },
      { key: 'IQD_CASH', name: 'دينار عراقي (نقداً)', icon: 'payments', iconColor: 'text-red-500 bg-emerald-50' },
      { key: 'SYP_SHAM', name: 'ليرة سورية (شام كاش)', img: '/syp_sham.png' },
      { key: 'SYP_PAYMERA', name: 'ليرة سورية (بايميرا)', img: '/syp_paymera.png' },
      { key: 'SYP_MTN', name: 'ليرة سورية (ام تي ان كاش)', img: '/syp_mtn.png' },
      { key: 'SYP_SYRIATEL', name: 'ليرة سورية (سيرياتيل كاش)', img: '/syp_syriatel.png' },
      { key: 'IQD_ASIACELL', name: 'دينار عراقي (آسيا سيل)', img: '/iqd_asiacell.png' },
      { key: 'IQD_QI', name: 'دينار عراقي (بنك الرافدين Qi)', img: '/iqd_qi.png' },
      { key: 'USD_SHAM', name: 'دولار (شام كاش)', img: '/usd_sham.png' },
      { key: 'VELO_COIN', name: 'فيلو كوين (Velo Coin)', img: '/velo_coin.png' },

      // العملات العربية والدولية
      { key: 'TRY_PAPARA', name: 'ليرة تركية (بابارا Papara)', img: '/try_papara.png' },
      { key: 'TRY_CASH', name: 'ليرة تركية (حوالة بنكية / كاش)', img: '/try_cash.png' },
      { key: 'LBP_WHISH', name: 'ليرة لبنانية / دولار (Whish Money)', img: '/lbp_whish.png' },
      { key: 'JOD_CLIQ', name: 'دينار أردني (كليك CliQ)', img: '/jod_cliq.png' },
      { key: 'JOD_ORANGE', name: 'دينار أردني (أورنج موني Orange)', img: '/jod_orange.png' },
      { key: 'EGP_VODAFONE', name: 'جنيه مصري (فودافون كاش)', img: '/egp_vodafone.png' },
      { key: 'EGP_INSTAPAY', name: 'جنيه مصري (إنستاباي InstaPay)', img: '/egp_instapay.png' },
      { key: 'SAR_STCPAY', name: 'ريال سعودي (STC Pay)', img: '/sar_stcpay.png' },
      { key: 'SAR_URPAY', name: 'ريال سعودي (Urpay)', img: '/sar_urpay.png' },
      { key: 'USD_PAYPAL', name: 'دولار أمريكي (PayPal)', img: '/usd_paypal.png' },

      // العملات المغاربية
      { key: 'DZD_BARIDIMOB', name: 'دينار جزائري (بريدي موب BaridiMob)', img: '/dzd_baridimob.png' },
      { key: 'DZD_CASH', name: 'دينار جزائري (CCP / نقداً)', img: '/dzd_cash.png' },
      { key: 'MAD_CIH', name: 'درهم مغربي (CIH Bank)', img: '/mad_cih.png' },
      { key: 'MAD_CASH', name: 'درهم مغربي (حوالة بنكية / نقداً)', img: '/mad_cash.png' },
      { key: 'TND_D17', name: 'دينار تونسي (D17 البريد التونسي)', img: '/tnd_d17.png' },
      { key: 'TND_FLOUCI', name: 'دينار تونسي (Flouci)', img: '/tnd_flouci.png' }
    ];

    function renderCurrencyBadge(currKey, sizeClass = "w-5 h-5") {
      const c = ALL_CURRENCIES.find(item => item.key === currKey);
      if (c && c.icon) {
        return `<span class="material-symbols-outlined ${sizeClass} rounded-full flex items-center justify-center text-[15px] ${c.iconColor || 'text-emerald-500 bg-emerald-50'} border border-emerald-200 shrink-0 font-bold">${c.icon}</span>`;
      }
      const imgSrc = (c && c.img) ? c.img : `/${currKey.toLowerCase()}.png`;
      return `<img src="${imgSrc}" onerror="this.src='/logo.png'" class="${sizeClass} object-contain rounded-full bg-slate-50 shrink-0">`;
    }

    function refreshBadgesAndTexts() {
      document.querySelectorAll('.currency-badge-slot').forEach(el => {
        const key = el.getAttribute('data-curr') || el.closest('.custom-select-wrap')?.querySelector('input')?.value;
        if (key) {
          el.innerHTML = renderCurrencyBadge(key, 'w-4 h-4');
          const txt = el.closest('.custom-select-trigger')?.querySelector('.selected-text');
          const found = ALL_CURRENCIES.find(c => c.key === key);
          if (txt && found) txt.textContent = found.name;
        }
      });
    }
    refreshBadgesAndTexts();

    function showToast(msg, isSuccess = true) {
      const toast = document.getElementById('appToast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = msg;
      if (isSuccess) {
        toast.className = 'flex items-center gap-2.5 shadow-2xl border bg-[#0a122c] text-white border-slate-700 show';
        toastIcon.textContent = 'check_circle';
        toastIcon.className = 'material-symbols-outlined text-lg text-[#ffd000]';
      } else {
        toast.className = 'flex items-center gap-2.5 shadow-2xl border bg-rose-950 text-white border-rose-800 show';
        toastIcon.textContent = 'error';
        toastIcon.className = 'material-symbols-outlined text-lg text-rose-400';
      }

      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function toggleEditSingleInfinite(checkbox) {
      const qInput = document.getElementById('editQuantity');
      if (!qInput) return;
      if (checkbox.checked) {
        qInput.value = -1;
        qInput.disabled = true;
        qInput.classList.add('opacity-40', 'bg-slate-200');
      } else {
        qInput.value = 1;
        qInput.disabled = false;
        qInput.classList.remove('opacity-40', 'bg-slate-200');
      }
    }

    function toggleEditSubItemInfinite(checkbox) {
      const block = checkbox.closest('.edit-sub-item-block');
      const input = block.querySelector('.sub-qty-input');
      if (!input) return;
      if (checkbox.checked) {
        input.value = -1;
        input.disabled = true;
        input.classList.add('opacity-40', 'bg-slate-200');
      } else {
        input.value = 1;
        input.disabled = false;
        input.classList.remove('opacity-40', 'bg-slate-200');
      }
    }

    function populateCustomSelectOptions(container) {
      container.innerHTML = ALL_CURRENCIES.map(c => `
        <div class="custom-select-option" data-key="${c.key}" data-name="${c.name}" onclick="selectCustomOption(this)">
          ${renderCurrencyBadge(c.key, 'w-4 h-4')}
          <span class="truncate">${c.name}</span>
        </div>
      `).join('');
    }

    function toggleCustomSelect(trigger) {
      const wrap = trigger.closest('.custom-select-wrap');
      const dropdown = wrap.querySelector('.custom-select-dropdown');
      const isActive = dropdown.classList.contains('active');
      
      document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      if (!isActive) {
        dropdown.classList.add('active');
        const optionsList = dropdown.querySelector('.custom-select-options');
        if (!optionsList.hasChildNodes()) {
          populateCustomSelectOptions(optionsList);
        }
      }
    }

    function filterCustomSelectOptions(input) {
      const q = input.value.toLowerCase().trim();
      const wrap = input.closest('.custom-select-wrap');
      wrap.querySelectorAll('.custom-select-option').forEach(opt => {
        const name = opt.getAttribute('data-name').toLowerCase();
        opt.style.display = name.includes(q) ? 'flex' : 'none';
      });
    }

    function selectCustomOption(opt) {
      const wrap = opt.closest('.custom-select-wrap');
      const key = opt.getAttribute('data-key');
      const name = opt.getAttribute('data-name');

      wrap.querySelector('input').value = key;
      const trigger = wrap.querySelector('.custom-select-trigger');
      
      const badgeSlot = trigger.querySelector('.currency-badge-slot');
      if (badgeSlot) {
        badgeSlot.setAttribute('data-curr', key);
        badgeSlot.innerHTML = renderCurrencyBadge(key, 'w-4 h-4');
      }
      trigger.querySelector('.selected-text').textContent = name;
      wrap.querySelector('.custom-select-dropdown').classList.remove('active');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.custom-select-wrap')) {
        document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      }
    });

    function currencySelectEditHtml(inputClass, defaultKey = 'SYP_CASH') {
      const defaultObj = ALL_CURRENCIES.find(c => c.key === defaultKey) || ALL_CURRENCIES[0];
      return `
        <div class="custom-select-wrap flex-1 min-w-0">
          <input type="hidden" class="${inputClass}" value="${defaultObj.key}">
          <div class="custom-select-trigger" onclick="toggleCustomSelect(this)">
            <div class="flex items-center gap-2 min-w-0">
              <div class="currency-badge-slot shrink-0" data-curr="${defaultObj.key}">${renderCurrencyBadge(defaultObj.key, 'w-4 h-4')}</div>
              <span class="selected-text truncate">${defaultObj.name}</span>
            </div>
            <span class="material-symbols-outlined text-sm shrink-0">expand_more</span>
          </div>
          <div class="custom-select-dropdown">
            <div class="custom-select-search">
              <input type="text" placeholder="بحث عن العملة..." class="w-full px-2.5 py-1 text-xs bg-white border border-slate-200 rounded-lg outline-none" oninput="filterCustomSelectOptions(this)">
            </div>
            <div class="custom-select-options"></div>
          </div>
        </div>
      `;
    }

    function addSingleEditCurrencyRow() {
      const container = document.getElementById('singleCurrencyEditRows');
      const div = document.createElement('div');
      div.className = 'flex items-center gap-2 currency-edit-row';
      div.innerHTML = `
        ${currencySelectEditHtml('single-curr-key', 'USD_SHAM')}
        <input type="number" min="0" step="any" placeholder="السعر" class="single-curr-price w-28 sm:w-32 shrink-0 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono font-bold outline-none focus:bg-white focus:border-blue-500" dir="ltr">
        <button type="button" onclick="this.closest('.currency-edit-row').remove()" class="trash-btn-circle shrink-0"><span class="material-symbols-outlined">delete</span></button>
      `;
      container.appendChild(div);
    }

    function addSubItemCurrencyEditRow(btn) {
      const block = btn.closest('.edit-sub-item-block');
      const container = block.querySelector('.sub-item-currencies-container');
      const existing = Array.from(block.querySelectorAll('.sub-curr-key')).map(i => i.value);
      const nextAvailable = ALL_CURRENCIES.find(c => !existing.includes(c.key)) || ALL_CURRENCIES[0];

      const div = document.createElement('div');
      div.className = 'flex items-center gap-2 sub-curr-edit-row';
      div.innerHTML = `
        ${currencySelectEditHtml('sub-curr-key', nextAvailable.key)}
        <input type="number" min="0" step="any" placeholder="السعر" class="sub-curr-price w-28 sm:w-32 shrink-0 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs font-mono font-bold outline-none focus:border-blue-500" dir="ltr">
        <button type="button" onclick="this.closest('.sub-curr-edit-row').remove()" class="trash-btn-circle shrink-0">
          <span class="material-symbols-outlined">delete</span>
        </button>
      `;
      container.appendChild(div);
    }

    async function submitEditProduct(e) {
      e.preventDefault();
      const id = document.getElementById('editItemId').value;
      const type = document.getElementById('editItemType').value;
      const title = document.getElementById('editTitle').value.trim();
      const description = document.getElementById('editDesc').value.trim();
      const requireLogin = document.getElementById('editRequireLogin')?.checked || false;
      const requirePhoneNumber = document.getElementById('editRequirePhone')?.checked || false;

      const payload = {
        title,
        description,
        requireLogin,
        requirePhoneNumber
      };

      if (type === 'multi') {
        const blocks = document.querySelectorAll('#editMultiSubItemsContainer .edit-sub-item-block');
        const updatedSubs = [];

        blocks.forEach(b => {
          const subId = b.getAttribute('data-sub-id');
          const subTitle = (b.querySelector('.sub-title')?.value || '').trim();
          const subDesc = (b.querySelector('.sub-desc')?.value || '').trim();
          const qtyVal = Number(b.querySelector('.sub-qty-input')?.value);

          const currRows = b.querySelectorAll('.sub-curr-edit-row');
          const allowedCurrencies = [];

          currRows.forEach(cr => {
            const currKey = cr.querySelector('.sub-curr-key')?.value;
            const priceVal = Number(cr.querySelector('.sub-curr-price')?.value) || 0;
            if (currKey && priceVal > 0 && !allowedCurrencies.some(a => a.currency === currKey)) {
              allowedCurrencies.push({ currency: currKey, price: priceVal });
            }
          });

          if (subTitle && allowedCurrencies.length > 0) {
            updatedSubs.push({
              id: subId,
              title: subTitle,
              description: subDesc,
              quantity: qtyVal,
              allowedCurrencies
            });
          }
        });

        if (updatedSubs.length === 0) {
          return showToast('يجب إدخال سعر واحد على الأقل لكل عنصر فرعي!', false);
        }
        payload.subItems = updatedSubs;
      } else {
        payload.quantity = Number(document.getElementById('editQuantity').value);
        
        const singleRows = document.querySelectorAll('#singleCurrencyEditRows .currency-edit-row');
        const singleCurrs = [];
        singleRows.forEach(sr => {
          const currKey = sr.querySelector('.single-curr-key')?.value;
          const priceVal = Number(sr.querySelector('.single-curr-price')?.value) || 0;
          if (currKey && priceVal > 0 && !singleCurrs.some(a => a.currency === currKey)) {
            singleCurrs.push({ currency: currKey, price: priceVal });
          }
        });

        if (singleCurrs.length === 0) {
          return showToast('يرجى تحديد سعر واحد على الأقل للمنتج الفردي!', false);
        }
        payload.currencies = singleCurrs;
      }

      const btn = document.getElementById('submitEditBtn');
      btn.disabled = true;
      btn.innerHTML = `<span class="material-symbols-outlined text-base animate-spin">sync</span><span>جاري حفظ الأسعار...</span>`;

      try {
        const res = await fetch(`/store/edit/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message);
          setTimeout(() => {
            window.location.href = `/store/product/${id}`;
          }, 1000);
        } else {
          showToast(data.message || 'فشل التعديل', false);
          btn.disabled = false;
          btn.innerHTML = `<span class="material-symbols-outlined text-base">save</span><span>حفظ التعديلات والأسعار</span>`;
        }
      } catch (err) {
        showToast('حدث خطأ أثناء الاتصال بالخادم', false);
        btn.disabled = false;
        btn.innerHTML = `<span class="material-symbols-outlined text-base">save</span><span>حفظ التعديلات والأسعار</span>`;
      }
    }
  </script>
</body>
</html>