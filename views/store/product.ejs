            <div class="custom-select-search">
              <input type="text" placeholder="بحث عن الدولة..." class="w-full px-2.5 py-1 text-xs bg-white border border-slate-200 rounded-lg outline-none" oninput="filterCountryOptions(this)">
            </div>
            <div class="custom-select-options custom-modal-scroll" id="countryOptionsList"></div>
          </div>
