            <div id="cartCurrencyTotals" class="space-y-1.5 font-mono text-xs"></div>
            
            <div id="cartMiddlemanFeeRow" class="pt-2 border-t border-slate-200/80 hidden flex items-center justify-between text-xs">
              <div class="flex items-center gap-1.5">
                <div id="middlemanFeeIconSlot"></div>
