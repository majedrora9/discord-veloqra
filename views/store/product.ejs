              <button type="button" onclick="setMiddleman(true)" id="btnMiddleman" class="py-2.5 px-3 rounded-xl text-xs font-bold border border-slate-300 bg-white text-slate-700 transition-all cursor-pointer">مع وسيط (+5%)</button>
