              <input type="text" id="guestContactInput" placeholder="مثال: username#0000 أو @telegram أو 09xxxxxxxx" class="w-full px-3.5 py-2 rounded-xl bg-white border border-blue-200 text-xs font-bold outline-none focus:border-blue-500">
