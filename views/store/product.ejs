                  <div class="currency-badge-slot shrink-0" data-curr="SYP_CASH">
                    <span class="material-symbols-outlined w-5 h-5 rounded-full flex items-center justify-center text-[15px] text-emerald-500 bg-emerald-50 border border-emerald-200 font-bold">payments</span>
