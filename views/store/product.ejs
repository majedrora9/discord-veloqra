  <!-- مودال إدخال رقم هاتف المستلم (للرصيد والشحن) -->
  <div id="phoneRequirementModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-900/70 backdrop-blur-md p-4 sm:p-6">
