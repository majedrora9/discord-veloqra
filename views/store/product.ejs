<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= item.title %> - Veloqra Store</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Veloqra">
  <meta property="og:title" content="<%= item.title %> - Veloqra">
  <meta property="og:description" content="<%= (item.description || 'عرض خاص ومميز في متجر فيلوكرا').slice(0, 150) %>">
  <meta property="og:image" content="<%= (item.images && item.images.length > 0) ? item.images[0] : '/logo.png' %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css"/>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffe27a',
              gold: '#ffe27a'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    body.modal-lock, html.modal-lock {
      overflow: hidden !important;
      height: 100vh !important;
      touch-action: none;
    }

    .page-clean-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }
    .page-clean-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.9) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }
    .page-clean-header nav span, .page-clean-header nav a {
      color: #0a122c !important;
    }
    .page-clean-header nav .hidden.md\:flex a:hover { color: #4287f5 !important; }
    .page-clean-header nav .hidden.md\:block a {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }

    .custom-modal-scroll::-webkit-scrollbar {
      width: 5px;
    }
    .custom-modal-scroll::-webkit-scrollbar-track {
      background: #f8fafc;
    }
    .custom-modal-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }

    .trash-btn-circle {
      width: 30px;
      height: 30px;
      border-radius: 9999px;
      background-color: #fee2e2;
      color: #ef4444;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid #fecaca;
      cursor: pointer;
    }
    .trash-btn-circle:hover {
      background-color: #fecaca;
      color: #dc2626;
      transform: scale(1.08);
    }
    .trash-btn-circle .material-symbols-outlined {
      font-size: 16px;
      color: #ef4444;
    }

    #appToast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(120%);
      padding: 0.85rem 1.5rem;
      border-radius: 1.25rem;
      font-size: 0.85rem;
      font-weight: 700;
      z-index: 999999;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #appToast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .custom-select-wrap {
      position: relative;
      width: 100%;
    }
    .custom-select-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
      padding: 0.55rem 0.8rem;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 700;
      color: #0a122c;
      transition: all 0.2s ease;
      width: 100%;
    }
    .custom-select-trigger:hover {
      border-color: #4287f5;
    }
    .custom-select-dropdown {
      position: absolute;
      top: calc(100% + 5px);
      right: 0;
      left: 0;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1rem;
      box-shadow: 0 15px 35px -5px rgba(10, 18, 44, 0.15);
      z-index: 100;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 240px;
    }
    .custom-select-dropdown.active {
      display: flex;
    }
    .custom-select-search {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid #f1f5f9;
      background: #f8fafc;
    }
    .custom-select-options {
      overflow-y: auto;
      max-height: 180px;
    }
    .custom-select-option {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.85rem;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      transition: background 0.15s ease;
    }
    .custom-select-option:hover {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .subitem-grid-card {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .subitem-grid-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px -6px rgba(10, 18, 44, 0.08);
      border-color: #93c5fd;
    }
  </style>
</head>
<body class="loading-active text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="simple-spinner"></div>
  </div>

  <div id="appToast" class="flex items-center gap-2.5 shadow-2xl border">
    <span class="material-symbols-outlined text-lg" id="toastIcon">check_circle</span>
    <span id="toastMsg">تمت العملية بنجاح</span>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('../partials/header') %>
  </header>

  <main class="w-full relative flex-1 py-10 md:py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <% 
        const isOutOfStock = (item.quantity !== -1) && ((item.quantity || 0) <= 0);
        const images = (item.images && item.images.length > 0) ? item.images : ['/logo.png'];

const currencyFullNamesMap = {
  'SYP_CASH': 'ليرة سورية (نقداً)', 'IQD_CASH': 'دينار عراقي (نقداً)', 'SYP_SHAM': 'شام كاش',
  'SYP_PAYMERA': 'بايميرا', 'SYP_MTN': 'ام تي ان كاش', 'SYP_SYRIATEL': 'سيرياتيل كاش',
  'IQD_ASIACELL': 'آسيا سيل', 'IQD_QI': 'رافدين Qi', 'USD_SHAM': 'شام كاش ($)', 
  'USD_PAYPAL': 'PayPal', 'VELO_COIN': 'فيلو كوين', 'TRY_PAPARA': 'بابارا (تركيا)', 'TRY_CASH': 'ليرة تركية (كاش)',
  'LBP_WHISH': 'Whish Money', 'JOD_CLIQ': 'كليك (الأردن)', 'JOD_ORANGE': 'أورنج موني',
  'EGP_VODAFONE': 'فودافون كاش', 'EGP_INSTAPAY': 'إنستاباي (مصر)', 'SAR_STCPAY': 'STC Pay', 'SAR_URPAY': 'Urpay',
  'DZD_BARIDIMOB': 'بريدي موب (الجزائر)', 'DZD_CASH': 'دينار جزائري (كاش)',
  'MAD_CIH': 'CIH Bank (المغرب)', 'MAD_CASH': 'درهم مغربي (كاش)',
  'TND_D17': 'D17 (تونس)', 'TND_FLOUCI': 'Flouci (تونس)'
};

const currencySymbolsMap = {
  'USD_SHAM': '$', 'USD_PAYPAL': '$', 'SYP_CASH': 'ل.س', 'SYP_SHAM': 'ل.س', 'SYP_PAYMERA': 'ل.س',
  'SYP_MTN': 'ل.س', 'SYP_SYRIATEL': 'ل.س', 'IQD_CASH': 'د.ع', 'IQD_ASIACELL': 'د.ع', 'IQD_QI': 'د.ع',
  'TRY_PAPARA': 'TL', 'TRY_CASH': 'TL', 'LBP_WHISH': 'L.L', 'JOD_CLIQ': 'د.أ', 'JOD_ORANGE': 'د.أ',
  'EGP_VODAFONE': 'ج.م', 'EGP_INSTAPAY': 'ج.م', 'SAR_STCPAY': 'ر.س', 'SAR_URPAY': 'ر.س', 'VELO_COIN': 'Coin',
  'DZD_BARIDIMOB': 'د.ج', 'DZD_CASH': 'د.ج', 'MAD_CIH': 'د.م', 'MAD_CASH': 'د.م', 'TND_D17': 'د.ت', 'TND_FLOUCI': 'د.ت'
};
      %>

      <!-- شريط العودة ورأس الصفحة -->
      <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-8 gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <a href="/store" class="h-10 px-3 sm:px-4 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 no-underline">
            <span class="material-symbols-outlined text-xl">arrow_forward</span>
            <span class="text-xs font-bold hidden sm:inline">العودة للمتجر</span>
          </a>
          <div class="min-w-0">
            <span class="text-[11px] font-bold text-blue-600 block">
              <%= item.type === 'multi' ? 'عرض خاص • باقة متعددة' : 'منتج فردي' %>
            </span>
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight truncate"><%= item.title %></h1>
          </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <% if (canManage) { %>
            <a href="/store/edit/<%= item._id %>" class="py-2 px-3.5 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 border border-blue-200 text-xs font-bold flex items-center gap-1.5 transition-colors no-underline">
              <span class="material-symbols-outlined text-sm">edit</span>
              <span class="hidden sm:inline">تعديل</span>
            </a>
          <% } %>

          <button type="button" onclick="openCartModal()" class="relative flex items-center justify-center gap-2 py-2 px-4 rounded-xl bg-[#0a122c] hover:bg-[#1e293b] text-white text-xs font-bold transition-all shadow-sm cursor-pointer border-none">
            <span class="material-symbols-outlined text-base">shopping_cart</span>
            <span class="hidden sm:inline">السلة</span>
            <span id="cartCountBadge" class="px-2 py-0.5 rounded-full bg-[#ffd000] text-[#0a122c] text-[10px] font-extrabold hidden font-mono">0</span>
          </button>
        </div>
      </div>

      <!-- تفاصيل المنتج والصور -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start mb-10">
        <!-- معرض الصور -->
        <div class="md:col-span-5 space-y-3">
          <div class="w-full h-72 sm:h-80 rounded-2xl bg-slate-100 border border-slate-200 overflow-hidden shadow-inner relative">
            <img id="mainProductViewImg" src="<%= images[0] %>" class="w-full h-full object-cover <%= isOutOfStock ? 'grayscale opacity-75' : '' %>" onerror="this.src='/logo.png'">
            
            <% if (isOutOfStock) { %>
              <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-black backdrop-blur-md shadow-2xs bg-slate-800/90 text-rose-300 border border-slate-600">
                نفذت الكمية
              </span>
            <% } %>
          </div>

          <% if (images.length > 1) { %>
            <div class="flex items-center gap-2 overflow-x-auto pb-1 custom-modal-scroll">
              <% images.forEach(img => { %>
                <button type="button" onclick="document.getElementById('mainProductViewImg').src='<%= img %>'" class="w-14 h-14 rounded-xl border border-slate-200 bg-white overflow-hidden shrink-0 hover:border-blue-500 transition-all cursor-pointer">
                  <img src="<%= img %>" class="w-full h-full object-cover" onerror="this.src='/logo.png'">
                </button>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- معلومات العرض والبائع -->
        <div class="md:col-span-7 space-y-4">
          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-xs font-bold text-slate-700">حالة التوفر:</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= isOutOfStock ? 'bg-rose-100 text-rose-700 border border-rose-200' : 'bg-emerald-100 text-emerald-800 border border-emerald-200' %>">
              <%= isOutOfStock ? 'نفذت الكمية' : (item.quantity === -1 ? 'كمية غير محدودة' : `متوفر: ${item.quantity || 1} قطعة`) %>
            </span>
          </div>

          <% if (item.description && item.description.trim()) { %>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
              <h4 class="text-xs font-black text-slate-900 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base text-blue-600">info</span>
                <span>عن هذا العرض:</span>
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed whitespace-pre-wrap"><%= item.description %></p>
            </div>
          <% } %>

          <div class="p-4 rounded-2xl bg-white border border-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="<%= item.seller.avatar || '/logo.png' %>" class="w-10 h-10 rounded-full object-cover border border-slate-200" onerror="this.src='/logo.png'">
              <div>
                <span class="text-[10px] text-slate-400 font-bold block">معلن العرض</span>
                <a href="/users/<%= item.seller.discordId %>" class="text-xs font-bold text-slate-800 hover:text-blue-600">@<%= item.seller.username %></a>
              </div>
            </div>
            <a href="/users/<%= item.seller.discordId %>" class="px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 transition-colors no-underline">
              الملف الشخصي
            </a>
          </div>

          <% if (item.type === 'single') { %>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 space-y-3">
              <h4 class="text-xs font-black text-slate-900">طرق الدفع والأسعار المتاحة:</h4>
              <div class="space-y-2">
                <% (item.singlePricing?.allowedCurrencies || []).forEach(sc => { %>
                  <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="flex items-center gap-2 min-w-0">
                      <div class="currency-badge-slot shrink-0" data-curr="<%= sc.currency %>"></div>
                      <span class="text-xs font-bold text-slate-700 truncate"><%= currencyFullNamesMap[sc.currency] || sc.currency %></span>
                      <span class="font-mono font-black text-sm text-[#0a122c] shrink-0 mr-1"><%= sc.price %></span>
                      <span class="text-[10px] font-bold text-slate-400 font-sans"><%= currencySymbolsMap[sc.currency] || '' %></span>
                    </div>

                    <% if (isOutOfStock) { %>
                      <button type="button" disabled class="px-3 py-1.5 rounded-lg bg-slate-200 text-slate-400 text-xs font-bold cursor-not-allowed border-none">
                        غير متوفر
                      </button>
                    <% } else { %>
                      <button type="button" onclick="addToCart('<%= item._id %>', null, '<%= item.title.replace(/'/g, "\\'") %>', '<%= sc.currency %>', <%= sc.price %>, '<%= item.seller.discordId %>', '<%= item.seller.username %>', '<%= item.seller.avatar %>', 1, <%= item.quantity !== undefined ? item.quantity : 1 %>, <%= Boolean(item.requireLogin) %>, <%= Boolean(item.requirePhoneNumber) %>)" class="px-4 py-2 rounded-xl bg-[#0a122c] hover:bg-blue-600 text-white text-xs font-bold transition-all cursor-pointer border-none shadow-sm flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm">add_shopping_cart</span>
                        <span>إضافة للسلة</span>
                      </button>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- قائمة العناصر الفرعية في البيع المتعدد مع الاسم والصورة والقيمة والعملة -->
      <% if (item.type === 'multi') { %>
        <div class="pt-6 border-t border-slate-200 space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base sm:text-lg font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-xl text-amber-500">grid_view</span>
                <span>العناصر المتوفرة في هذا العرض</span>
              </h2>
              <p class="text-xs text-slate-400 font-medium mt-0.5">اختر العنصر والعملة المناسبة وأضفه مباشرة إلى سلتك</p>
            </div>
            <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600">
              <%= (item.subItems || []).length %> خيارات
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% (item.subItems || []).forEach((sub, sIdx) => { 
              const subCurrencies = sub.allowedCurrencies || (sub.currency ? [{ currency: sub.currency, price: sub.price }] : []);
              const subQty = (sub.quantity !== undefined && sub.quantity !== null) ? Number(sub.quantity) : 1;
              const isSubOutOfStock = (subQty !== -1 && subQty <= 0) || isOutOfStock;
            %>
              <div class="subitem-grid-card bg-white border border-slate-200 rounded-2xl p-4 flex flex-col justify-between shadow-2xs relative overflow-hidden">
                <div class="space-y-2 mb-3">
                  <div class="flex items-start justify-between gap-2">
                    <h4 class="text-sm font-black text-slate-900 leading-snug truncate" title="<%= sub.title %>"><%= sub.title %></h4>
                    <span class="w-6 h-6 rounded-lg bg-blue-50 text-blue-600 text-xs font-mono font-bold flex items-center justify-center shrink-0">#<%= sIdx + 1 %></span>
                  </div>
                  <% if (sub.description && sub.description.trim()) { %>
                    <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 min-h-[32px]"><%= sub.description %></p>
                  <% } %>
                  
                  <div class="text-[11px] font-bold <%= subQty === -1 || subQty > 0 ? 'text-slate-400' : 'text-rose-500' %>">
                    الكمية: <%= subQty === -1 ? 'غير محدودة' : (subQty > 0 ? `${subQty} قطعة` : 'غير متوفر') %>
                  </div>
                </div>

                <div class="space-y-2 pt-3 border-t border-slate-100">
                  <% subCurrencies.forEach(sc => { %>
                    <div class="flex items-center justify-between gap-2 p-2 rounded-xl bg-slate-50 border border-slate-100">
                      
                      <!-- صورة واسم وقيمة العملة بوضوح -->
                      <div class="flex items-center gap-1.5 min-w-0 flex-1">
                        <span class="sub-curr-slot shrink-0" data-curr="<%= sc.currency %>"></span>
                        <div class="min-w-0">
                          <span class="text-[11px] font-bold text-slate-700 truncate block leading-tight">
                            <%= currencyFullNamesMap[sc.currency] || sc.currency %>
                          </span>
                          <div class="flex items-center gap-1 mt-0.5">
                            <span class="font-mono font-black text-xs text-[#0a122c]"><%= sc.price %></span>
                            <span class="text-[10px] font-bold text-slate-400 font-sans"><%= currencySymbolsMap[sc.currency] || '' %></span>
                          </div>
                        </div>
                      </div>

                      <% if (isSubOutOfStock) { %>
                        <button type="button" disabled class="px-2.5 py-1 rounded-lg bg-slate-200 text-slate-400 text-[11px] font-bold cursor-not-allowed border-none shrink-0">
                          نفذ
                        </button>
                      <% } else { %>
                        <button type="button" onclick="addToCart('<%= item._id %>', '<%= sub._id || sIdx %>', '<%= item.title.replace(/'/g, "\\'") %> - <%= sub.title.replace(/'/g, "\\'") %>', '<%= sc.currency %>', <%= sc.price %>, '<%= item.seller.discordId %>', '<%= item.seller.username %>', '<%= item.seller.avatar %>', 1, <%= subQty %>, <%= Boolean(item.requireLogin) %>, <%= Boolean(item.requirePhoneNumber) %>)" class="px-3 py-1 rounded-lg bg-[#0a122c] hover:bg-blue-600 text-white text-[11px] font-bold transition-all cursor-pointer border-none flex items-center gap-1 shadow-2xs shrink-0">
                          <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
                          <span>إضافة</span>
                        </button>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>
  </main>

  <!-- مودال سلة المشتريات -->
  <div id="cartModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-md p-4 sm:p-6">
    <div class="bg-white border border-slate-200 rounded-[2rem] max-w-xl w-full p-6 sm:p-8 shadow-2xl relative max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">shopping_cart</span>
          </div>
          <div>
            <h3 class="text-lg font-black text-slate-900">سلة المشتريات</h3>
          </div>
        </div>
        <button type="button" onclick="closeCartModal()" class="w-8 h-8 rounded-full bg-slate-50 hover:bg-slate-100 text-slate-400 hover:text-rose-700 flex items-center justify-center transition-colors">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>

