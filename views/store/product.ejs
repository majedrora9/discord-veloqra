          <div id="middlemanSection" class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2.5 hidden">
            <div class="flex items-center gap-1.5">
              <label class="text-xs font-bold text-slate-800 block">اختر عملة تسديد عمولة الوسيط (5%):</label>
              
              <div class="relative flex items-center group cursor-pointer">
                <span class="material-symbols-outlined text-slate-400 hover:text-slate-600 text-sm transition-colors">
                  info
