        <input type="tel" id="buyerPhoneInput" placeholder="أدخل رقم الهاتف بدون النداء الدولي (مثال: 0912345678)" dir="ltr" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono font-bold outline-none focus:bg-white focus:border-blue-500">
      </div>

      <div class="flex items-center gap-2 pt-2">
        <button type="button" onclick="confirmPhoneAndSubmit()" class="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md transition-colors cursor-pointer border-none flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-base">check</span>
          <span>تأكيد ومتابعة الطلب</span>
        </button>
        <button type="button" onclick="closePhoneModal()" class="py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200">
          إلغاء
        </button>
      </div>
    </div>
  </div>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    const CURRENT_USER = <%- JSON.stringify(user || null) %>;

    const ARAB_COUNTRIES = [
      { name: 'سوريا', code: 'sy-rebel', dial: '+963' },
      { name: 'العراق', code: 'iq', dial: '+964' },
      { name: 'لبنان', code: 'lb', dial: '+961' },
      { name: 'الأردن', code: 'jo', dial: '+962' },
      { name: 'فلسطين', code: 'ps', dial: '+970' },
      { name: 'مصر', code: 'eg', dial: '+20' },
      { name: 'السعودية', code: 'sa', dial: '+966' },
      { name: 'الإمارات', code: 'ae', dial: '+971' },
      { name: 'الكويت', code: 'kw', dial: '+965' },
      { name: 'قطر', code: 'qa', dial: '+974' },
      { name: 'البحرين', code: 'bh', dial: '+973' },
      { name: 'عمان', code: 'om', dial: '+968' },
      { name: 'اليمن', code: 'ye', dial: '+967' },
      { name: 'السودان', code: 'sd', dial: '+249' },
      { name: 'ليبيا', code: 'ly', dial: '+218' },
      { name: 'تونس', code: 'tn', dial: '+216' },
      { name: 'الجزائر', code: 'dz', dial: '+213' },
      { name: 'المغرب', code: 'ma', dial: '+212' },
      { name: 'موريتانيا', code: 'mr', dial: '+222' },
      { name: 'الصومال', code: 'so', dial: '+252' },
      { name: 'جيبوتي', code: 'dj', dial: '+253' },
      { name: 'جزر القمر', code: 'km', dial: '+269' }
    ];

const ALL_CURRENCIES = [
  // العملات الحالية
  { key: 'SYP_CASH', name: 'ليرة سورية (نقداً)', icon: 'payments', iconColor: 'text-emerald-500 bg-emerald-50' },
  { key: 'IQD_CASH', name: 'دينار عراقي (نقداً)', icon: 'payments', iconColor: 'text-red-500 bg-emerald-50' },
  { key: 'SYP_SHAM', name: 'ليرة سورية (شام كاش)', img: '/syp_sham.png' },
  { key: 'SYP_PAYMERA', name: 'ليرة سورية (بايميرا)', img: '/syp_paymera.png' },
  { key: 'SYP_MTN', name: 'ليرة سورية (ام تي ان كاش)', img: '/syp_mtn.png' },
  { key: 'SYP_SYRIATEL', name: 'ليرة سورية (سيرياتيل كاش)', img: '/syp_syriatel.png' },
  { key: 'IQD_ASIACELL', name: 'دينار عراقي (آسيا سيل)', img: '/iqd_asiacell.png' },
  { key: 'IQD_QI', name: 'دينار عراقي (بنك الرافدين Qi)', img: '/iqd_qi.png' },
  { key: 'USD_SHAM', name: 'دولار (شام كاش)', img: '/usd_sham.png' },
  { key: 'VELO_COIN', name: 'فيلو كوين (Velo Coin)', img: '/velo_coin.png' },

  // العملات العربية والدولية
  { key: 'TRY_PAPARA', name: 'ليرة تركية (بابارا Papara)', img: '/try_papara.png' },
  { key: 'TRY_CASH', name: 'ليرة تركية (حوالة بنكية / كاش)', img: '/try_cash.png' },
  { key: 'LBP_WHISH', name: 'ليرة لبنانية / دولار (Whish Money)', img: '/lbp_whish.png' },
  { key: 'JOD_CLIQ', name: 'دينار أردني (كليك CliQ)', img: '/jod_cliq.png' },
  { key: 'JOD_ORANGE', name: 'دينار أردني (أورنج موني Orange)', img: '/jod_orange.png' },
  { key: 'EGP_VODAFONE', name: 'جنيه مصري (فودافون كاش)', img: '/egp_vodafone.png' },
  { key: 'EGP_INSTAPAY', name: 'جنيه مصري (إنستاباي InstaPay)', img: '/egp_instapay.png' },
  { key: 'SAR_STCPAY', name: 'ريال سعودي (STC Pay)', img: '/sar_stcpay.png' },
  { key: 'SAR_URPAY', name: 'ريال سعودي (Urpay)', img: '/sar_urpay.png' },
  { key: 'USD_PAYPAL', name: 'دولار أمريكي (PayPal)', img: '/usd_paypal.png' },

  // العملات المغاربية الجديدة
  { key: 'DZD_BARIDIMOB', name: 'دينار جزائري (بريدي موب BaridiMob)', img: '/dzd_baridimob.png' },
  { key: 'DZD_CASH', name: 'دينار جزائري (CCP / نقداً)', img: '/dzd_cash.png' },
  { key: 'MAD_CIH', name: 'درهم مغربي (CIH Bank)', img: '/mad_cih.png' },
  { key: 'MAD_CASH', name: 'درهم مغربي (حوالة بنكية / نقداً)', img: '/mad_cash.png' },
  { key: 'TND_D17', name: 'دينار تونسي (D17 البريد التونسي)', img: '/tnd_d17.png' },
  { key: 'TND_FLOUCI', name: 'دينار تونسي (Flouci)', img: '/tnd_flouci.png' }
];

const USD_RATES = {
  'USD_SHAM': 1, 'USD_PAYPAL': 1, 'VELO_COIN': 100,
  'SYP_CASH': 150, 'SYP_SHAM': 150, 'SYP_PAYMERA': 150, 'SYP_MTN': 150, 'SYP_SYRIATEL': 150,
  'IQD_CASH': 1300, 'IQD_ASIACELL': 1300, 'IQD_QI': 1300,
  'TRY_PAPARA': 35, 'TRY_CASH': 35, 'LBP_WHISH': 89500,
  'JOD_CLIQ': 0.71, 'JOD_ORANGE': 0.71, 'EGP_VODAFONE': 49,
  'EGP_INSTAPAY': 49, 'SAR_STCPAY': 3.75, 'SAR_URPAY': 3.75,
  'DZD_BARIDIMOB': 135, 'DZD_CASH': 135,
  'MAD_CIH': 10, 'MAD_CASH': 10,
  'TND_D17': 3.1, 'TND_FLOUCI': 3.1
};

    const currencyNames = Object.fromEntries(ALL_CURRENCIES.map(c => [c.key, c.name]));

    function renderCurrencyBadge(currKey, sizeClass = "w-5 h-5") {
      const c = ALL_CURRENCIES.find(item => item.key === currKey);
      if (c && c.icon) {
        return `<span class="material-symbols-outlined ${sizeClass} rounded-full flex items-center justify-center text-[15px] ${c.iconColor || 'text-emerald-500 bg-emerald-50'} border border-emerald-200 shrink-0 font-bold" title="${c.name}">${c.icon}</span>`;
      }
      const imgSrc = (c && c.img) ? c.img : `/${currKey.toLowerCase()}.png`;
      return `<img src="${imgSrc}" onerror="this.src='/logo.png'" class="${sizeClass} object-contain rounded-full bg-slate-50 shrink-0">`;
    }

    // تعبئة وتحديث أيقونات العملات المعروضة في الصفحة
    document.querySelectorAll('.currency-badge-slot').forEach(el => {
      const key = el.getAttribute('data-curr') || el.textContent.trim();
      if (key) el.innerHTML = renderCurrencyBadge(key, 'w-5 h-5');
    });

    document.querySelectorAll('.sub-curr-slot').forEach(el => {
      const key = el.getAttribute('data-curr');
      if (key) el.innerHTML = renderCurrencyBadge(key, 'w-5 h-5');
    });

    let cart = JSON.parse(localStorage.getItem('veloqra_cart') || '[]');
    let useMiddleman = false;
    let calculatedMiddlemanFee = 0;

    function showToast(msg, isSuccess = true) {
      const toast = document.getElementById('appToast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = msg;
      if (isSuccess) {
        toast.className = 'flex items-center gap-2.5 shadow-2xl border bg-[#0a122c] text-white border-slate-700 show';
        toastIcon.textContent = 'check_circle';
        toastIcon.className = 'material-symbols-outlined text-lg text-[#ffd000]';
      } else {
        toast.className = 'flex items-center gap-2.5 shadow-2xl border bg-rose-950 text-white border-rose-800 show';
        toastIcon.textContent = 'error';
        toastIcon.className = 'material-symbols-outlined text-lg text-rose-400';
      }

      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function setScrollLock(locked) {
      if (locked) {
        document.body.classList.add('modal-lock');
        document.documentElement.classList.add('modal-lock');
      } else {
        const anyOpen = Array.from(document.querySelectorAll('#cartModal, #phoneRequirementModal'))
          .some(m => !m.classList.contains('hidden'));
        if (!anyOpen) {
          document.body.classList.remove('modal-lock');
          document.documentElement.classList.remove('modal-lock');
        }
      }
    }

    function updateCartUI() {
      const badge = document.getElementById('cartCountBadge');
      if (badge) {
        const totalItemsCount = cart.reduce((acc, curr) => acc + (curr.qty || 1), 0);
        badge.textContent = totalItemsCount;
        badge.classList.toggle('hidden', totalItemsCount === 0);
      }
      localStorage.setItem('veloqra_cart', JSON.stringify(cart));
    }
    updateCartUI();

    function addToCart(parentItemId, subItemId, title, currency, price, sellerDiscordId, sellerUsername, sellerAvatar, qty = 1, maxAvailable = 1, requireLogin = false, requirePhoneNumber = false) {

      if (CURRENT_USER && String(CURRENT_USER.id) === String(sellerDiscordId)) {
        return showToast('عذراً، لا يمكنك شراء منتجك الخاص أو إضافته للسلة!', false);
      }

      if (maxAvailable !== -1 && maxAvailable <= 0) {
        return showToast('عذراً، هذا المنتج نفذت كميته تماماً!', false);
      }

      if (requireLogin && !CURRENT_USER) {
        return showToast('هذا المنتج مخصص للمستخدمين المسجلين فقط، يرجى تسجيل الدخول أولاً!', false);
      }

      const existing = cart.find(i => i.parentItemId === parentItemId && i.subItemId === subItemId && i.currency === currency);
      
      if (existing) {
        if (maxAvailable !== -1 && (existing.qty + qty) > maxAvailable) {
          return showToast(`لديك هذا المنتج في السلة بالفعل بالحد الأقصى المتاح (${maxAvailable})`, false);
        }
        existing.qty += qty;
      } else {
        if (maxAvailable !== -1 && qty > maxAvailable) {
          return showToast('الكمية المطلوبة تتجاوز المتوفر في المخزن!', false);
        }
        cart.push({ parentItemId, subItemId, title, currency, price, sellerDiscordId, sellerUsername, sellerAvatar, qty, maxAvailable, requireLogin, requirePhoneNumber });
      }

      updateCartUI();
      showToast('تمت إضافة المنتج إلى السلة بنجاح!');
    }

    function openCartModal() {
      const container = document.getElementById('cartItemsList');
      const actionSection = document.getElementById('cartActionSection');

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="py-12 px-4 rounded-2xl bg-slate-50 border border-slate-200 text-center">
            <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-3 shadow-2xs">
              <span class="material-symbols-outlined text-3xl">remove_shopping_cart</span>
            </div>
            <h4 class="text-sm font-extrabold text-slate-800">السلة فارغة حالياً</h4>
            <p class="text-xs text-slate-400 mt-1">تصفح المتجر وأضف ما ترغب بشرائه للمتابعة</p>
          </div>
        `;
        if (actionSection) actionSection.classList.add('hidden');
      } else {
        container.innerHTML = cart.map((item, idx) => `
          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200 text-xs">
            <div class="min-w-0 pr-1">
              <div class="font-bold text-slate-900 truncate">${item.title}</div>
              <div class="flex items-center gap-1.5 mt-0.5">
                ${renderCurrencyBadge(item.currency, 'w-4 h-4')}
                <span class="text-[10px] text-slate-400 font-mono">${currencyNames[item.currency] || item.currency} • الكمية: ${item.qty || 1}</span>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="font-mono font-extrabold text-[#0a122c] text-sm">${item.price * (item.qty || 1)}</span>
              <button type="button" onclick="removeFromCart(${idx})" class="trash-btn-circle">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        `).join('');
        if (actionSection) actionSection.classList.remove('hidden');
        recalculateCartTotals();
      }

      const modal = document.getElementById('cartModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setScrollLock(true);
    }

    function closeCartModal() {
      const modal = document.getElementById('cartModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      setScrollLock(false);
    }

    function removeFromCart(idx) {
      cart.splice(idx, 1);
      updateCartUI();
      openCartModal();
      showToast('تم حذف العنصر من السلة');
    }

    function setMiddleman(enabled) {
      useMiddleman = enabled;
      const bM = document.getElementById('btnMiddleman');
      const bD = document.getElementById('btnDirect');
      const secM = document.getElementById('middlemanSection');
      const feeRow = document.getElementById('cartMiddlemanFeeRow');

      if (enabled) {
        bM.className = 'py-2.5 px-3 rounded-xl text-xs font-bold border border-[#0a122c] bg-[#0a122c] text-white transition-all cursor-pointer';
        bD.className = 'py-2.5 px-3 rounded-xl text-xs font-bold border border-slate-300 bg-white text-slate-700 transition-all cursor-pointer';
        secM.classList.remove('hidden');
        if (feeRow) feeRow.classList.remove('hidden');
      } else {
        bD.className = 'py-2.5 px-3 rounded-xl text-xs font-bold border border-[#0a122c] bg-[#0a122c] text-white transition-all cursor-pointer';
        bM.className = 'py-2.5 px-3 rounded-xl text-xs font-bold border border-slate-300 bg-white text-slate-700 transition-all cursor-pointer';
        secM.classList.add('hidden');
        if (feeRow) feeRow.classList.add('hidden');
      }
      recalculateCartTotals();
    }

    function recalculateCartTotals() {
      const totalsDiv = document.getElementById('cartCurrencyTotals');
      const feeRow = document.getElementById('cartMiddlemanFeeRow');
      const feeVal = document.getElementById('middlemanFeeValue');
      const feeIconSlot = document.getElementById('middlemanFeeIconSlot');
      if (!totalsDiv) return;

      const totals = {};
      let totalValueInUSD = 0;

      cart.forEach(item => {
        const itemTotal = Number(item.price) * (item.qty || 1);
        totals[item.currency] = (totals[item.currency] || 0) + itemTotal;

        const rateToUSD = USD_RATES[item.currency] || 1;
        totalValueInUSD += (itemTotal / rateToUSD);
      });

      const keys = Object.keys(totals);
      if (keys.length === 0) {
        totalsDiv.innerHTML = '<span class="text-slate-400">لا توجد مبالغ مستحقة</span>';
        if (feeRow) feeRow.classList.add('hidden');
        return;
      }

      totalsDiv.innerHTML = keys.map(k => `
        <div class="flex items-center justify-between py-1 border-b border-slate-200/60 last:border-none">
          <div class="flex items-center gap-1.5">
            ${renderCurrencyBadge(k, 'w-4 h-4')}
            <span class="text-slate-600 font-bold">${currencyNames[k] || k}:</span>
          </div>
          <span class="font-black text-[#0a122c] text-sm">${totals[k]}</span>
        </div>
      `).join('');

      if (useMiddleman && feeRow && feeVal) {
        feeRow.classList.remove('hidden');
        const feeInUSD = totalValueInUSD * 0.05;
        const middlemanCurr = document.getElementById('middlemanPaymentMethod')?.value || 'SYP_CASH';
        const targetRate = USD_RATES[middlemanCurr] || 1;

        calculatedMiddlemanFee = Math.ceil(feeInUSD * targetRate);
        feeVal.textContent = `+${calculatedMiddlemanFee} ${currencyNames[middlemanCurr] || middlemanCurr}`;
        if (feeIconSlot) feeIconSlot.innerHTML = renderCurrencyBadge(middlemanCurr, 'w-4 h-4');
      } else if (feeRow) {
        feeRow.classList.add('hidden');
        calculatedMiddlemanFee = 0;
      }
    }

    function populateCountrySelectOptions() {
      const container = document.getElementById('countryOptionsList');
      if (!container) return;
      container.innerHTML = ARAB_COUNTRIES.map(c => `
        <div class="custom-select-option" data-code="${c.code}" data-dial="${c.dial}" data-name="${c.name}" onclick="selectCountryOption(this)">
          <span class="fi fi-${c.code} rounded-xs text-sm"></span>
          <span>${c.name} (${c.dial})</span>
        </div>
      `).join('');
    }

    function toggleCountrySelect(trigger) {
      const dropdown = document.getElementById('countrySelectDropdown');
      const isActive = dropdown.classList.contains('active');
      document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      if (!isActive) {
        dropdown.classList.add('active');
        const list = document.getElementById('countryOptionsList');
        if (!list.hasChildNodes()) populateCountrySelectOptions();
      }
    }

    function filterCountryOptions(input) {
      const q = input.value.toLowerCase().trim();
      document.querySelectorAll('#countryOptionsList .custom-select-option').forEach(opt => {
        const name = opt.getAttribute('data-name').toLowerCase();
        const dial = opt.getAttribute('data-dial').toLowerCase();
        opt.style.display = (name.includes(q) || dial.includes(q)) ? 'flex' : 'none';
      });
    }

    function selectCountryOption(opt) {
      const dial = opt.getAttribute('data-dial');
      const code = opt.getAttribute('data-code');
      const name = opt.getAttribute('data-name');

      document.getElementById('selectedCountryDial').value = dial;
      document.getElementById('selectedCountryFlag').className = `fi fi-${code} rounded-xs text-sm`;
      document.getElementById('selectedCountryName').textContent = `${name} (${dial})`;
      document.getElementById('countrySelectDropdown').classList.remove('active');
    }

    function openPhoneModal() {
      const modal = document.getElementById('phoneRequirementModal');
      populateCountrySelectOptions();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setScrollLock(true);
    }

    function closePhoneModal() {
      const modal = document.getElementById('phoneRequirementModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      setScrollLock(false);
    }

    function confirmPhoneAndSubmit() {
      const dial = document.getElementById('selectedCountryDial').value.trim();
      const phone = document.getElementById('buyerPhoneInput').value.trim();

      if (!phone) {
        return showToast('يرجى إدخال رقم الهاتف لإتمام طلب الرصيد!', false);
      }

      const formattedFullPhone = `${dial}-${phone}`;
      closePhoneModal();
      processFinalCheckout(formattedFullPhone);
    }

    function checkoutCart() {
      if (cart.length === 0) return showToast('السلة فارغة!', false);

      const hasRestricted = cart.some(i => i.requireLogin);
      if (hasRestricted && !CURRENT_USER) {
        return showToast('تحتوي سلتك على منتج يتطلب تسجيل الدخول لإتمام الطلب!', false);
      }

      if (!CURRENT_USER) {
        const contactInput = document.getElementById('guestContactInput');
        const guestContact = contactInput ? contactInput.value.trim() : '';
        if (!guestContact) {
          return showToast('يرجى كتابة وسيلة تواصل لتسليم الطلب!', false);
        }
      }

      const needsPhone = cart.some(i => i.requirePhoneNumber === true || i.requirePhoneNumber === 'true');
      
      if (needsPhone) {
        closeCartModal();
        openPhoneModal();
      } else {
        processFinalCheckout(null);
      }
    }

    async function processFinalCheckout(buyerPhoneNumber = null) {
      let guestContact = null;
      if (!CURRENT_USER) {
        const contactInput = document.getElementById('guestContactInput');
        guestContact = contactInput ? contactInput.value.trim() : '';
      }

      const middlemanMethod = useMiddleman ? document.getElementById('middlemanPaymentMethod').value : null;

      try {
        const res = await fetch('/store/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            items: cart, 
            useMiddleman, 
            middlemanPaymentMethod: middlemanMethod,
            middlemanFee: calculatedMiddlemanFee,
            guestContact,
            buyerPhoneNumber
          })
        });
        const data = await res.json();
        if (data.success) {
          showToast('تم إرسال طلبك للتدقيق بنجاح!');
          cart = [];
          updateCartUI();
          closeCartModal();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showToast(data.message || 'حدث خطأ أثناء إتمام الطلب', false);
        }
      } catch (err) {
        showToast('تعذر إتمام الطلب، تأكد من الاتصال بالإنترنت', false);
      }
    }

    function populateCustomSelectOptions(container) {
      container.innerHTML = ALL_CURRENCIES.map(c => `
        <div class="custom-select-option" data-key="${c.key}" data-name="${c.name}" onclick="selectCustomOption(this)">
          ${renderCurrencyBadge(c.key, 'w-5 h-5')}
          <span class="truncate">${c.name}</span>
        </div>
      `).join('');
    }

    function toggleCustomSelect(trigger) {
      const wrap = trigger.closest('.custom-select-wrap');
      const dropdown = wrap.querySelector('.custom-select-dropdown');
      const isActive = dropdown.classList.contains('active');
      
      document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      if (!isActive) {
        dropdown.classList.add('active');
        const optionsList = dropdown.querySelector('.custom-select-options');
        if (!optionsList.hasChildNodes()) {
          populateCustomSelectOptions(optionsList);
        }
      }
    }

    function filterCustomSelectOptions(input) {
      const q = input.value.toLowerCase().trim();
      const wrap = input.closest('.custom-select-wrap');
      wrap.querySelectorAll('.custom-select-option').forEach(opt => {
        const name = opt.getAttribute('data-name').toLowerCase();
        opt.style.display = name.includes(q) ? 'flex' : 'none';
      });
    }

    function selectCustomOption(opt) {
      const wrap = opt.closest('.custom-select-wrap');
      const key = opt.getAttribute('data-key');
      const name = opt.getAttribute('data-name');

      wrap.querySelector('input').value = key;
      const trigger = wrap.querySelector('.custom-select-trigger');
      
      const badgeSlot = trigger.querySelector('.currency-badge-slot') || trigger.querySelector('img') || trigger.querySelector('span.material-symbols-outlined');
      if (badgeSlot) {
        badgeSlot.outerHTML = `<div class="currency-badge-slot shrink-0" data-curr="${key}">${renderCurrencyBadge(key, 'w-5 h-5')}</div>`;
      }
      trigger.querySelector('.selected-text').textContent = name;

      wrap.querySelector('.custom-select-dropdown').classList.remove('active');
      recalculateCartTotals();
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('#countryCodeSelectWrap')) {
        const cDrop = document.getElementById('countrySelectDropdown');
        if (cDrop) cDrop.classList.remove('active');
      }
      if (!e.target.closest('.custom-select-wrap')) {
        document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      }
    });

    ['cartModal', 'phoneRequirementModal'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('click', (e) => {
          if (e.target === el) {
            el.classList.add('hidden');
            el.classList.remove('flex');
            setScrollLock(false);
          }
        });
      }
    });
  </script>
</body>
</html>