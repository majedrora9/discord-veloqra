<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - شروط الدومين الفرعي</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <!-- Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Veloqra">
  <meta property="og:title" content="Veloqra - شروط الدومين الفرعي">
  <meta property="og:description" content="تسعى دائماً منصة فيلوكرا لتوفير الأفضل لك، مراجعة القوانين والشروط الرسمية المنظمة للتعاملات">
  <meta property="og:image" content="/logo.png">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffe27a'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    /* توافق الهيدر مع الصفحة الفاتحة */
    .page-clean-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }

    .page-clean-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.95) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }

    .page-clean-header nav span,
    .page-clean-header nav a {
      color: #0a122c !important;
    }

    .page-clean-header nav .hidden.md\:flex a:hover {
      color: #4287f5 !important;
    }

    .page-clean-header #burgerBtn {
      background-color: #f1f5f9 !important;
      border-color: #cbd5e1 !important;
    }
    .page-clean-header #burgerBtn span {
      color: #0a122c !important;
    }

    /* كروت البنود بنمط مريح للعين ومتناسق */
    .term-card-clean {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.5rem;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
      position: relative;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .term-card-clean:hover {
      border-color: #cbd5e1;
      transform: translateY(-3px);
      box-shadow: 0 16px 30px -10px rgba(10, 18, 44, 0.06);
    }
  </style>
</head>
<body class="loading-active bg-[#fbfcfd] text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('partials/header') %>
  </header>

  <main class="w-full relative flex-1 py-10 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-10">

      <!-- ترويسة الصفحة -->
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          شروط الدومين الفرعي
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base leading-relaxed">
          البنود والضوابط المعتمدة لضمان حقوق المنصة، واستقرار معاملات الدومين الفرعي
        </p>
      </div>

      <!-- حقل البحث السريع بين البنود -->
      <div class="max-w-md mx-auto relative">
        <span class="material-symbols-outlined text-slate-400 text-xl absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">search</span>
        <input 
          type="text" 
          id="termsSearchInput" 
          placeholder="ابحث في بنود وقوانين المنصة..." 
          class="w-full pr-11 pl-4 py-2.5 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#0a122c] shadow-xs transition-colors"
        >
      </div>

      <!-- شبكة البنود المنظمة (3 أعمدة مريحة وواسعة للقراءة) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" id="termsContainer"></div>

      <!-- صندوق عدم وجود نتائج للبحث -->
      <div id="noTermsResult" class="hidden py-16 text-center max-w-md mx-auto">
        <span class="material-symbols-outlined text-3xl text-slate-300 block mb-2">find_in_page</span>
        <h4 class="text-sm font-bold text-slate-800">لا توجد بنود مطابقة لبحثك</h4>
      </div>

    </div>
  </main>

  <div class="w-full mt-auto">
    <%- include('partials/footer') %>
  </div>

  <script>
    const termsData = [
      {
        icon: 'app_registration',
        title: 'التسجيل والحجز',
        desc: 'يحق للمنصة قبول أو رفض طلبات تسجيل النطاقات الفرعية، كما يحق لها حجز أسماء معينة أو رفض الأسماء المخالفة لسياستها'
      },
      {
        icon: 'public',
        title: 'النطاقات الفرعية المجانية',
        desc: 'يحق للمنصة تحديد عدد النطاقات المجانية لكل مستخدم وتعليق أو حذف النطاقات غير نشطة أو المستخدمة بشكل مخالف'
      },
      {
        icon: 'workspace_premium',
        title: 'النطاقات الفرعية المدفوعة',
        desc: 'يحق للمستخدم الحصول على النطاق المدفوع بعد إتمام الدفع، مع الالتزام بمدة الاشتراك والشروط المحددة بدقة'
      },
      {
        icon: 'payments',
        title: 'الدفع والفواتير',
        desc: 'يتلزم المستخدم بدفع الرسوم المحددة قبل تفعيل الخدمة ويحق للمنصة رفض أو إلغاء العمليات المالية غير المكتملة أو المشبوهة'
      },
      {
        icon: 'event_repeat',
        title: 'التجديد وانتهاء الصلاحية',
        desc: 'يتلزم المستخدم بتجديد نطاقه الفرعي قبل انتهاء صلاحيته، ويحق للمنصة تعليق النظام وإتاحته للتسجيل مجدداً بعد انتهاء المهلة المحددة'
      },
      {
        icon: 'currency_exchange',
        title: 'الالغاء والاسترداد',
        desc: 'يحق للمستخدم طلب الغاء الخدمة وفق الشروط المعتمدة ولاكن لايوجد أي عملية استرداد مهما كانت قيمتها'
      },
      {
        icon: 'swap_horiz',
        title: 'نقل ملكية النطاق الفرعي',
        desc: 'لا يجوز نقل النطاقات بين الحسابات دون موافقة المنصة، ويحق للادارة رفض طلبات النقل عند وجود نزاعات أو مخالفات'
      },
      {
        icon: 'shield',
        title: 'المسؤولية والحماية',
        desc: 'يتحمل المستخدم مسؤولية استخدام نطاقه ويحق للمنصة إيقاف اي نطاق يستخدم في الاحتيال أو التصيد او الانشطة الضارة'
      },
      {
        icon: 'policy',
        title: 'التعديلات على السياسة',
        desc: 'تختفظ المنصة بحق تعديل الشروط والأحكام عند الحاجة ويحق لها إشعار المستخدمين بالتغييرات التي قد تؤثر على استخدام خدماتهم'
      },

    ];

    function renderTerms(filterText = '') {
      const container = document.getElementById('termsContainer');
      const noResult = document.getElementById('noTermsResult');
      if (!container) return;

      const query = filterText.trim().toLowerCase();
      const filtered = termsData.filter(term => 
        term.title.toLowerCase().includes(query) || 
        term.desc.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        container.innerHTML = '';
        if (noResult) noResult.classList.remove('hidden');
        return;
      }

      if (noResult) noResult.classList.add('hidden');

      container.innerHTML = filtered.map((term, index) => {
        const numberStr = String(index + 1).padStart(2, '0');
        return `
          <div class="term-card-clean">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="w-11 h-11 rounded-2xl bg-slate-50 border border-slate-200/80 text-[#0a122c] flex items-center justify-center shrink-0 shadow-xs">
                  <span class="material-symbols-outlined text-2xl text-blue-600">${term.icon}</span>
                </div>
                <span class="text-xs font-mono font-bold text-slate-400 bg-slate-50 border border-slate-200/80 px-2.5 py-1 rounded-xl">
                  ${numberStr}
                </span>
              </div>

              <h3 class="font-extrabold text-slate-900 text-base mb-2 tracking-tight">
                ${term.title}
              </h3>

              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                ${term.desc}
              </p>
            </div>
          </div>
        `;
      }).join('');
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderTerms();
      const searchInput = document.getElementById('termsSearchInput');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          renderTerms(e.target.value);
        });
      }
    });
  </script>

  <script src="/js/script.js"></script>

</body>
</html>