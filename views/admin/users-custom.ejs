<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>استوديو الإدارة - تخصيص صفحات الأعضاء | Veloqra</title>
  
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/main.css">

  <style>
    /* تصحيح مشكلة خلفية الناف بار */
    .page-clean-header { 
      background: transparent !important; 
      border: none !important; 
    }
    .page-clean-header nav { 
      margin-bottom: 0 !important; 
      padding-top: 1rem !important; 
    }
    .page-clean-header nav > div:first-child,
    .page-clean-header .dheader-container {
      background-color: rgba(255, 255, 255, 0.94) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }

    /* نافذة المودال */
    .admin-modal {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 44, 0.72);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      padding: 1.25rem;
    }
    .admin-modal.show { 
      display: flex !important; 
    }
    .modal-card {
      width: 100%;
      max-width: 760px;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 24px;
      padding: 2rem;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      box-shadow: 0 25px 60px -15px rgba(10, 18, 44, 0.25);
    }

    /* حقول الإدخال */
    .form-input {
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      color: #0a122c;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      font-size: 0.825rem;
      font-weight: 600;
      outline: none;
      width: 100%;
      transition: all 0.2s ease;
    }
    .form-input:focus {
      border-color: #0a122c;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(10, 18, 44, 0.08);
    }

    /* التوست الأبيض المخصص */
    #toastNotification {
      position: fixed;
      bottom: 2rem;
      left: 2rem;
      z-index: 10000;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.875rem 1.25rem;
      border-radius: 1rem;
      background: #ffffff;
      color: #0a122c;
      border: 1.5px solid #e2e8f0;
      font-size: 0.85rem;
      font-weight: 700;
      box-shadow: 0 20px 40px -10px rgba(10, 18, 44, 0.15);
      transform: translateY(150%);
      opacity: 0;
      pointer-events: none;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #toastNotification.show {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
  </style>
</head>
<body class="bg-slate-50/70 text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-[#ffd000] selection:text-[#0a122c]">

  <!-- التوست الأبيض -->
  <div id="toastNotification">
    <span class="material-symbols-outlined text-xl text-emerald-600" id="toastIcon">check_circle</span>
    <span id="toastMessage">تم الحفظ بنجاح</span>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('partials/header', { isSubPage: true, pageTitle: 'تخصيص صفحات الأعضاء' }) %>
  </header>

  <main class="w-full relative flex-1 py-8 md:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-6">
      
      <div class="text-center max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-[#0a122c]/5 text-[#0a122c] border border-slate-200">
          <span class="material-symbols-outlined text-sm text-[#0a122c]">tune</span>
          <span>لوحة التحكم الإدارية</span>
        </span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2 tracking-tight">إدارة وتخصيص صفحات الأعضاء</h1>
        <p class="text-slate-500 text-xs sm:text-sm mt-1 font-medium">التحكم بالمظهر، الشارات، صور الخلفية، والوسائط المتعددة</p>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-center justify-between gap-4">
        <div class="relative w-full max-w-md">
          <span class="absolute right-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 text-lg">search</span>
          <input type="text" id="memberSearch" placeholder="ابحث باسم العضو أو المعرف..." oninput="filterList()" class="form-input pr-10">
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl shrink-0">
          <span class="text-xs font-bold text-slate-500">إجمالي الأعضاء:</span>
          <span class="font-mono text-xs font-extrabold text-slate-900"><%= users.length %></span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="membersList">
        <% users.forEach(u => { %>
          <div class="p-4 rounded-2xl border border-slate-200/80 bg-white shadow-xs hover:border-slate-300 transition-all flex items-center justify-between gap-3 member-card" data-search="<%= (u.globalName || '') + ' ' + u.username + ' ' + u.discordId + ' ' + (u.customSlug || '') %>">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= u.avatar || '/logo.png' %>" class="w-10 h-10 rounded-xl object-cover border border-slate-200 bg-slate-50" onerror="this.src='/logo.png'">
              <div class="min-w-0">
                <h4 class="text-sm font-extrabold text-slate-900 truncate"><%= u.globalName || u.username %></h4>
                <div class="text-[11px] font-mono text-slate-400 truncate" dir="ltr">@<%= u.username %></div>
                <% if (u.customSlug) { %>
                  <span class="inline-block mt-0.5 px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[10px] font-mono font-bold">/<%= u.customSlug %></span>
                <% } %>
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <!-- زر المعاينة الصغير الأنيق -->
              <a href="/users/<%= u.customSlug || u.discordId %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-[#0a122c] border border-slate-200 flex items-center justify-center transition-all cursor-pointer" title="معاينة البروفايل">
                <span class="material-symbols-outlined text-base">visibility</span>
              </a>
              <!-- زر التخصيص الرئيسي -->
              <button type="button" onclick='openCustomizeModal(<%- JSON.stringify(u).replace(/'/g, "&apos;") %>)' class="px-3 py-1.5 rounded-lg bg-[#0a122c] hover:bg-[#ffd000] text-white hover:text-[#0a122c] text-xs font-bold transition-all border border-[#0a122c] hover:border-[#ffd000] cursor-pointer">
                تخصيص
              </button>
            </div>
          </div>
        <% }) %>
      </div>

    </div>
  </main>

  <!-- نافذة مودال التخصيص الكامل للإدارة -->
  <div class="admin-modal" id="customizeModal" onclick="if(event.target===this) closeCustomizeModal()">
    <div class="modal-card">
      <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-100">
        <div>
          <h3 class="text-base font-extrabold text-slate-900 m-0" id="modalMemberTitle">تخصيص بروفايل العضو</h3>
          <p class="text-[11px] font-mono text-slate-400 mt-0.5" id="modalMemberSub">المعرف: -</p>
        </div>
        <button type="button" onclick="closeCustomizeModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-50 border-none flex items-center justify-center cursor-pointer transition-colors">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>

      <form action="/admin/users-custom/save" method="POST" class="space-y-4" onsubmit="showToast('جاري حفظ التعديلات...')">
        <input type="hidden" name="discordId" id="f_discordId">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- الرابط المخصص -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">الرابط المخصص (Slug)</label>
            <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50 overflow-hidden focus-within:border-[#0a122c] focus-within:bg-white" dir="ltr">
              <span class="px-3 bg-slate-100 text-slate-500 font-mono text-xs font-bold border-r border-slate-200 select-none">veloqra.xyz/users/</span>
              <input type="text" name="customSlug" id="f_customSlug" placeholder="username" class="flex-1 bg-transparent px-3 py-2 font-mono text-xs text-slate-900 outline-none">
            </div>
          </div>

          <!-- تفعيل النمط المخصص -->
          <div class="sm:col-span-2 flex items-center gap-2.5 p-3 bg-slate-50 border border-slate-200 rounded-xl">
            <input type="checkbox" name="themeEnabled" id="f_themeEnabled" value="true" class="w-4 h-4 rounded text-blue-600 cursor-pointer">
            <label for="f_themeEnabled" class="text-xs font-bold text-slate-800 cursor-pointer select-none">تفعيل المظهر المتقدم للبروفايل</label>
          </div>

          <!-- تعديل الشارات -->
          <div class="sm:col-span-2 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
            <label class="block text-xs font-extrabold text-slate-800">الشارات الممنوحة والمعروضة</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <% const systemBadgesList = (typeof allBadges !== 'undefined' && Array.isArray(allBadges)) ? allBadges : []; %>
              <% if (systemBadgesList.length > 0) { %>
                <% systemBadgesList.forEach(b => { %>
                  <label class="flex items-center gap-2 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold cursor-pointer select-none hover:bg-slate-50 transition-colors">
                    <input type="checkbox" name="userBadges" value="<%= b.key %>" class="badge-checkbox w-4 h-4 rounded text-blue-600 cursor-pointer">
                    <span class="material-symbols-outlined text-sm" style="color: <%= b.color %>"><%= b.icon %></span>
                    <span class="truncate"><%= b.name %></span>
                  </label>
                <% }) %>
              <% } else { %>
                <span class="text-xs text-slate-400 col-span-3">لا توجد شارات مسجلة بالنظام.</span>
              <% } %>
            </div>
          </div>

          <!-- نوع الخلفية -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">نوع الخلفية</label>
            <select name="bgType" id="f_bgType" class="form-input font-bold">
              <option value="color">لون مصمت</option>
              <option value="gradient">تدرج لوني</option>
              <option value="image">صورة خلفية برابط</option>
              <option value="video">فيديو صامت</option>
              <option value="video_sound">فيديو مع صوت كامل</option>
            </select>
          </div>

          <!-- رابط أو كود الخلفية -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">رابط الخلفية المباشر أو كود اللون</label>
            <input type="text" name="bgValue" id="f_bgValue" placeholder="#0a122c أو https://..." class="form-input font-mono text-xs" dir="ltr">
          </div>

          <!-- لون النصوص الرئيسي -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">لون النصوص الأساسي</label>
            <div class="flex items-center gap-2">
              <input type="color" id="f_textColorPicker" class="w-10 h-9 p-0.5 rounded-lg border border-slate-200 cursor-pointer bg-white" oninput="document.getElementById('f_textColor').value = this.value">
              <input type="text" name="textColor" id="f_textColor" placeholder="#ffffff" class="form-input font-mono text-xs uppercase" oninput="document.getElementById('f_textColorPicker').value = this.value">
            </div>
          </div>

          <!-- اللون التمييزي -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">اللون التمييزي للأيقونات والروابط</label>
            <div class="flex items-center gap-2">
              <input type="color" id="f_accentColorPicker" class="w-10 h-9 p-0.5 rounded-lg border border-slate-200 cursor-pointer bg-white" oninput="document.getElementById('f_accentColor').value = this.value">
              <input type="text" name="accentColor" id="f_accentColor" placeholder="#ffd000" class="form-input font-mono text-xs uppercase" oninput="document.getElementById('f_accentColorPicker').value = this.value">
            </div>
          </div>

          <!-- خط العرض -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">خط العرض</label>
            <select name="fontFamily" id="f_fontFamily" class="form-input font-bold">
              <option value="IBM Plex Sans Arabic">IBM Plex Sans Arabic</option>
              <option value="Cairo">Cairo</option>
              <option value="Tajawal">Tajawal</option>
              <option value="JetBrains Mono">JetBrains Mono</option>
            </select>
          </div>

          <!-- مؤشر الماوس -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">رابط صورة مؤشر الماوس المباشر</label>
            <input type="text" name="customCursorUrl" id="f_customCursorUrl" placeholder="https://domain.com/cursor.png" class="form-input font-mono text-xs" dir="ltr">
          </div>

          <!-- خلفية الكرت -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">خلفية كرت البروفايل (RGBA)</label>
            <input type="text" name="cardBg" id="f_cardBg" placeholder="rgba(255, 255, 255, 0.05)" class="form-input font-mono text-xs" dir="ltr">
          </div>

          <!-- تغبيش الكرت -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">قوة التغبيش (Blur)</label>
            <input type="text" name="cardBlur" id="f_cardBlur" placeholder="16px" class="form-input font-mono text-xs" dir="ltr">
          </div>

          <!-- رابط ملف صوتي -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">رابط ملف صوتي مباشر (Direct MP3 URL)</label>
            <input type="text" name="audioUrl" id="f_audioUrl" placeholder="https://example.com/audio.mp3" class="form-input font-mono text-xs" dir="ltr">
          </div>

          <!-- النصوص والصور المخصصة تحت الاسم -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">النصوص والصور تحت الاسم (سطر جديد أو بنفس السطر)</label>
            <textarea name="customTextsRaw" id="f_customTextsRaw" rows="4" placeholder="location_on, دمشق - سوريا&#10;img, https://domain.com/badge.png, inline&#10;img, https://domain.com/banner.png, nl" class="form-input font-mono text-xs" dir="ltr"></textarea>
            <div class="text-[11px] text-slate-500 mt-1.5 p-2 rounded-xl bg-slate-50 border border-slate-200 space-y-0.5">
              <div>- نص عادي: <code class="bg-white px-1.5 py-0.5 rounded border text-slate-800">رمز_الأيقونة, النص, nl</code> (أو بدون nl ليبقى بنفس السطر)</div>
              <div>- صورة برابط: <code class="bg-white px-1.5 py-0.5 rounded border text-slate-800">img, رابط_الصورة, inline</code> (صور أمام بعضها)</div>
              <div>- صورة بسطر جديد كامل: <code class="bg-white px-1.5 py-0.5 rounded border text-slate-800">img, رابط_الصورة, nl</code></div>
            </div>
          </div>

          <!-- الروابط المخصصة -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">الروابط المخصصة (منصة, عنوان, رابط)</label>
            <textarea name="socialLinksRaw" id="f_socialLinksRaw" rows="3" placeholder="discord, ديسكورد, https://discord.gg/...&#10;github, جيت هاب, https://github.com/..." class="form-input font-mono text-xs" dir="ltr"></textarea>
          </div>

          <!-- أكواد CSS المخصصة -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">أكواد CSS إضافية (Custom CSS)</label>
            <textarea name="customCss" id="f_customCss" rows="2" placeholder=".custom-profile-card { border-color: gold; }" class="form-input font-mono text-xs" dir="ltr"></textarea>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-3 border-t border-slate-100">
          <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-[#0a122c] hover:bg-[#ffd000] text-white hover:text-[#0a122c] font-bold text-xs transition-all border border-[#0a122c] hover:border-[#ffd000] cursor-pointer">
            حفظ كافة التعديلات
          </button>
          <button type="button" onclick="closeCustomizeModal()" class="py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 cursor-pointer">
            إلغاء
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    function showToast(message, icon = 'check_circle') {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      const toastIcon = document.getElementById('toastIcon');
      if (!toast) return;
      toastMsg.innerText = message;
      toastIcon.innerText = icon;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    function filterList() {
      const q = document.getElementById('memberSearch').value.toLowerCase().trim();
      document.querySelectorAll('.member-card').forEach(c => {
        const text = (c.getAttribute('data-search') || '').toLowerCase();
        c.style.display = !q || text.includes(q) ? 'flex' : 'none';
      });
    }

    const modal = document.getElementById('customizeModal');

    function openCustomizeModal(user) {
      document.getElementById('modalMemberTitle').innerText = 'تخصيص: ' + (user.globalName || user.username);
      document.getElementById('modalMemberSub').innerText = 'المعرف: ' + user.discordId;
      document.getElementById('f_discordId').value = user.discordId;
      document.getElementById('f_customSlug').value = user.customSlug || '';
      
      const theme = user.customTheme || {};
      document.getElementById('f_themeEnabled').checked = Boolean(theme.enabled);
      document.getElementById('f_bgType').value = theme.bgType || 'color';
      document.getElementById('f_bgValue').value = theme.bgValue || '#0a122c';
      document.getElementById('f_cardBg').value = theme.cardBg || 'rgba(255, 255, 255, 0.05)';
      document.getElementById('f_cardBlur').value = theme.cardBlur || '16px';
      document.getElementById('f_customCursorUrl').value = theme.customCursorUrl || '';

      const textCol = theme.textColor || '#ffffff';
      document.getElementById('f_textColor').value = textCol;
      document.getElementById('f_textColorPicker').value = textCol.startsWith('#') ? textCol : '#ffffff';

      const accentCol = theme.accentColor || '#ffd000';
      document.getElementById('f_accentColor').value = accentCol;
      document.getElementById('f_accentColorPicker').value = accentCol.startsWith('#') ? accentCol : '#ffd000';

      document.getElementById('f_fontFamily').value = theme.fontFamily || 'IBM Plex Sans Arabic';
      document.getElementById('f_audioUrl').value = theme.audioUrl || '';
      document.getElementById('f_customCss').value = theme.customCss || '';

      // ضبط شارات العضو
      const userBadgesList = Array.isArray(user.badges) ? user.badges : [];
      document.querySelectorAll('.badge-checkbox').forEach(cb => {
        cb.checked = userBadgesList.includes(cb.value);
      });

      // ضبط النصوص والصور المباشرة
      const texts = user.customTexts || [];
      document.getElementById('f_customTextsRaw').value = texts.map(t => {
        if (t.type === 'image') {
          return `img, ${t.imageUrl || ''}, ${t.newLine ? 'nl' : 'inline'}${t.linkUrl ? ', ' + t.linkUrl : ''}`;
        }
        return `${t.icon || ''}, ${t.text || ''}${t.newLine ? ', nl' : ''}`;
      }).join('\n');

      const links = user.socialLinks || [];
      document.getElementById('f_socialLinksRaw').value = links.map(l => `${l.platform || 'link'}, ${l.title || 'رابط'}, ${l.url || '#'}`).join('\n');

      modal.classList.add('show');
    }

    function closeCustomizeModal() {
      modal.classList.remove('show');
    }
  </script>
</body>
</html>