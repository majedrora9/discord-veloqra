<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - إدارة الطلبات</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .req-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.5rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .req-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -8px rgba(10, 18, 44, 0.07);
    }
    .filter-tab.active {
      background-color: #0a122c;
      color: #ffffff;
      border-color: #0a122c;
    }
  </style>
</head>
<body class="loading-active bg-white text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white"><div class="simple-spinner"></div></div>

  <%- include('partials/header', { isSubPage: true, pageTitle: 'إدارة الطلبات' }) %>

  <main class="w-full relative flex-1 bg-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center max-w-2xl mx-auto mb-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          إدارة الطلبات
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base mt-2">
          متابعة طلبات المشاريع والأنظمة الجديدة بجانب إعلانات البائعين
        </p>
      </div>

      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        
        <div class="relative flex-1">
          <span class="material-symbols-outlined text-slate-400 text-xl absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">search</span>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="بحث باسم المشروع، هاتف العميل، أو البائع..."
            class="w-full pr-11 pl-10 py-2.5 rounded-xl bg-white border border-slate-200 focus:border-[#0a122c] focus:outline-none text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 transition-colors shadow-sm"
          >
          <button type="button" id="clearSearchBtn" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>

        <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 shrink-0">
          <button type="button" onclick="setSectionFilter('all')" id="tab-all" class="filter-tab active px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap">
            <span>الكل</span>
            <span class="px-1.5 py-0.5 rounded-md bg-white/20 font-mono text-[11px]"><%= (customOrders || []).length + (pendingAds || []).length + (approvedAds || []).length %></span>
          </button>

          <button type="button" onclick="setSectionFilter('project_orders')" id="tab-project_orders" class="filter-tab px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:border-blue-400 text-xs font-bold transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
            <span>طلبات المشاريع</span>
            <span class="px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200 font-mono text-[11px]"><%= (customOrders || []).length %></span>
          </button>

          <button type="button" onclick="setSectionFilter('seller_ads')" id="tab-seller_ads" class="filter-tab px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:border-amber-400 text-xs font-bold transition-all flex items-center gap-2 cursor-pointer whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <span>إعلانات البائعين</span>
            <span class="px-1.5 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[11px]"><%= (pendingAds || []).length + (approvedAds || []).length %></span>
          </button>
        </div>

      </div>

      <div class="space-y-6">

        <div id="requestsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- كروت طلبات المشاريع المحدثة مع كامل التفاصيل -->
          <% (customOrders || []).forEach(order => { %>
            <div class="req-card searchable-item" data-type="project_orders" data-search="<%= order.siteName + ' ' + order.clientContact + ' ' + order.description %>">
              <div>
                <div class="flex items-center justify-between gap-3 pb-3.5 mb-4 border-b border-slate-100">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-xl">rocket_launch</span>
                    </div>
                    <div class="min-w-0">
                      <strong class="text-xs sm:text-sm font-extrabold text-slate-900 block truncate"><%= order.siteName %></strong>
                      <a href="https://wa.me/<%= order.clientContact.replace(/[^0-9]/g, '') %>" target="_blank" class="text-[11px] font-mono text-emerald-600 hover:underline block truncate" dir="ltr">
                        <%= order.clientContact %>
                      </a>
                    </div>
                  </div>

                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold <%= order.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-blue-50 text-blue-700 border border-blue-200' %>">
                    <span><%= order.status === 'approved' ? 'مقبول' : 'طلب جديد' %></span>
                  </span>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed bg-slate-50/80 p-3 rounded-xl border border-slate-100 line-clamp-3 mb-3">
                  <%= order.description %>
                </p>

                <!-- تفاصيل النطاق والخدمات السحابية الشاملة -->
                <div class="space-y-1.5 mb-3">
                  <div class="flex flex-wrap gap-1.5">
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 border text-[10px] font-bold">النمط: <%= order.colorTheme %></span>
                    
                    <% if (order.addons && order.addons.server) { %>
                      <span class="px-2 py-0.5 rounded-md bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-bold">سيرفر خاص</span>
                    <% } %>

                    <% if (order.addons && order.addons.subdomain && order.addons.subdomain.selected) { %>
                      <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-bold font-mono" dir="ltr">
                        <%= order.addons.subdomain.name %>.veloqra.xyz
                      </span>
                    <% } %>

                    <% if (order.addons && order.addons.customDomain && order.addons.customDomain.selected) { %>
                      <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-bold font-mono" dir="ltr">
                        <%= order.addons.customDomain.name %><%= order.addons.customDomain.ext %>
                      </span>
                    <% } %>
                  </div>

                  <!-- تفاصيل البريد والتحويل -->
                  <% if (order.addons && order.addons.email && order.addons.email.selected) { %>
                    <div class="p-2 rounded-lg bg-slate-50 border border-slate-100 text-[11px] font-mono space-y-0.5" dir="ltr">
                      <div class="text-blue-700 font-bold truncate">
                        Mail: <%= order.addons.email.fullEmail || (order.addons.email.inbox + '@domain') %>
                      </div>
                      <div class="text-slate-400 text-[10px] truncate">
                        -> <%= order.addons.email.destinationEmail %>
                      </div>
                    </div>
                  <% } %>
                </div>

                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-[11px] flex items-center justify-between">
                  <span class="text-slate-500 font-bold">التكلفة السحابية:</span>
                  <span class="font-mono font-extrabold text-blue-600 text-sm"><%= order.estimatedTotal %> $ / شهر</span>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono text-slate-400" dir="ltr">
                  <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </span>

                <div class="flex items-center gap-1.5">
                  <form action="/admin/orders/action" method="POST" class="m-0">
                    <input type="hidden" name="orderId" value="<%= order._id %>">
                    <input type="hidden" name="action" value="approve">
                    <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-600 text-emerald-600 hover:text-white border border-emerald-200 text-xs font-bold transition-colors cursor-pointer">
                      قبول
                    </button>
                  </form>

                  <form action="/admin/orders/action" method="POST" class="m-0" onsubmit="return confirm('حذف طلب هذا المشروع نهائياً؟')">
                    <input type="hidden" name="orderId" value="<%= order._id %>">
                    <input type="hidden" name="action" value="delete">
                    <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 text-xs font-bold transition-colors cursor-pointer">
                      حذف
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>

          <!-- إعلانات البائعين المعلقة -->
          <% (pendingAds || []).forEach(item => { %>
            <div class="req-card searchable-item" data-type="seller_ads" data-search="<%= (item.sellerName || '') + ' ' + (item.sellerDiscordId || '') + ' ' + (item.ad.title || '') + ' ' + (item.ad.description || '') %>">
              <div>
                <div class="flex items-center justify-between gap-3 pb-3.5 mb-4 border-b border-slate-100">
                  <div class="flex items-center gap-3 min-w-0">
                    <img src="<%= item.sellerAvatar || '/logo.png' %>" class="w-10 h-10 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0" onerror="this.src='/logo.png'">
                    <div class="min-w-0">
                      <strong class="text-xs sm:text-sm font-extrabold text-slate-900 block truncate"><%= item.sellerName %></strong>
                      <span class="text-[11px] font-mono text-slate-400 block truncate" dir="ltr">ID: <%= item.sellerDiscordId %></span>
                    </div>
                  </div>
                  
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    <span>إعلان بائع</span>
                  </span>
                </div>

                <h3 class="text-base font-extrabold text-slate-900 mb-2 tracking-tight"><%= item.ad.title %></h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 line-clamp-3"><%= item.ad.description %></p>
              </div>

              <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between gap-2">
                <span class="font-mono text-xs font-extrabold text-slate-900"><%= item.ad.price %>$</span>

                <div class="flex items-center gap-2">
                  <form action="/admin/requests/action" method="POST" class="m-0">
                    <input type="hidden" name="sellerId" value="<%= item.sellerId %>">
                    <input type="hidden" name="adId" value="<%= item.ad._id %>">
                    <input type="hidden" name="action" value="approve">
                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-600 text-emerald-600 hover:text-white border border-emerald-200 text-xs font-bold transition-all cursor-pointer">
                      قبول
                    </button>
                  </form>

                  <form action="/admin/requests/action" method="POST" class="m-0">
                    <input type="hidden" name="sellerId" value="<%= item.sellerId %>">
                    <input type="hidden" name="adId" value="<%= item.ad._id %>">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 text-xs font-bold transition-all cursor-pointer">
                      رفض
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>

          <!-- الإعلانات المقبولة -->
          <% (approvedAds || []).forEach(item => { %>
            <div class="req-card searchable-item" data-type="seller_ads" data-search="<%= (item.sellerName || '') + ' ' + (item.sellerDiscordId || '') + ' ' + (item.ad.title || '') + ' ' + (item.ad.description || '') %>">
              <div>
                <div class="flex items-center justify-between gap-3 pb-3.5 mb-4 border-b border-slate-100">
                  <div class="flex items-center gap-3 min-w-0">
                    <img src="<%= item.sellerAvatar || '/logo.png' %>" class="w-10 h-10 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0" onerror="this.src='/logo.png'">
                    <div class="min-w-0">
                      <strong class="text-xs sm:text-sm font-extrabold text-slate-900 block truncate"><%= item.sellerName %></strong>
                      <span class="text-[11px] font-mono text-slate-400 block truncate" dir="ltr">ID: <%= item.sellerDiscordId %></span>
                    </div>
                  </div>

                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span>إعلان منشور</span>
                  </span>
                </div>

                <h3 class="text-base font-extrabold text-slate-900 mb-2 tracking-tight"><%= item.ad.title %></h3>
                <p class="text-xs text-slate-600 leading-relaxed bg-slate-50/80 p-3 rounded-xl border border-slate-100 line-clamp-3"><%= item.ad.description %></p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                <span class="font-mono text-xs font-extrabold text-slate-900"><%= item.ad.price %> Coin</span>

                <form action="/admin/requests/action" method="POST" class="m-0 shrink-0">
                  <input type="hidden" name="sellerId" value="<%= item.sellerId %>">
                  <input type="hidden" name="adId" value="<%= item.ad._id %>">
                  <input type="hidden" name="action" value="delete">
                  <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 text-xs font-bold transition-all cursor-pointer">
                    حذف
                  </button>
                </form>
              </div>
            </div>
          <% }) %>

        </div>

      </div>

    </div>
  </main>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const searchableItems = document.querySelectorAll('.searchable-item');
    let currentFilter = 'all';

    function applyFilters() {
      const query = (searchInput.value || '').trim().toLowerCase();
      if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', query.length === 0);

      searchableItems.forEach(card => {
        const text = (card.getAttribute('data-search') || '').toLowerCase();
        const type = card.getAttribute('data-type');
        const matchesSearch = !query || text.includes(query);
        const matchesTab = currentFilter === 'all' || currentFilter === type;

        card.style.display = (matchesSearch && matchesTab) ? '' : 'none';
      });
    }

    function setSectionFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('.filter-tab').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById('tab-' + filter);
      if (activeBtn) activeBtn.classList.add('active');
      applyFilters();
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        applyFilters();
        searchInput.focus();
      });
    }
  </script>
</body>
</html>