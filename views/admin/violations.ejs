<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra Admin - إدارة البائعين</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    .custom-select-wrap {
      position: relative;
    }
    .custom-select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      color: #0a122c;
      padding: 0.65rem 2.5rem 0.65rem 1rem;
      border-radius: 0.75rem;
      font-size: 0.875rem;
      font-weight: 700;
      width: 100%;
      cursor: pointer;
      outline: none;
      transition: all 0.2s ease;
    }
    .custom-select:focus {
      border-color: #4287f5;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(66, 135, 245, 0.15);
    }
    .custom-select-icon {
      position: absolute;
      top: 50%;
      left: 0.85rem;
      transform: translateY(-50%);
      pointer-events: none;
      color: #64748b;
    }

    .admin-modal {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 44, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      padding: 1.5rem;
    }

    .admin-modal.show {
      display: flex !important;
    }

    .modal-card {
      width: 100%;
      max-width: 440px;
      border-radius: 24px;
      padding: 2rem;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      box-shadow: 0 25px 60px rgba(10, 18, 44, 0.25);
    }

    .seller-item-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.25rem;
      padding: 1.25rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .seller-item-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -8px rgba(10, 18, 44, 0.06);
    }
  </style>
</head>
<body class="loading-active bg-white text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <%- include('partials/header', { isSubPage: true, pageTitle: 'إدارة البائعين' }) %>

  <main class="w-full relative flex-1 bg-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">

      <div class="text-center max-w-2xl mx-auto mb-6">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          إدارة البائعين
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base mt-2">
          توثيق البائعين الجدد، متابعة أرصدتهم ومبيعاتهم، وإصدار المخالفات الإدارية
        </p>
      </div>

      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold flex items-center gap-2.5">
          <span class="material-symbols-outlined text-xl text-rose-600">error</span>
          <span><%= errorMsg %></span>
        </div>
      <% } %>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">

        <div class="bento-card p-6 sm:p-8 flex flex-col justify-between bg-white border border-slate-200 rounded-3xl">
          <div>
            <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">verified</span>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">توثيق بائع باستخدام الأيدي</h3>
                <p class="text-xs text-slate-400 mt-0.5">منح رتبة البائع وصلاحية فتح المتجر</p>
              </div>
            </div>
          </div>

          <form action="/admin/sellers/verify" method="POST" class="flex flex-col flex-1 mt-2">
            <div class="mb-5">
              <label class="block text-xs font-bold text-slate-700 mb-1.5">
                معرف ديسكورد البائع (Discord ID) <span class="text-rose-500">*</span>
              </label>
              <input type="text" name="discordId" required placeholder="691044838459834430" dir="ltr"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 font-mono text-sm focus:bg-white focus:outline-none focus:border-[#0a122c] transition-colors">
            </div>

            <div class="mt-auto pt-4">
              <button type="submit" class="w-full py-3 px-5 rounded-xl bg-[#0a122c] hover:bg-emerald-600 text-white font-bold text-sm shadow-sm transition-colors flex items-center justify-center gap-2 cursor-pointer border-none">
                <span class="material-symbols-outlined text-lg">check_circle</span>
                <span>توثيق البائع</span>
              </button>
            </div>
          </form>
        </div>

        <div class="bento-card p-6 sm:p-8 flex flex-col justify-between bg-white border border-slate-200 rounded-3xl">
          <div>
            <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100">
              <div class="w-12 h-12 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">gavel</span>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">إصدار مخالفة لبائع بالأيدي</h3>
                <p class="text-xs text-slate-400 mt-0.5">تسجيل تنبيه رسمي في سجل التاجر</p>
              </div>
            </div>
          </div>

          <form action="/admin/violations/add" method="POST" class="space-y-4 flex flex-col flex-1">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">
                  معرف البائع (Discord ID) <span class="text-rose-500">*</span>
                </label>
                <input type="text" name="discordId" required placeholder="691044838459834430" dir="ltr"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 font-mono text-sm focus:bg-white focus:outline-none focus:border-[#0a122c] transition-colors">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">نوع المخالفة</label>
                <div class="custom-select-wrap">
                  <select name="severity" class="custom-select">
                    <option value="تحذير">تحذير إداري</option>
                    <option value="مخالفة متوسطة">مخالفة متوسطة</option>
                    <option value="مخالفة جسيمة">مخالفة جسيمة</option>
                  </select>
                  <span class="material-symbols-outlined text-base custom-select-icon">unfold_more</span>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1.5">
                سبب المخالفة <span class="text-rose-500">*</span>
              </label>
              <input type="text" name="reason" required placeholder="التأخر في تسليم الطلب أو مخالفة شروط المتجر"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:bg-white focus:outline-none focus:border-[#0a122c] transition-colors">
            </div>

            <div class="mt-auto pt-4">
              <button type="submit" class="w-full py-3 px-5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow-sm transition-colors flex items-center justify-center gap-2 cursor-pointer border-none">
                <span class="material-symbols-outlined text-lg">report</span>
                <span>تسجيل المخالفة للبائع</span>
              </button>
            </div>
          </form>
        </div>

      </div>

      <div class="bento-card p-6 sm:p-8 bg-white border border-slate-200 rounded-3xl space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-4 pb-5 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-2xl">storefront</span>
            </div>
            <div>
              <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">قائمة البائعين المعتمدين</h3>
              <p class="text-xs text-slate-400">إجمالي البائعين المسجلين: <span class="font-mono font-bold text-slate-700"><%= sellers.length %></span></p>
            </div>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto flex-1 sm:justify-end">
            <div class="relative w-full sm:w-72">
              <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">search</span>
              <input 
                type="text" 
                id="sellerSearchInput" 
                placeholder="ابحث باسم البائع أو الآيدي..." 
                class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-[#0a122c] transition-colors shadow-sm"
              >
              <button type="button" id="clearSellerSearchBtn" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">
                <span class="material-symbols-outlined text-base">close</span>
              </button>
            </div>

            <span class="px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold whitespace-nowrap">
              المعروض: <span class="font-mono text-blue-600 font-extrabold" id="sellersVisibleCount"><%= sellers.length %></span>
            </span>
          </div>
        </div>

        <% if (sellers.length === 0) { %>
          <div class="py-16 text-center">
            <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-3xl">group_off</span>
            </div>
            <h4 class="text-base font-bold text-slate-700">لا يوجد بائعون مسجلون حتى الآن</h4>
          </div>
        <% } else { %>
          <div id="sellersContainer" class="space-y-4">
            <% sellers.forEach((s, idx) => { %>
              <% const vCount = (s.violations && s.violations.length) || 0; %>
              <div class="seller-item-card" data-search="<%= (s.username || '').toLowerCase() %> <%= s.discordId %>">
                
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                  <div class="flex items-center gap-3.5 min-w-0">
                    <img src="<%= s.avatar || '/logo.png' %>" alt="Avatar" class="w-12 h-12 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0" onerror="this.src='/logo.png'">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <h4 class="text-base font-extrabold text-slate-900 truncate"><%= s.username %></h4>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold shrink-0">
                          <span class="material-symbols-outlined text-xs">verified</span>
                          <span>موثق</span>
                        </span>
                      </div>
                      <div class="text-xs text-slate-400 font-mono mt-0.5" dir="ltr">ID: <%= s.discordId %></div>
                    </div>
                  </div>

                  <div class="flex items-center gap-2.5 flex-wrap">
                    <div class="px-3.5 py-2 rounded-xl bg-amber-50/70 border border-amber-200/80 text-amber-900 text-xs font-bold flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-base text-amber-600">monetization_on</span>
                      <span>الرصيد: <strong class="font-mono text-slate-900"><%= s.veloCoins || 0 %></strong> Coin</span>
                    </div>

                    <div class="px-3.5 py-2 rounded-xl bg-blue-50/70 border border-blue-200/80 text-blue-900 text-xs font-bold flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-base text-blue-600">shopping_bag</span>
                      <span>المبيعات: <strong class="font-mono text-slate-900"><%= s.salesCount || 0 %></strong></span>
                    </div>

                    <% if (vCount > 0) { %>
                      <button type="button" onclick="toggleViolationsList('viol-box-<%= idx %>', 'arrow-viol-<%= idx %>')" class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-base text-rose-600">gavel</span>
                        <span>المخالفات: <strong class="font-mono"><%= vCount %></strong></span>
                        <span class="material-symbols-outlined text-sm transition-transform duration-200" id="arrow-viol-<%= idx %>">expand_more</span>
                      </button>
                    <% } else { %>
                      <div class="px-3.5 py-2 rounded-xl bg-emerald-50/70 border border-emerald-200/80 text-emerald-700 text-xs font-bold flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
                        <span>المخالفات (0)</span>
                      </div>
                    <% } %>

                    <button type="button" 
                            onclick="promptDeleteSeller('<%= s._id %>', '<%= (s.username || '').replace(/'/g, "\\'") %>')" 
                            class="p-2 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 hover:border-rose-600 flex items-center justify-center transition-all cursor-pointer" 
                            title="إلغاء التوثيق وحذف البائع">
                      <span class="material-symbols-outlined text-base">delete_forever</span>
                    </button>
                  </div>
                </div>

                <% if (vCount > 0) { %>
                  <div id="viol-box-<%= idx %>" class="hidden mt-4 pt-4 border-t border-slate-100 space-y-3">
                    <div class="text-xs font-extrabold text-rose-700 mb-2 flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-base">warning</span>
                      <span>تفاصيل المخالفات المسجلة بحق التاجر</span>
                    </div>

                    <% s.violations.forEach(v => { %>
                      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        
                        <div class="space-y-1 flex-1">
                          <div class="flex items-center gap-2 flex-wrap">
                            <span class="px-2.5 py-0.5 rounded-md text-xs font-extrabold <%= v.severity === 'مخالفة جسيمة' ? 'bg-red-100 text-red-800 border border-red-200' : (v.severity === 'مخالفة متوسطة' ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-rose-50 text-rose-700 border border-rose-200') %>">
                              <%= v.severity %>
                            </span>
                            <span class="text-xs text-slate-400 font-mono" dir="ltr">
                              <%= new Date(v.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %> - <%= new Date(v.date).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                            </span>
                          </div>
                          <p class="text-xs sm:text-sm font-semibold text-slate-800 leading-relaxed mt-1">
                            <%= v.reason %>
                          </p>
                        </div>

                        <div class="flex items-center gap-3 sm:border-r sm:pr-4 sm:border-slate-200 shrink-0">
                          <div class="text-right">
                            <span class="text-[10px] font-bold text-slate-400 block">بواسطة المشرف:</span>
                            <strong class="text-xs font-extrabold text-slate-900 block"><%= v.adminName || v.issuedBy || (user && (user.global_name || user.username)) || 'إداري' %></strong>
                            <span class="text-[10px] text-blue-600 font-mono block" dir="ltr">ID: <%= v.adminId || (user && user.id) || '' %></span>
                          </div>
                          <img src="<%= v.adminAvatar || (user && user.avatar) || '/logo.png' %>" alt="Admin Avatar" class="w-9 h-9 rounded-full object-cover border border-slate-200 bg-white" onerror="this.src='/logo.png'">

                          <button type="button" 
                                  onclick="promptDeleteViolation('<%= s._id %>', '<%= v._id %>')" 
                                  class="p-1.5 rounded-lg bg-white hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 hover:border-rose-600 text-xs font-bold transition-all flex items-center justify-center cursor-pointer mr-2" 
                                  title="حذف هذه المخالفة">
                            <span class="material-symbols-outlined text-base">delete</span>
                          </button>
                        </div>

                      </div>
                    <% }) %>
                  </div>
                <% } %>

              </div>
            <% }) %>
          </div>

          <div id="noSellerSearchResults" class="hidden py-16 px-4 rounded-2xl bg-slate-50 border border-slate-200 text-center">
            <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-3 shadow-sm">
              <span class="material-symbols-outlined text-3xl">person_search</span>
            </div>
            <h4 class="text-sm font-extrabold text-slate-800">لا توجد نتائج مطابقة لبحثك</h4>
            <p class="text-xs text-slate-500 mt-1">تأكد من كتابة اسم البائع أو الآيدي بالشكل الصحيح</p>
          </div>
        <% } %>

      </div>

    </div>
  </main>

  <div class="admin-modal" id="confirmDeleteModal">
    <div class="modal-card text-center">
      <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-3xl">warning</span>
      </div>

      <h3 class="text-lg font-extrabold text-slate-900 mb-1" id="confirmModalTitle">تأكيد عملية الحذف</h3>
      <p class="text-xs sm:text-sm text-slate-500 mb-6 leading-relaxed" id="confirmModalDesc">هل أنت متأكد من المتابعة؟ لا يمكن التراجع عن هذا الإجراء</p>

      <form id="confirmActionForm" method="POST" class="m-0">
        <input type="hidden" name="sellerId" id="confirmInputSellerId">
        <input type="hidden" name="violationId" id="confirmInputViolationId">

        <div class="flex items-center gap-3">
          <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition-colors cursor-pointer border-none shadow-sm">
            نعم، احذف نهائياً
          </button>
          <button type="button" onclick="closeConfirmModal()" class="py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer border border-slate-200">
            إلغاء الأمر
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    function toggleViolationsList(boxId, arrowId) {
      const box = document.getElementById(boxId);
      const arrow = document.getElementById(arrowId);
      if (!box || !arrow) return;

      const isHidden = box.classList.toggle('hidden');
      arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    const searchInput = document.getElementById('sellerSearchInput');
    const clearSearchBtn = document.getElementById('clearSellerSearchBtn');
    const sellerCards = document.querySelectorAll('.seller-item-card');
    const sellersContainer = document.getElementById('sellersContainer');
    const noResultsBox = document.getElementById('noSellerSearchResults');
    const countEl = document.getElementById('sellersVisibleCount');

    function filterSellers() {
      const query = (searchInput.value || '').toLowerCase().trim();
      if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', query.length === 0);

      let visibleCount = 0;

      sellerCards.forEach(card => {
        const searchTarget = (card.getAttribute('data-search') || '').toLowerCase();
        if (!query || searchTarget.includes(query)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (sellersContainer) {
        sellersContainer.style.display = visibleCount === 0 ? 'none' : '';
      }

      if (noResultsBox) {
        noResultsBox.classList.toggle('hidden', visibleCount > 0);
      }

      if (countEl) {
        countEl.innerText = visibleCount;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterSellers);
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterSellers();
        searchInput.focus();
      });
    }

    const confirmModal = document.getElementById('confirmDeleteModal');
    const confirmForm = document.getElementById('confirmActionForm');
    const confirmTitle = document.getElementById('confirmModalTitle');
    const confirmDesc = document.getElementById('confirmModalDesc');
    const inputSellerId = document.getElementById('confirmInputSellerId');
    const inputViolationId = document.getElementById('confirmInputViolationId');

    if (confirmModal) {
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) closeConfirmModal();
      });
    }

    function closeConfirmModal() {
      if (confirmModal) confirmModal.classList.remove('show');
    }

    function promptDeleteSeller(sellerId, sellerName) {
      confirmForm.action = '/admin/sellers/delete';
      inputSellerId.value = sellerId;
      inputViolationId.value = '';
      confirmTitle.innerText = 'حذف البائع نهائياً';
      confirmDesc.innerHTML = `هل أنت متأكد من حذف البائع <strong>"${sellerName}"</strong> وإلغاء توثيقه من المنصة بالكامل؟`;
      confirmModal.classList.add('show');
    }

    function promptDeleteViolation(sellerId, violationId) {
      confirmForm.action = '/admin/violations/delete';
      inputSellerId.value = sellerId;
      inputViolationId.value = violationId;
      confirmTitle.innerText = 'حذف المخالفة';
      confirmDesc.innerText = 'هل أنت متأكد من مسح هذه المخالفة من سجل التاجر نهائياً؟';
      confirmModal.classList.add('show');
    }
  </script>
</body>
</html>