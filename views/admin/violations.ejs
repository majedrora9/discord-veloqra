<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra Admin - إدارة البائعين</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/main.css">

  <style>
    .clean-box {
      background: #ffffff;
      border: 1px solid #eef2f6;
      border-radius: 1.25rem;
      padding: 1.25rem;
      box-shadow: 0 1px 3px rgba(10, 18, 44, 0.04);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .clean-box:hover {
      border-color: #cbd5e1;
      box-shadow: 0 10px 20px -5px rgba(10, 18, 44, 0.05);
    }

    .seller-card {
      background: #ffffff;
      border: 1px solid #eef2f6;
      border-radius: 1.25rem;
      padding: 1.25rem;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .seller-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -6px rgba(10, 18, 44, 0.06);
    }

    .custom-select-wrap {
      position: relative;
    }
    .custom-select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      color: #0a122c;
      padding: 0.65rem 2.5rem 0.65rem 1rem;
      border-radius: 0.75rem;
      font-size: 0.8rem;
      font-weight: 700;
      width: 100%;
      cursor: pointer;
      outline: none;
      transition: all 0.2s ease;
    }
    .custom-select:focus {
      border-color: #4287f5;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(66, 135, 245, 0.15);
    }
    .custom-select-icon {
      position: absolute;
      top: 50%;
      left: 0.85rem;
      transform: translateY(-50%);
      pointer-events: none;
      color: #64748b;
    }

    .admin-modal {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 44, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      padding: 1.5rem;
    }
    .admin-modal.show {
      display: flex !important;
    }
    .modal-card {
      width: 100%;
      max-width: 440px;
      border-radius: 1.5rem;
      padding: 1.75rem;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      box-shadow: 0 25px 60px rgba(10, 18, 44, 0.2);
    }
  </style>
</head>
<body class="loading-active bg-slate-50/50 text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <%- include('partials/header', { isSubPage: true, pageTitle: 'إدارة البائعين' }) %>

  <main class="w-full relative flex-1 py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">

      <!-- ترويسة الصفحة وإحصائيات سريعة -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2.5">
            <span class="w-2.5 h-7 rounded-full bg-blue-600 inline-block"></span>
            <span>إدارة البائعين والمخالفات</span>
          </h1>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
            توثيق البائعين الجدد، متابعة أرصدتهم ومبيعاتهم، وتسجيل التنبيهات الإدارية
          </p>
        </div>

        <% 
          const sellersList = sellers || [];
          const totalViolations = sellersList.reduce((acc, curr) => acc + ((curr.violations && curr.violations.length) || 0), 0);
        %>

        <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0">
          <div class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 shadow-2xs flex items-center gap-2">
            <span class="text-[11px] font-bold text-slate-500">إجمالي البائعين:</span>
            <span class="font-mono font-black text-xs text-slate-900"><%= sellersList.length %></span>
          </div>
          <% if (totalViolations > 0) { %>
            <div class="px-3.5 py-2 rounded-xl bg-rose-50/80 border border-rose-200/80 shadow-2xs flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
              <span class="text-[11px] font-bold text-rose-900">المخالفات النشطة:</span>
              <span class="font-mono font-black text-xs text-rose-900"><%= totalViolations %></span>
            </div>
          <% } %>
        </div>
      </div>

      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-bold flex items-center gap-2.5 shadow-2xs">
          <span class="material-symbols-outlined text-lg text-rose-600">error</span>
          <span><%= errorMsg %></span>
        </div>
      <% } %>

      <!-- بطاقات الإجراءات (توثيق بائع + إصدار مخالفة) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-stretch">

        <!-- بطاقة توثيق البائع -->
        <div class="clean-box flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 pb-3 mb-4 border-b border-slate-100">
              <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl">verified</span>
              </div>
              <div>
                <h3 class="text-sm font-extrabold text-slate-900">توثيق بائع باستخدام الآيدي</h3>
                <p class="text-[11px] text-slate-400 mt-0.5">منح رتبة البائع المعتمد وصلاحية نشر السلع</p>
              </div>
            </div>
          </div>

          <form action="/admin/sellers/verify" method="POST" class="flex flex-col flex-1 space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                معرف ديسكورد البائع (Discord ID) <span class="text-rose-500">*</span>
              </label>
              <input type="text" name="discordId" required placeholder="مثال: 691044838459834430" dir="ltr"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 font-mono text-xs focus:bg-white focus:outline-none focus:border-blue-500 transition-colors">
            </div>

            <div class="pt-1 mt-auto">
              <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-[#0a122c] hover:bg-emerald-600 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer border-none shadow-2xs">
                <span class="material-symbols-outlined text-base">check_circle</span>
                <span>تأكيد توثيق البائع</span>
              </button>
            </div>
          </form>
        </div>

        <!-- بطاقة إصدار مخالفة -->
        <div class="clean-box flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 pb-3 mb-4 border-b border-slate-100">
              <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl">gavel</span>
              </div>
              <div>
                <h3 class="text-sm font-extrabold text-slate-900">إصدار مخالفة لبائع بالآيدي</h3>
                <p class="text-[11px] text-slate-400 mt-0.5">تسجيل تنبيه إداري رسمي في سجل التاجر</p>
              </div>
            </div>
          </div>

          <form action="/admin/violations/add" method="POST" class="space-y-3 flex flex-col flex-1">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  معرف البائع (Discord ID) <span class="text-rose-500">*</span>
                </label>
                <input type="text" name="discordId" required placeholder="ID الحساب" dir="ltr"
                  class="w-full px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 font-mono text-xs focus:bg-white focus:outline-none focus:border-blue-500 transition-colors">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">درجة المخالفة</label>
                <div class="custom-select-wrap">
                  <select name="severity" class="custom-select">
                    <option value="تحذير">تحذير إداري</option>
                    <option value="مخالفة متوسطة">مخالفة متوسطة</option>
                    <option value="مخالفة جسيمة">مخالفة جسيمة</option>
                  </select>
                  <span class="material-symbols-outlined text-sm custom-select-icon">unfold_more</span>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                سبب المخالفة <span class="text-rose-500">*</span>
              </label>
              <input type="text" name="reason" required placeholder="التأخر في تسليم الطلب أو مخالفة شروط وضمان المتجر"
                class="w-full px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-xs focus:bg-white focus:outline-none focus:border-blue-500 transition-colors">
            </div>

            <div class="pt-1 mt-auto">
              <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer border-none shadow-2xs">
                <span class="material-symbols-outlined text-base">report</span>
                <span>تسجيل المخالفة فوراً</span>
              </button>
            </div>
          </form>
        </div>

      </div>

      <!-- قائمة البائعين المسجلين -->
      <div class="space-y-4">
        
        <!-- شريط البحث السريع والفلترة للبائعين -->
        <div class="p-3 rounded-2xl bg-white border border-slate-200 shadow-2xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <div class="relative flex-1">
            <span class="material-symbols-outlined text-slate-400 text-lg absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">search</span>
            <input 
              type="text" 
              id="sellerSearchInput" 
              placeholder="ابحث باسم البائع أو بمعرف الآيدي..." 
              class="w-full pr-10 pl-9 py-2.5 rounded-xl bg-slate-50/70 border border-transparent focus:border-blue-500 focus:bg-white focus:outline-none text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 transition-all"
            >
            <button type="button" id="clearSellerSearchBtn" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">
              <span class="material-symbols-outlined text-base">close</span>
            </button>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center">
            <span class="px-3 py-2 rounded-xl bg-slate-100 text-slate-600 text-xs font-bold whitespace-nowrap">
              النتائج المعروضة: <span class="font-mono text-blue-600 font-black" id="sellersVisibleCount"><%= sellersList.length %></span>
            </span>
          </div>
        </div>

        <% if (sellersList.length === 0) { %>
          <div class="py-16 text-center bg-white border border-slate-200 rounded-2xl">
            <div class="w-12 h-12 rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-2xl">group_off</span>
            </div>
            <h4 class="text-sm font-extrabold text-slate-800">لا يوجد بائعون مسجلون حتى الآن</h4>
          </div>
        <% } else { %>
          <div id="sellersContainer" class="space-y-3">
            <% sellersList.forEach((s, idx) => { %>
              <% const vCount = (s.violations && s.violations.length) || 0; %>
              <div class="seller-card" data-search="<%= (s.username || '').toLowerCase() %> <%= s.discordId %>">
                
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                  <!-- معلومات البائع الأساسية -->
                  <div class="flex items-center gap-3 min-w-0">
                    <img src="<%= s.avatar || '/logo.png' %>" alt="Avatar" class="w-10 h-10 rounded-full object-cover border border-slate-200 shrink-0" onerror="this.src='/logo.png'">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <h4 class="text-xs sm:text-sm font-black text-slate-900 truncate">@<%= s.username %></h4>
                        <span class="inline-flex items-center gap-1 px-2 py-0.2 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-bold shrink-0">
                          <span class="material-symbols-outlined text-xs">verified</span>
                          <span>موثق</span>
                        </span>
                      </div>
                      <div class="text-[10px] text-slate-400 font-mono mt-0.5" dir="ltr"><%= s.discordId %></div>
                    </div>
                  </div>

                  <!-- المؤشرات والأزرار الإدارية -->
                  <div class="flex items-center gap-2 flex-wrap shrink-0">
                    <div class="px-2.5 py-1.5 rounded-xl bg-amber-50/70 border border-amber-200/80 text-amber-900 text-xs font-bold flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-sm text-amber-600">monetization_on</span>
                      <span>الرصيد: <strong class="font-mono text-slate-900"><%= s.veloCoins || 0 %></strong></span>
                    </div>

                    <div class="px-2.5 py-1.5 rounded-xl bg-blue-50/70 border border-blue-200/80 text-blue-900 text-xs font-bold flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-sm text-blue-600">shopping_bag</span>
                      <span>المبيعات: <strong class="font-mono text-slate-900"><%= s.salesCount || 0 %></strong></span>
                    </div>

                    <% if (vCount > 0) { %>
                      <button type="button" onclick="toggleViolationsList('viol-box-<%= idx %>', 'arrow-viol-<%= idx %>')" class="px-2.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-sm text-rose-600">gavel</span>
                        <span>المخالفات: <strong class="font-mono"><%= vCount %></strong></span>
                        <span class="material-symbols-outlined text-sm transition-transform duration-200" id="arrow-viol-<%= idx %>">expand_more</span>
                      </button>
                    <% } else { %>
                      <div class="px-2.5 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
                        <span>نظيف (0)</span>
                      </div>
                    <% } %>

                    <button type="button" 
                            onclick="promptDeleteSeller('<%= s._id %>', '<%= (s.username || '').replace(/'/g, "\\'") %>')" 
                            class="w-8 h-8 rounded-xl bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 flex items-center justify-center transition-colors cursor-pointer" 
                            title="إلغاء التوثيق وحذف البائع">
                      <span class="material-symbols-outlined text-base">delete</span>
                    </button>
                  </div>
                </div>

                <!-- تفاصيل المخالفات المسجلة (تنسدل عند النقر) -->
                <% if (vCount > 0) { %>
                  <div id="viol-box-<%= idx %>" class="hidden mt-3 pt-3 border-t border-slate-100 space-y-2">
                    <div class="text-[11px] font-extrabold text-rose-700 mb-1 flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-sm">warning</span>
                      <span>تفاصيل المخالفات المسجلة بحق التاجر:</span>
                    </div>

                    <% s.violations.forEach(v => { %>
                      <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                        
                        <div class="space-y-1 flex-1">
                          <div class="flex items-center gap-2 flex-wrap">
                            <span class="px-2 py-0.2 rounded-md text-[10px] font-black <%= v.severity === 'مخالفة جسيمة' ? 'bg-red-100 text-red-800 border border-red-200' : (v.severity === 'مخالفة متوسطة' ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-rose-50 text-rose-700 border border-rose-200') %>">
                              <%= v.severity %>
                            </span>
                            <span class="text-[10px] text-slate-400 font-mono" dir="ltr">
                              <%= new Date(v.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </span>
                          </div>
                          <p class="text-xs font-semibold text-slate-800 leading-relaxed">
                            <%= v.reason %>
                          </p>
                        </div>

                        <div class="flex items-center gap-2.5 sm:border-r sm:pr-3 sm:border-slate-200 shrink-0">
                          <div class="text-right">
                            <span class="text-[9px] text-slate-400 font-bold block">المشرف:</span>
                            <strong class="text-xs font-black text-slate-800 block">@<%= v.adminName || v.issuedBy || (user && (user.global_name || user.username)) || 'إداري' %></strong>
                          </div>
                          <img src="<%= v.adminAvatar || (user && user.avatar) || '/logo.png' %>" alt="Admin" class="w-7 h-7 rounded-full object-cover border border-slate-200" onerror="this.src='/logo.png'">

                          <button type="button" 
                                  onclick="promptDeleteViolation('<%= s._id %>', '<%= v._id %>')" 
                                  class="w-7 h-7 rounded-lg bg-white hover:bg-rose-600 text-rose-600 hover:text-white border border-rose-200 text-xs font-bold transition-all flex items-center justify-center cursor-pointer mr-1" 
                                  title="حذف هذه المخالفة">
                            <span class="material-symbols-outlined text-sm">delete</span>
                          </button>
                        </div>

                      </div>
                    <% }) %>
                  </div>
                <% } %>

              </div>
            <% }) %>
          </div>

          <div id="noSellerSearchResults" class="hidden py-16 text-center bg-white border border-slate-200 rounded-2xl">
            <div class="w-12 h-12 rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-2xl">person_search</span>
            </div>
            <h4 class="text-sm font-extrabold text-slate-800">لا توجد نتائج مطابقة لبحثك</h4>
            <p class="text-xs text-slate-400 mt-1">تأكد من كتابة اسم البائع أو الآيدي بالشكل الصحيح</p>
          </div>
        <% } %>

      </div>

    </div>
  </main>

  <!-- نافذة تأكيد الحذف الإدارية -->
  <div class="admin-modal" id="confirmDeleteModal">
    <div class="modal-card text-center">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center mx-auto mb-3">
        <span class="material-symbols-outlined text-2xl">warning</span>
      </div>

      <h3 class="text-base font-black text-slate-900 mb-1" id="confirmModalTitle">تأكيد عملية الحذف</h3>
      <p class="text-xs text-slate-500 mb-5 leading-relaxed" id="confirmModalDesc">هل أنت متأكد من المتابعة؟ لا يمكن التراجع عن هذا الإجراء</p>

      <form id="confirmActionForm" method="POST" class="m-0">
        <input type="hidden" name="sellerId" id="confirmInputSellerId">
        <input type="hidden" name="violationId" id="confirmInputViolationId">

        <div class="flex items-center gap-2.5">
          <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition-colors cursor-pointer border-none shadow-2xs">
            تأكيد الحذف
          </button>
          <button type="button" onclick="closeConfirmModal()" class="py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer border border-slate-200">
            إلغاء
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    function toggleViolationsList(boxId, arrowId) {
      const box = document.getElementById(boxId);
      const arrow = document.getElementById(arrowId);
      if (!box || !arrow) return;

      const isHidden = box.classList.toggle('hidden');
      arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    const searchInput = document.getElementById('sellerSearchInput');
    const clearSearchBtn = document.getElementById('clearSellerSearchBtn');
    const sellerCards = document.querySelectorAll('.seller-card');
    const sellersContainer = document.getElementById('sellersContainer');
    const noResultsBox = document.getElementById('noSellerSearchResults');
    const countEl = document.getElementById('sellersVisibleCount');

    function filterSellers() {
      const query = (searchInput.value || '').toLowerCase().trim();
      if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', query.length === 0);

      let visibleCount = 0;

      sellerCards.forEach(card => {
        const searchTarget = (card.getAttribute('data-search') || '').toLowerCase();
        if (!query || searchTarget.includes(query)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (sellersContainer) {
        sellersContainer.style.display = visibleCount === 0 ? 'none' : '';
      }

      if (noResultsBox) {
        noResultsBox.classList.toggle('hidden', visibleCount > 0);
      }

      if (countEl) {
        countEl.innerText = visibleCount;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterSellers);
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterSellers();
        searchInput.focus();
      });
    }

    const confirmModal = document.getElementById('confirmDeleteModal');
    const confirmForm = document.getElementById('confirmActionForm');
    const confirmTitle = document.getElementById('confirmModalTitle');
    const confirmDesc = document.getElementById('confirmModalDesc');
    const inputSellerId = document.getElementById('confirmInputSellerId');
    const inputViolationId = document.getElementById('confirmInputViolationId');

    if (confirmModal) {
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) closeConfirmModal();
      });
    }

    function closeConfirmModal() {
      if (confirmModal) confirmModal.classList.remove('show');
    }

    function promptDeleteSeller(sellerId, sellerName) {
      confirmForm.action = '/admin/sellers/delete';
      inputSellerId.value = sellerId;
      inputViolationId.value = '';
      confirmTitle.innerText = 'حذف البائع نهائياً';
      confirmDesc.innerHTML = `هل أنت متأكد من حذف البائع <strong>"${sellerName}"</strong> وإلغاء توثيقه بالكامل؟`;
      confirmModal.classList.add('show');
    }

    function promptDeleteViolation(sellerId, violationId) {
      confirmForm.action = '/admin/violations/delete';
      inputSellerId.value = sellerId;
      inputViolationId.value = violationId;
      confirmTitle.innerText = 'حذف المخالفة';
      confirmDesc.innerText = 'هل أنت متأكد من مسح هذه المخالفة من سجل التاجر نهائياً؟';
      confirmModal.classList.add('show');
    }
  </script>
</body>
</html>