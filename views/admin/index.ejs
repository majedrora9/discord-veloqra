<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - لوحة التحكم</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .admin-hub-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.5rem;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.4rem;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .admin-hub-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-4px);
      box-shadow: 0 16px 32px -8px rgba(10, 18, 44, 0.08);
    }

    .hub-icon {
      display: inline-block;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .admin-hub-card:hover .hub-icon {
      transform: scale(1.18) rotate(-6deg);
    }
  </style>
</head>
<body class="loading-active bg-white text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <header class="w-full relative z-30 bg-white pt-6">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between py-3.5 px-5 sm:px-6 rounded-2xl bg-white border border-slate-200 shadow-[0_4px_20px_-2px_rgba(10,18,44,0.05)]">
        
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-[#0a122c] text-sm sm:text-base tracking-tight">فيلوكرا</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5 pl-1 pr-3 py-1 rounded-xl bg-slate-50 border border-slate-200/80">
            <span class="text-xs font-extrabold text-slate-800 truncate max-w-[110px] sm:max-w-[160px]">
              <%= user ? (user.global_name || user.username) : 'المشرف' %>
            </span>
            <img src="<%= (user && user.avatar) ? user.avatar : '/logo.png' %>" class="w-7 h-7 rounded-lg object-cover border border-slate-200 bg-white" alt="Avatar" onerror="this.src='/logo.png'">
          </div>

          <a href="/logout" title="تسجيل الخروج" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-rose-50 hover:bg-rose-600 border border-rose-200 hover:border-rose-600 text-rose-600 hover:text-white text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-base">logout</span>
          </a>
        </div>

      </div>
    </nav>
  </header>

  <main class="w-full relative flex-1 bg-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
         إدارة فيلوكرا
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base mt-2">
         لوحة التحكم الرئيسية وإدارة مجتمع ومنصة فيلوكرا
        </p>
      </div>

      <!-- إحصائيات عامة للمنصة متوافقة مع كائنات stats القادمة من السيرفر -->
      <div class="mb-10 p-5 sm:p-6 rounded-2xl bg-slate-50/70 border border-slate-200/90 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 font-mono"><%= typeof stats !== 'undefined' ? stats.sellersCount : 0 %></div>
          <div class="text-xs text-slate-500 mt-1 font-bold">البائعين المعتمدين</div>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 font-mono"><%= typeof stats !== 'undefined' ? stats.usersCount : 0 %></div>
          <div class="text-xs text-slate-500 mt-1 font-bold">أعضاء المجتمع</div>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-purple-600 font-mono"><%= typeof stats !== 'undefined' ? stats.badgesCount : 0 %></div>
          <div class="text-xs text-slate-500 mt-1 font-bold">الشارات النشطة</div>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200/60 shadow-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-cyan-600 font-mono"><%= typeof stats !== 'undefined' ? stats.jobsCount : 0 %></div>
          <div class="text-xs text-slate-500 mt-1 font-bold">الوظائف الشاغرة</div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 1. إدارة الطلبات (متاحة لكل فريق الستاف) -->
        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">fact_check</span>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">إدارة الطلبات</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
             مراجعة وقبول أو رفض طلبات الإعلانات، المنتجات، والعمليات الواردة للمنصة
            </p>
          </div>
          <div>
            <a href="/admin/requests" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <!-- 2. إدارة البائعين والمخالفات (تعتمد على isMasterAdmin المحسوبة في السيرفر) -->
        <% if (isMasterAdmin) { %>
        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">storefront</span>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span>المعتمدين:</span>
                <span class="font-mono"><%= typeof stats !== 'undefined' ? stats.sellersCount : 0 %></span>
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">إدارة البائعين</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
             إدارة حسابات البائعين وتوثيقهم وعرض أرصدتهم وتسجيل أو حذف المخالفات
            </p>
          </div>
          <div>
            <a href="/admin/violations" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 text-orange-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">monetization_on</span>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">ادارة الارصدة</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
            قم باضافة او حذف ارصدة من مستخدم ما
            </p>
          </div>
          <div>
            <a href="/admin/wallets" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <% } %>

        <% if (isMasterAdmin) { %>

        <!-- 3. إدارة الشارات -->
        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">verified</span>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">إدارة الشارات</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
             منح وسحب وإنشاء أو حذف الشارات وتخصيصها للأعضاء
            </p>
          </div>
          <div>
            <a href="/admin/badges" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <!-- 4. إدارة الأعمال والوظائف -->
        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-cyan-50 border border-cyan-100 text-cyan-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">work</span>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">إدارة الأعمال</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
             قبول أو رفض المتقدمين للإدارة، مراجعة طلباتهم، وتحديد فترات التقديم
            </p>
          </div>
          <div>
            <a href="/admin/jobs" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <!-- 5. تخصيص بروفايلات الأعضاء -->
        <div class="admin-hub-card">
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-violet-50 border border-violet-100 text-violet-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl hub-icon">palette</span>
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1.5 tracking-tight">تخصيص بروفايلات الأعضاء</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
             تعديل أشكال صفحات الأعضاء، تفعيل الروابط المخصصة (Slug)، وتطبيق تصاميم ومؤثرات CSS
            </p>
          </div>
          <div>
            <a href="/admin/users-custom" class="group inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm">
              <span>الانتقال</span>
              <span class="material-symbols-outlined text-base transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
            </a>
          </div>
        </div>

        <% } %>

      </div>

    </div>
  </main>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>