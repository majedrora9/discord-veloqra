<header class="w-full relative z-30 bg-white pt-6">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between py-3.5 px-5 sm:px-6 rounded-2xl bg-white border border-slate-200 shadow-[0_4px_20px_-2px_rgba(10,18,44,0.05)]">
      
      <div class="flex items-center gap-3">
        <% if (typeof isSubPage !== 'undefined' && isSubPage) { %>
          <a href="/admin" class="group inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0a122c] hover:bg-[#ffd000] border border-[#0a122c] hover:border-[#ffd000] text-white hover:text-[#0a122c] text-xs font-bold transition-all shadow-sm">
            <span class="material-symbols-outlined text-base transition-transform duration-300 group-hover:translate-x-1">east</span>
            <span>العودة</span>
          </a>
        <% } else { %>
          <a href="/" class="group inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-50 hover:bg-[#0a122c] border border-slate-200 hover:border-[#0a122c] text-slate-700 hover:text-white text-xs font-bold transition-all">
            <span class="material-symbols-outlined text-base transition-transform duration-300 group-hover:translate-x-1">east</span>
            <span>العودة</span>
          </a>
        <% } %>

        <div class="h-5 w-px bg-slate-200 hidden sm:block"></div>

        <a href="/admin" class="flex items-center gap-2">
          <span class="font-extrabold text-[#0a122c] text-sm sm:text-base tracking-tight">
            <%= typeof pageTitle !== 'undefined' ? pageTitle : 'إدارة فيلوكرا' %>
          </span>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2.5 pl-1 pr-3 py-1 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="text-xs font-extrabold text-slate-800 truncate max-w-[110px] sm:max-w-[160px]">
            <%= (typeof user !== 'undefined' && user) ? (user.global_name || user.username) : 'المشرف' %>
          </span>
          <img src="<%= (typeof user !== 'undefined' && user && user.avatar) ? user.avatar : '/logo.png' %>" class="w-7 h-7 rounded-lg object-cover border border-slate-200 bg-white" alt="Avatar" onerror="this.src='/logo.png'">
        </div>

        <a href="/logout" title="تسجيل الخروج" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-rose-50 hover:bg-rose-600 border border-rose-200 hover:border-rose-600 text-rose-600 hover:text-white text-xs font-bold transition-all">
          <span class="material-symbols-outlined text-base">logout</span>
        </a>
      </div>

    </div>
  </nav>
</header>