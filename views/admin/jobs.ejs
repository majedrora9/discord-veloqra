<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - إدارة الاعمال</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/main.css">

  <style>
    .admin-modal {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 44, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      padding: 1.5rem;
    }

    .admin-modal.show {
      display: flex !important;
    }

    .modal-card {
      width: 100%;
      border-radius: 24px;
      padding: 2rem;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      box-shadow: 0 25px 60px rgba(10, 18, 44, 0.25);
    }

    .custom-inner-scroll::-webkit-scrollbar {
      width: 5px;
    }
    .custom-inner-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-inner-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-inner-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .job-admin-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 1.5rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .job-admin-card:hover {
      border-color: #cbd5e1;
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -8px rgba(10, 18, 44, 0.07);
    }
  </style>
</head>
<body class="loading-active bg-white text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <%- include('partials/header', { isSubPage: true, pageTitle: 'إدارة الاعمال' }) %>

  <main class="w-full relative flex-1 bg-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">

      <div class="text-center max-w-2xl mx-auto mb-6">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          ادارة الاعمال
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm md:text-base mt-2">
          التحكم بحالة شواغر فريق فيلوكرا وفرز طلبات الانضمام واتخاذ القرارات الإدارية
        </p>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <div class="relative flex-1">
          <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none">search</span>
          <input 
            type="text" 
            id="jobSearchInput" 
            placeholder="ابحث باسم الوظيفة أو تفاصيلها..." 
            class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#0a122c] transition-colors shadow-sm"
          >
          <button type="button" id="clearJobSearchBtn" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">
            <span class="material-symbols-outlined text-base">close</span>
          </button>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <select id="jobStatusFilter" onchange="filterJobCards()" class="px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 focus:outline-none focus:border-[#0a122c] cursor-pointer w-full sm:w-auto shadow-sm">
            <option value="all">جميع الوظائف</option>
            <option value="open">الوظائف المفتوحة</option>
            <option value="closed">الوظائف المغلقة</option>
          </select>

          <span class="px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold whitespace-nowrap shadow-sm">
            المعروض: <span class="font-mono text-blue-600 font-extrabold" id="jobVisibleCount"><%= (jobs && jobs.length) || 0 %></span>
          </span>
        </div>
      </div>

      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="jobsGridContainer">
          <% (jobs || []).forEach(job => { %>
            <% const pendingCount = (job.applications || []).filter(a => a.status === 'pending').length; %>
            <% const jobDescriptionText = job.description || job.desc || ''; %>
            <div class="job-admin-card"
                 data-search="<%= job.title %> <%= jobDescriptionText %>"
                 data-status="<%= job.status %>">
              
              <div>
                <div class="flex items-start justify-between gap-3 mb-3 pb-3.5 border-b border-slate-100">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-2xl"><%= job.icon || 'work' %></span>
                    </div>
                    <div class="min-w-0">
                      <h3 class="font-extrabold text-slate-900 text-base leading-tight truncate"><%= job.title %></h3>
                      <% if (job.department) { %>
                        <span class="text-[11px] text-slate-400 font-bold block mt-0.5"><%= job.department %></span>
                      <% } %>
                    </div>
                  </div>

                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold shrink-0 <%= job.status === 'open' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-600 border border-slate-200' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= job.status === 'open' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400' %>"></span>
                    <span><%= job.status === 'open' ? 'مفتوحة' : 'مغلقة' %></span>
                  </span>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mb-4">
                  <%= jobDescriptionText %>
                </p>

                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between text-xs">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-base text-slate-500">group</span>
                    <span class="text-slate-600 font-bold">المتقدمين:</span>
                    <strong class="font-mono text-slate-900 text-sm"><%= (job.applications && job.applications.length) || 0 %></strong>
                  </div>
                  <% if (pendingCount > 0) { %>
                    <span class="px-2.5 py-0.5 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-[11px] font-bold">
                      <%= pendingCount %> معلق
                    </span>
                  <% } else { %>
                    <span class="text-[11px] text-slate-400 font-semibold">0 معلق</span>
                  <% } %>
                </div>
              </div>

              <div class="flex items-center gap-2 pt-3.5 border-t border-slate-100">
                <button 
                  type="button" 
                  onclick='openApplicantsModal(<%- JSON.stringify(job).replace(/'/g, "&apos;") %>)'
                  class="flex-1 py-2.5 px-3 rounded-xl bg-slate-50 hover:bg-[#ffd000] border border-slate-200 hover:border-[#ffd000] text-slate-700 hover:text-[#0a122c] font-bold text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm"
                >
                  <span class="material-symbols-outlined text-base">visibility</span>
                  <span>عرض التقديمات</span>
                </button>

                <form action="/admin/jobs/toggle-status" method="POST" class="m-0 shrink-0">
                  <input type="hidden" name="jobId" value="<%= job._id %>">
                  <input type="hidden" name="status" value="<%= job.status === 'open' ? 'closed' : 'open' %>">
                  <button 
                    type="submit" 
                    class="py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center gap-1 cursor-pointer border <%= job.status === 'open' ? 'bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white border-rose-200 hover:border-rose-600' : 'bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border-emerald-200 hover:border-emerald-600' %>"
                    title="<%= job.status === 'open' ? 'إغلاق التقديم' : 'فتح التقديم للجميع' %>"
                  >
                    <span class="material-symbols-outlined text-base"><%= job.status === 'open' ? 'lock' : 'lock_open' %></span>
                    <span><%= job.status === 'open' ? 'إغلاق' : 'فتح' %></span>
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        </div>

        <div id="noJobSearchResults" class="hidden py-16 px-4 rounded-2xl bg-slate-50 border border-slate-200 text-center">
          <div class="w-14 h-14 rounded-2xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-3 shadow-sm">
            <span class="material-symbols-outlined text-3xl">work_off</span>
          </div>
          <h4 class="text-sm font-extrabold text-slate-800">لا توجد وظائف مطابقة لبحثك</h4>
          <p class="text-xs text-slate-500 mt-1">تأكد من كتابة اسم الوظيفة أو تغيير الفلتر المحدد</p>
        </div>
      </div>

    </div>
  </main>

  <div class="admin-modal" id="applicantsModal" onclick="if(event.target===this) closeApplicantsModal()">
    <div class="modal-card max-w-2xl flex flex-col max-h-[85vh]">
      
      <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-slate-100 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl" id="modalJobIcon">badge</span>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900 m-0" id="modalJobHeading">المتقدمين للوظيفة</h3>
            <span class="text-xs font-mono text-slate-400 block mt-0.5" id="modalJobSub"></span>
          </div>
        </div>
        <button type="button" onclick="closeApplicantsModal()" class="text-slate-400 hover:text-slate-600 border-none bg-transparent cursor-pointer flex items-center">
          <span class="material-symbols-outlined text-2xl">close</span>
        </button>
      </div>

      <div id="applicantsList" class="flex-1 overflow-y-auto space-y-3.5 pr-1 pl-1 custom-inner-scroll"></div>

      <div class="mt-4 pt-3.5 border-t border-slate-100 shrink-0">
        <button type="button" onclick="closeApplicantsModal()" class="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs cursor-pointer border border-slate-200 transition-colors">
          إغلاق النافذة
        </button>
      </div>
    </div>
  </div>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    const appModal = document.getElementById('applicantsModal');
    const modalHeading = document.getElementById('modalJobHeading');
    const modalSub = document.getElementById('modalJobSub');
    const modalIcon = document.getElementById('modalJobIcon');
    const listContainer = document.getElementById('applicantsList');
    const searchInput = document.getElementById('jobSearchInput');
    const clearSearchBtn = document.getElementById('clearJobSearchBtn');
    const statusFilter = document.getElementById('jobStatusFilter');
    const gridContainer = document.getElementById('jobsGridContainer');
    const noResultsBox = document.getElementById('noJobSearchResults');
    const countEl = document.getElementById('jobVisibleCount');

    function openApplicantsModal(job) {
      modalHeading.textContent = `${job.title}`;
      modalSub.textContent = `إجمالي الطلبات المستلمة (${(job.applications || []).length})`;
      modalIcon.textContent = job.icon || 'badge';

      if (!job.applications || job.applications.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-12">
            <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-2.5">
              <span class="material-symbols-outlined text-3xl">person_off</span>
            </div>
            <p class="text-slate-500 text-xs font-bold">لا توجد طلبات تقديم مسجلة لهذه الوظيفة حالياً</p>
          </div>
        `;
      } else {
        listContainer.innerHTML = job.applications.slice().reverse().map(app => {
          const statusBadge = app.status === 'accepted' 
            ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold"><span class="material-symbols-outlined text-xs">check_circle</span> مقبول</span>`
            : app.status === 'rejected'
            ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-50 border border-rose-200 text-rose-700 text-[11px] font-bold"><span class="material-symbols-outlined text-xs">cancel</span> مرفوض</span>`
            : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-[11px] font-bold"><span class="material-symbols-outlined text-xs">schedule</span> قيد المراجعة</span>`;

          const dt = new Date(app.appliedAt);
          const dateStr = `${String(dt.getDate()).padStart(2,'0')}/${String(dt.getMonth()+1).padStart(2,'0')}/${dt.getFullYear()}`;

          // قراءة البيانات بمرونة تدعم كافة التسميات القديمة والجديدة
          const candidateName = app.fullName || app.applicantName || app.username || 'متقدم';
          const candidateAge = (app.age !== undefined && app.age !== null && app.age !== '') ? app.age : (app.applicantAge || '-');

          return `
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
              <div class="flex items-start justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-3">
                  <img src="${app.avatar || '/logo.png'}" class="w-10 h-10 rounded-xl object-cover border border-slate-200 bg-white" onerror="this.src='/logo.png'">
                  <div>
                    <div class="flex items-center gap-2">
                      <h4 class="font-extrabold text-slate-900 text-sm">${candidateName}</h4>
                      <span class="text-slate-500 text-xs">(العمر: <strong class="text-slate-700 font-mono">${candidateAge}</strong>)</span>
                    </div>
                    <div class="text-[11px] text-slate-400 font-mono mt-0.5 flex items-center gap-2">
                      <span>@${app.username || 'user'}</span>
                      <span>•</span>
                      <span>ID: ${app.userId || '-'}</span>
                      <span>•</span>
                      <span>${dateStr}</span>
                    </div>
                  </div>
                </div>
                <div>${statusBadge}</div>
              </div>

              <div class="p-3.5 rounded-xl bg-white border border-slate-200 text-xs text-slate-700 leading-relaxed">
                <span class="text-[10px] font-bold text-slate-400 block mb-1">الخبرات والمهارات السابقة:</span>
                <p class="whitespace-pre-line m-0 text-slate-600 font-medium">${app.experience || 'غير محددة'}</p>
                ${app.reason ? `<div class="mt-2 pt-2 border-t border-slate-100"><span class="text-[10px] font-bold text-slate-400 block mb-0.5">سبب الرغبة بالانضمام:</span><p class="m-0 text-slate-600 font-medium">${app.reason}</p></div>` : ''}
                ${app.portfolio ? `<div class="mt-2 pt-1"><a href="${app.portfolio}" target="_blank" class="inline-flex items-center gap-1 text-blue-600 hover:underline font-mono text-[11px]"><span class="material-symbols-outlined text-xs">link</span> <span>رابط معرض الأعمال</span></a></div>` : ''}
              </div>

              <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200/80">
                <form action="/admin/jobs/application-action" method="POST" class="m-0">
                  <input type="hidden" name="jobId" value="${job._id}">
                  <input type="hidden" name="appId" value="${app._id}">
                  <input type="hidden" name="action" value="accepted">
                  <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-1 cursor-pointer border-none shadow-sm transition-colors">
                    <span class="material-symbols-outlined text-sm">check</span>
                    <span>قبول</span>
                  </button>
                </form>

                <form action="/admin/jobs/application-action" method="POST" class="m-0">
                  <input type="hidden" name="jobId" value="${job._id}">
                  <input type="hidden" name="appId" value="${app._id}">
                  <input type="hidden" name="action" value="rejected">
                  <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold flex items-center gap-1 cursor-pointer border-none transition-colors">
                    <span class="material-symbols-outlined text-sm">close</span>
                    <span>رفض</span>
                  </button>
                </form>

                <form action="/admin/jobs/application-action" method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا التقديم نهائياً؟')">
                  <input type="hidden" name="jobId" value="${job._id}">
                  <input type="hidden" name="appId" value="${app._id}">
                  <input type="hidden" name="action" value="delete">
                  <button type="submit" class="p-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold flex items-center justify-center cursor-pointer border border-rose-200 transition-colors" title="حذف التقديم">
                    <span class="material-symbols-outlined text-base">delete</span>
                  </button>
                </form>
              </div>
            </div>
          `;
        }).join('');
      }

      appModal.classList.add('show');
    }

    function closeApplicantsModal() {
      appModal.classList.remove('show');
    }

    function filterJobCards() {
      const query = (searchInput.value || '').toLowerCase().trim();
      const statusVal = statusFilter.value;
      const cards = document.querySelectorAll('.job-admin-card');
      if (clearSearchBtn) clearSearchBtn.classList.toggle('hidden', query.length === 0);

      let visibleCount = 0;

      cards.forEach(card => {
        const searchTarget = (card.getAttribute('data-search') || '').toLowerCase();
        const cardStatus = card.getAttribute('data-status');

        const matchesQuery = !query || searchTarget.includes(query);
        const matchesStatus = (statusVal === 'all') || (cardStatus === statusVal);

        if (matchesQuery && matchesStatus) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (gridContainer) {
        gridContainer.style.display = visibleCount === 0 ? 'none' : '';
      }

      if (noResultsBox) {
        noResultsBox.classList.toggle('hidden', visibleCount > 0);
      }

      if (countEl) {
        countEl.innerText = visibleCount;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterJobCards);
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterJobCards();
        searchInput.focus();
      });
    }
  </script>
</body>
</html>