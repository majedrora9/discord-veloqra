<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - دليل الدعم الفني </title>
  
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Veloqra">
  <meta property="og:title" content="Veloqra - دليل الدعم الفني">
  <meta property="og:description" content="اسئلة واجوابة المستخدمين مع النسخ المباشر">
  <meta property="og:image" content="/logo.png">

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              navy: '#0a122c',
              yellow: '#ffd000',
              blue: '#4287f5'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/main.css">

  <style>
    .page-clean-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }
    .page-clean-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.9) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }
    .page-clean-header nav span, .page-clean-header nav a {
      color: #0a122c !important;
    }
    .page-clean-header nav .hidden.md\:flex a:hover { color: #4287f5 !important; }
    .page-clean-header nav .hidden.md\:block a {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }

    .clean-box {
      background: #ffffff;
      border: 1px solid #eef2f6;
      border-radius: 1.5rem;
      padding: 1.5rem;
      box-shadow: 0 1px 3px rgba(10, 18, 44, 0.04);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      scroll-margin-top: 6rem;
    }
    .clean-box:hover {
      border-color: #cbd5e1;
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -6px rgba(10, 18, 44, 0.07);
    }
    
    /* توهج الكرت عند الوصول عبر الرابط المباشر */
    .clean-box.target-glow {
      border-color: #ffd000 !important;
      box-shadow: 0 0 0 3px rgba(255, 208, 0, 0.35), 0 16px 32px -8px rgba(10, 18, 44, 0.12) !important;
      animation: pulseGlow 2.5s ease-out;
    }

    @keyframes pulseGlow {
      0% { transform: scale(1.02); }
      50% { transform: scale(1); }
      100% { transform: scale(1); }
    }

    .filter-tab {
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .filter-tab.active {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }
    .filter-tab.active span.count-badge {
      background: rgba(255, 255, 255, 0.2) !important;
      color: #ffffff !important;
      border-color: transparent !important;
    }
    #appToast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(140%);
      padding: 0.85rem 1.5rem;
      border-radius: 1.25rem;
      font-size: 0.85rem;
      font-weight: 700;
      z-index: 999999;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #appToast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body class="loading-active bg-slate-50/50 text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white"><div class="simple-spinner"></div></div>

  <!-- توست الإشعار -->
  <div id="appToast" class="flex items-center gap-2.5 shadow-2xl border bg-[#0a122c] text-white border-slate-700">
    <span class="material-symbols-outlined text-lg text-[#ffd000]" id="toastIcon">check_circle</span>
    <span id="toastMsg">تمت العملية بنجاح!</span>
  </div>

  <header class="page-clean-header w-full relative z-30">
    <%- include('../partials/header') %>
  </header>

  <main class="w-full relative flex-1 py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">

      <!-- ترويسة الصفحة -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2.5">
            <span class="w-2.5 h-7 rounded-full bg-blue-600 inline-block"></span>
            <span>دليل الدعم الفني </span>
          </h1>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
           شرح المشكلة ومعرفة ردها تجدها هُنا مع امكانية نسخ الرد
          </p>
        </div>

      </div>


      
      <!-- البحث والفلترة -->
      <div class="p-3 rounded-2xl bg-white border border-slate-200 shadow-2xs flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        <div class="relative flex-1">
          <span class="material-symbols-outlined text-slate-400 text-lg absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none">search</span>
          <input 
            type="text" 
            id="faqSearchInput" 
            oninput="handleFaqSearch()"
            placeholder="بحث بموضوع السؤال أو تعليمات المشرف..."
            class="w-full pr-10 pl-9 py-2.5 rounded-xl bg-slate-50/70 border border-transparent focus:border-blue-500 focus:bg-white focus:outline-none text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 transition-all"
          >
          <button type="button" id="clearFaqSearchBtn" onclick="clearSearch()" class="hidden absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">
            <span class="material-symbols-outlined text-base">close</span>
          </button>
        </div>

        <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 shrink-0">
          <button type="button" onclick="setCategory('all')" id="tab-all" class="filter-tab active px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/70 text-slate-700 text-xs font-bold flex items-center gap-1.5 whitespace-nowrap">
            <span>الكل</span>
            <span class="count-badge px-1.5 py-0.2 rounded-md bg-white border border-slate-200 font-mono text-[10px]" id="count-all">0</span>
          </button>

          <button type="button" onclick="setCategory('charge')" id="tab-charge" class="filter-tab px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/70 text-slate-700 text-xs font-bold flex items-center gap-1.5 whitespace-nowrap">
            <span>شحن ورصيد</span>
            <span class="count-badge px-1.5 py-0.2 rounded-md bg-white border border-slate-200 font-mono text-[10px]" id="count-charge">0</span>
          </button>

          <button type="button" onclick="setCategory('store')" id="tab-store" class="filter-tab px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/70 text-slate-700 text-xs font-bold flex items-center gap-1.5 whitespace-nowrap">
            <span>المتجر والوساطة</span>
            <span class="count-badge px-1.5 py-0.2 rounded-md bg-white border border-slate-200 font-mono text-[10px]" id="count-store">0</span>
          </button>

          <button type="button" onclick="setCategory('account')" id="tab-account" class="filter-tab px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/70 text-slate-700 text-xs font-bold flex items-center gap-1.5 whitespace-nowrap">
            <span>الحسابات والتوثيق</span>
            <span class="count-badge px-1.5 py-0.2 rounded-md bg-white border border-slate-200 font-mono text-[10px]" id="count-account">0</span>
          </button>
        </div>
      </div>

      <!-- شبكة الكروت -->
      <div id="faqGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>

      <!-- حالة لا توجد نتائج -->
      <div id="noResultsState" class="hidden py-16 text-center">
        <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
          <span class="material-symbols-outlined text-2xl">search_off</span>
        </div>
        <h3 class="text-sm font-extrabold text-slate-800">لا توجد ردود مطابقة للبحث</h3>
        <p class="text-xs text-slate-400 mt-1">جرّب كتابة كلمات بحث أخرى أو تغيير التبويب المختار</p>
      </div>

    </div>
  </main>

  <div class="w-full mt-auto">
    <%- include('../partials/footer') %>
  </div>

  <script src="/js/script.js"></script>
  <script>
    // ========================================================== //
    // مصفوفة الأسئلة (عدّل أو أضف أي عنصر بكل سهولة)              //
    // ========================================================== //
    const FAQ_ITEMS = [
      {
        category: "charge",
        badge: "شحن  ورصيد",
        question: "س: شحنت رصيد فيلو كوين وللأن ماوصل",
        adminNote: "تحقق من مسؤول الطلبات عن وجود طلب لم يتم تنفيذه، وبعدها عد الى المستخدم للرد عليه وتحقق من وقت الحوالة إذا لم تمضي 48 ساعة فلا يوجد مشكلة أما بعد فهناك مشكلة",
        reply: `يأخذ عادة رصيد فيلو كوين للتحقق 48 ساعة، لانه يمر بعدة حالات توثيق منها مصدر العملة وقيمتها والمبلغ الكامل إن تم تسديده أم لا، ولذلك تستغرق وقت ومدة اقصاها 48 ساعة ولا تصل حتى لهذه المدة ربما خلال دقائق معدودة`
      },
      {
        category: "charge",
        badge: "شحن  ورصيد",
        question: "س: هل ممكن تضيفون العملة التالية للمتجر",
        adminNote: "تأكد من العملة إن كانت موجودة ضمن المتجر أم لا، اذا موجود فالرد بالوجود وإن لا فالرد بنسخ النص أدناه بعد التأكد من صحة العملة ودولتها ورفع الطلب الى المبرمجين بعدها",
        reply: `تم ارسال طلبك حالياً الى الادارة وهو قيد المعالجة وان تم قبوله ستضاف العملة مباشرة الى الموقع وتجدها هناك دون اعلامك مسبقاً وان تم رفضه فـ العملة لن تضاف الى الموقع خلال 48 ساعة`
      }
    ];

    let currentCategory = 'all';

    function showToast(msg, iconName = 'check_circle') {
      const toast = document.getElementById('appToast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.textContent = msg;
      toastIcon.textContent = iconName;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }

    // نسخ نص الرد المخصص للزبون
    function copyToClipboard(index) {
      const item = FAQ_ITEMS[index];
      if (!item) return;

      navigator.clipboard.writeText(item.reply).then(() => {
        showToast('تم نسخ قالب الرد الجاهز إلى الحافظة بنجاح!', 'content_copy');
      }).catch(() => {
        showToast('تعذر النسخ، يرجى المحاولة يدوياً');
      });
    }

    // نسخ الرابط المباشر للوصول إلى هذا السؤال بالضبط
    function copyDirectLink(autoId) {
      const url = `${window.location.origin}${window.location.pathname}#${autoId}`;
      navigator.clipboard.writeText(url).then(() => {
        showToast(`تم نسخ رابط السؤال المباشر (#${autoId})`, 'link');
      }).catch(() => {
        showToast('تعذر نسخ الرابط');
      });
    }

    function renderFaqGrid() {
      const grid = document.getElementById('faqGrid');
      const query = (document.getElementById('faqSearchInput').value || '').trim().toLowerCase();
      const noResults = document.getElementById('noResultsState');

      let visibleCount = 0;
      grid.innerHTML = '';

      FAQ_ITEMS.forEach((item, index) => {
        const autoId = `FAQ-${String(index + 1).padStart(2, '0')}`;
        
        const matchesCategory = (currentCategory === 'all' || item.category === currentCategory);
        const searchText = `${autoId} ${item.question} ${item.adminNote} ${item.reply}`.toLowerCase();
        const matchesQuery = !query || searchText.includes(query);

        if (matchesCategory && matchesQuery) {
          visibleCount++;
          const card = document.createElement('div');
          card.className = 'clean-box';
          card.id = autoId;
          card.innerHTML = `
            <div class="space-y-3">
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200/80">
                  ${item.badge || 'دعم فني'}
                </span>
                
                <div class="flex items-center gap-1.5">
                  <span class="text-[11px] font-mono font-bold text-slate-400">#${autoId}</span>
                  <button type="button" onclick="copyDirectLink('${autoId}')" class="p-1 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-slate-100 transition-colors" title="نسخ رابط هذا السؤال">
                    <span class="material-symbols-outlined text-sm">link</span>
                  </button>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 border border-blue-200/70 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-base">support_agent</span>
                </div>
                <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 leading-snug">
                  ${item.question}
                </h3>
              </div>

              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 text-xs space-y-1">
                <span class="font-bold text-slate-700 block flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm text-blue-600">info</span> تعليمات المشرف:
                </span>
                <p class="text-slate-500 leading-relaxed text-[11px]">
                  ${item.adminNote}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button type="button" onclick="copyToClipboard(${index})" class="flex-1 py-2.5 px-4 rounded-xl bg-[#0a122c] hover:bg-blue-600 text-white font-bold text-xs flex items-center justify-center gap-2 transition-colors cursor-pointer border-none shadow-sm">
                <span class="material-symbols-outlined text-base text-[#ffd000]">content_copy</span>
                <span>نسخ الرد</span>
              </button>

            </div>
          `;
          grid.appendChild(card);
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    // فحص الرابط المباشر عند الفتح والتمرير للكارت المطلوب
    function checkHashTarget() {
      const hash = window.location.hash ? window.location.hash.substring(1) : '';
      if (!hash) return;

      setTimeout(() => {
        const targetEl = document.getElementById(hash);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetEl.classList.add('target-glow');
          setTimeout(() => targetEl.classList.remove('target-glow'), 3000);
        }
      }, 300);
    }

    function updateCounters() {
      document.getElementById('statTotalFaq').textContent = FAQ_ITEMS.length;
      document.getElementById('count-all').textContent = FAQ_ITEMS.length;
      document.getElementById('count-charge').textContent = FAQ_ITEMS.filter(i => i.category === 'charge').length;
      document.getElementById('count-store').textContent = FAQ_ITEMS.filter(i => i.category === 'store').length;
      document.getElementById('count-account').textContent = FAQ_ITEMS.filter(i => i.category === 'account').length;
    }

    function setCategory(cat) {
      currentCategory = cat;
      document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById('tab-' + cat);
      if (activeBtn) activeBtn.classList.add('active');
      renderFaqGrid();
    }

    function handleFaqSearch() {
      const q = document.getElementById('faqSearchInput').value.trim();
      const clearBtn = document.getElementById('clearFaqSearchBtn');
      if (clearBtn) clearBtn.classList.toggle('hidden', q.length === 0);
      renderFaqGrid();
    }

    function clearSearch() {
      const input = document.getElementById('faqSearchInput');
      input.value = '';
      document.getElementById('clearFaqSearchBtn').classList.add('hidden');
      renderFaqGrid();
      input.focus();
    }

    updateCounters();
    renderFaqGrid();
    checkHashTarget();
  </script>
</body>
</html>