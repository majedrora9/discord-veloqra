<% 
  // 1. مصفوفة الروابط الموحدة
  const navLinks = [
    { title: 'الرئيسية', url: '/' },
    { title: 'المتجر', url: '/store' },
    { title: 'القواعد والشروط', url: '/terms' }
  ];

  // 2. زر الحساب / الدخول الموحد بدون تكرار
  let authButtonHtml = '';
  if (typeof user !== 'undefined' && user) {
    authButtonHtml = `
      <a href="/profile" class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#eef1fb] hover:bg-slate-100 text-blue-600 border border-blue-100 font-bold text-xs shadow-xs transition-all w-full md:w-auto">
      <img src="${user.avatar || '/logo.png'}" 
     class="w-6 h-6 rounded-full object-cover shrink-0 block" 
     onerror="this.src='/logo.png'">
        <span>${user.global_name || user.username}</span>
      </a>
    `;
  } else {
    authButtonHtml = `
      <button type="button" onclick="openLoginModal()" class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white hover:bg-slate-100 text-blue-600 border border-blue-100 font-bold text-xs shadow-xs transition-all cursor-pointer w-full md:w-auto">
        <span class="material-symbols-outlined text-base text-blue-600">login</span>
        <span>تسجيل الدخول</span>
      </button>
    `;
  }
%>

<nav class="relative z-30 max-w-6xl mx-auto px-4 sm:px-6 mb-10 pt-4">
  <div class="dheader-container flex items-center justify-between py-3 px-5 sm:px-6 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md transition-all">
    
    <!-- الشعار -->
    <a href="/" class="flex items-center gap-2.5">
      <img src="/logo.png" alt="Veloqra" class="w-7 h-7 rounded-lg">
      <span class="dheader-title font-bold text-white text-base sm:text-lg tracking-tight">فيلوكرا</span>
    </a>

    <!-- روابط الديسكتوب -->
    <div class="dheader-links hidden md:flex items-center gap-7 text-sm font-medium text-white/90">
      <% navLinks.forEach(link => { %>
        <a href="<%= link.url %>" class="hover:text-[#EEF1FB] transition-colors"><%= link.title %></a>
      <% }) %>
    </div>

    <!-- زر الحساب للديسكتوب -->
    <div class="hidden md:flex items-center gap-3">
      <%- authButtonHtml %>
    </div>

    <!-- زر البرغر للموبايل -->
    <button id="burgerBtn" aria-label="القائمة" class="md:hidden flex items-center justify-center p-2 rounded-xl bg-white/10 border border-white/15 text-white focus:outline-none">
      <span id="burgerIcon" class="material-symbols-outlined text-2xl">menu</span>
    </button>

  </div>

  <!-- قائمة الموبايل المنسدلة -->
  <div id="mobileMenu" class="hidden md:hidden mt-2 p-5 rounded-2xl bg-[#0a122c]/95 border border-slate-700/60 backdrop-blur-xl shadow-2xl transition-all">
    <div class="flex flex-col gap-2 text-sm font-semibold text-white">
      <% navLinks.forEach(link => { %>
        <a href="<%= link.url %>" class="mobile-link py-2 px-3 hover:bg-[#EEF1FB]/10 rounded-xl transition-colors"><%= link.title %></a>
      <% }) %>
      
      <div class="pt-3 mt-1 border-t border-slate-700/60">
        <%- authButtonHtml %>
      </div>
    </div>
  </div>
</nav>

<!-- نافذة تسجيل الدخول المنبثقة (Modal) -->
<div id="loginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#0a122c]/65 backdrop-blur-sm p-4 transition-all">
  <div class="w-full max-w-md bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-2xl text-center relative animate-in fade-in zoom-in-95 duration-200">
    
    <button type="button" onclick="closeLoginModal()" class="absolute left-4 top-4 w-8 h-8 rounded-full bg-slate-50 hover:bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center border border-slate-200 cursor-pointer transition-colors">
      <span class="material-symbols-outlined text-lg">close</span>
    </button>

    <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-100 text-[#5865F2] flex items-center justify-center mx-auto mb-4">
      <span class="material-symbols-outlined text-3xl">login</span>
    </div>

    <h3 class="text-xl font-extrabold text-slate-900 mb-1.5">تسجيل الدخول</h3>
    <p class="text-slate-500 text-xs sm:text-sm mb-6 leading-relaxed px-2">
      سجل دخولك للوصول إلى مميزات المنصة وتوثيق حسابك (لا نحفظ أي معلومات تسجيل نهائياً)
    </p>

    <a href="/auth/discord" class="flex items-center justify-center gap-2.5 w-full py-3 px-5 rounded-xl bg-[#5865F2] hover:bg-[#4752c4] text-white font-bold text-xs sm:text-sm shadow-md shadow-[#5865F2]/20 transition-all">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 127.14 96.36">
        <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.91,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,45.91,96.12,53,91.08,65.69,84.69,65.69Z"/>
      </svg>
      <span>المتابعة باستخدام الديسكورد</span>
    </a>

    <div class="mt-5 text-[11px] text-slate-400">
      بتسجيلك أنت توافق على <a href="/terms" class="text-blue-600 hover:underline">قواعد وشروط المجتمع</a>
    </div>
  </div>
</div>