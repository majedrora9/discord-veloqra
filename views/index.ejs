<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth overflow-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - مجتمع وسيرفر ديسكورد</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Veloqra">
  <meta property="og:title" content="Veloqra Discord Community">
  <meta property="og:description" content="مجتمع تقني، متجر خدمات رقمية، ووسطاء معتمدين بأعلى معايير الأمان">
  <meta property="og:image" content="/logo.png">

  <!-- Google Fonts: IBM Plex Sans Arabic & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Outlined -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>

  <!-- ملف التنسيقات الخارجي الموحد -->
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="loading-active bg-slate-50 text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c]">

  <!-- لودر سادة أزرق بخلفية بيضاء -->
  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <!-- القسم العلوي (Hero Section) مع أيقونات الديسكورد العائمة -->
  <header class="relative hero-blue-gradient text-white overflow-hidden pt-6 pb-28 md:pb-40">
    
    <div class="floating-glass-icon float-1 w-10 h-10 md:w-11 md:h-11 top-24 left-[7%] md:left-[12%]">
      <span class="material-symbols-outlined text-lg md:text-xl">forum</span>
    </div>
    <div class="floating-glass-icon float-2 w-9 h-9 md:w-10 md:h-10 top-20 right-[8%] md:right-[14%]">
      <span class="material-symbols-outlined text-base md:text-lg">handshake</span>
    </div>
    <div class="floating-glass-icon float-3 w-10 h-10 md:w-11 md:h-11 top-1/2 left-[3%] md:left-[6%]">
      <span class="material-symbols-outlined text-lg md:text-xl">storefront</span>
    </div>
    <div class="floating-glass-icon float-4 w-9 h-9 md:w-10 md:h-10 top-1/2 right-[4%] md:right-[7%]">
      <span class="material-symbols-outlined text-base md:text-lg">security</span>
    </div>
    <div class="floating-glass-icon float-5 w-10 h-10 md:w-11 md:h-11 bottom-32 left-[9%] md:left-[15%]">
      <span class="material-symbols-outlined text-lg md:text-xl">stars</span>
    </div>
    <div class="floating-glass-icon float-6 w-9 h-9 md:w-10 md:h-10 bottom-28 right-[10%] md:right-[17%]">
      <span class="material-symbols-outlined text-base md:text-lg">smart_toy</span>
    </div>

    <!-- الهيدر المخصص لديسكورد -->
    <%- include('partials/header') %>

    <!-- العنوان بسطر واحد مع الكرت المائل المميز -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 text-center">
      
      <div class="headline-unified-row mb-4">
        <span class="hero-single-line-text text-white">
          نوفر بيئة
        </span>

        <div class="badge-wrapper">
          <div class="badge-card-plate"></div>
          <span class="badge-word hero-single-line-text">
            آمنة ومتكاملة
          </span>
        </div>

        <span class="hero-single-line-text text-white">
          لمجتمع ديسكورد
        </span>
      </div>

      <p class="mt-6 text-sm sm:text-base md:text-lg text-white/90 max-w-xl mx-auto leading-relaxed font-normal">
        المكان الأنسب لتداول الخدمات الرقمية، إدارة الصفقات بوسطاء معتمدين، وتطوير خوادم ديسكورد بأقوى البوتات والحلول البرمجية.
      </p>

      <div class="mt-8 flex items-center justify-center gap-3 sm:gap-4 flex-wrap">
        <a href="https://discord.gg/ztPnPrPPM" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 px-6 sm:px-7 py-3 rounded-xl bg-[#ffd000] text-[#0a122c] font-bold text-xs sm:text-sm md:text-base shadow-lg shadow-black/20 hover:bg-[#ffe033] transition-all">
          <span>دخول السيرفر</span>
          <span class="material-symbols-outlined text-lg sm:text-xl transition-transform duration-300 ease-out group-hover:-translate-x-1.5">west</span>
        </a>

        <a href="/store" class="px-5 sm:px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs sm:text-sm md:text-base transition-colors">
          المتجر
        </a>
      </div>

    </div>

  </header>

  <!-- فاصل منحنى الانسياب -->
  <div class="relative w-full -mt-20 sm:-mt-28 md:-mt-36 z-20 pointer-events-none select-none">
    <svg class="w-full h-20 sm:h-28 md:h-36 text-slate-50 fill-current" viewBox="0 0 1440 220" preserveAspectRatio="none">
      <path d="M0,96L80,106.7C160,117,320,139,480,138.7C640,139,800,117,960,106.7C1120,96,1280,96,1360,96L1440,96L1440,220L1360,220C1280,220,1120,220,960,220C800,220,640,220,480,220C320,220,160,220,80,220L0,220Z"></path>
    </svg>
  </div>

  <!-- القسم الأبيض (Bento Grid لخدمات الديسكورد) -->
  <main class="relative bg-slate-50 pt-4 pb-20 z-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-xs font-bold text-blue-700 uppercase tracking-widest bg-blue-50 border border-blue-100 px-3 py-1 rounded-full">
          ماذا نقدم في المجتمع
        </span>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-3 tracking-tight">
          خدمات منصة Veloqra
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">

        <!-- كرت 1: المتجر الرقمي الموثق -->
        <div class="bento-card md:col-span-2 p-6 sm:p-8 flex flex-col justify-between">
          <div class="absolute -bottom-10 -right-10 w-44 h-44 bg-[#4287f5]/20 rounded-full blur-3xl pointer-events-none"></div>
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-2xl">storefront</span>
                </div>
                <div>
                  <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">سوق آمن</span>
                  <h4 class="text-lg sm:text-xl font-bold text-slate-900">المتجر الرقمي والبائعين المعتمدين</h4>
                </div>
              </div>
              <div class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-50 border border-blue-200/80 text-blue-700 text-xs font-bold shadow-sm">
                <span>توثيق رسمي</span>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed max-w-2xl relative z-10">
              قنوات مخصصة للتجار الموثقين لعرض تصاميمهم، برمجياتهم، وحساباتهم دون خوف من الاحتيال، مع ضمان التسليم ومراجعة مستمرة للتقييمات من قبل الإدارة.
            </p>
          </div>
        </div>

        <!-- كرت 2: نظام الوسطاء الماليين -->
        <div class="bento-card md:col-span-1 p-6 sm:p-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">handshake</span>
              </div>
              <div>
                <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">حماية 100%</span>
                <h4 class="text-base sm:text-lg font-bold text-slate-900">وسطاء معتمدين</h4>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              تأمين كافة العمليات المالية وصفقات التبادل بين الأطراف لضمان وصول الحقوق بالكامل.
            </p>
          </div>
        </div>

        <!-- كرت 3: فريق العمل والإدارة -->
        <a href="/discord/team" class="bento-card md:col-span-1 p-6 sm:p-7 flex flex-col justify-between group hover:border-blue-400">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-xl bg-amber-50 border border-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">groups</span>
              </div>
              <span class="material-symbols-outlined text-slate-400 group-hover:text-blue-600 transition-colors">arrow_back</span>
            </div>
            <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">من خلف الكواليس</span>
            <h4 class="text-base sm:text-lg font-bold text-slate-900 mt-0.5 mb-1.5">فريق العمل والإدارة</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              تعرف على المؤسسين والمطورين والمشرفين القائمين على إدارة ودعم المجتمع.
            </p>
          </div>
        </a>

        <!-- كرت 4: الانضمام للفريق والوظائف -->
        <a href="/jobs" class="bento-card md:col-span-1 p-6 sm:p-7 flex flex-col justify-between group hover:border-blue-400">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">badge</span>
              </div>
              <span class="material-symbols-outlined text-slate-400 group-hover:text-blue-600 transition-colors">arrow_back</span>
            </div>
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">كن جزءاً منا</span>
            <h4 class="text-base sm:text-lg font-bold text-slate-900 mt-0.5 mb-1.5">الوظائف والتقديم</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              اكتشف الوظائف الشاغرة كوسطاء، دعم فني، أو مراقبين وشاركنا في قيادة السيرفر.
            </p>
          </div>
        </a>

        <!-- كرت 5: الشروط واللوائح -->
        <a href="/terms" class="bento-card md:col-span-1 p-6 sm:p-7 flex flex-col justify-between group hover:border-blue-400">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-2xl">gavel</span>
              </div>
              <span class="material-symbols-outlined text-slate-400 group-hover:text-blue-600 transition-colors">arrow_back</span>
            </div>
            <span class="text-[11px] font-bold text-rose-600 uppercase tracking-wider">الاتفاقية الرسمية</span>
            <h4 class="text-base sm:text-lg font-bold text-slate-900 mt-0.5 mb-1.5">القواعد وشروط الخدمة</h4>
            <p class="text-slate-600 text-sm leading-relaxed">
              اطلع على الضوابط المعتمدة لعمليات الدفع، الاشتراكات، وقوانين التجارة الآمنة.
            </p>
          </div>
        </a>

      </div>

      <!-- إحصائيات السيرفر -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 font-mono">+1.7k</div>
          <div class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">عضو متفاعل</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-blue-600 font-mono">+0</div>
          <div class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">عملية وساطة ناجحة</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 font-mono">100%</div>
          <div class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">ضمان وأمان التعامل</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 font-mono">24/7</div>
          <div class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">حماية ونظام تذاكر</div>
        </div>
      </div>

      <!-- بطاقة دعوة الانضمام السريعة للسيرفر -->
      <div class="mt-12 p-6 sm:p-8 md:p-10 rounded-2xl bg-[#0a122c] text-white flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-right">
          <h4 class="text-xl sm:text-2xl font-bold">انضم لمجتمع فيلوكرا على ديسكورد</h4>
          <p class="text-slate-300 text-xs sm:text-sm mt-1">تفاعل مع المطورين، استفد من العروض، واحصل على دعم مباشر وسريع.</p>
        </div>
        <a href="https://discord.gg/ztPnPrPPM" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl bg-[#ffd000] text-[#0a122c] font-bold text-xs sm:text-sm hover:bg-[#ffe033] transition-colors whitespace-nowrap shadow-md">
          الدخول للمجتمع الآن
        </a>
      </div>

    </div>
  </main>

  <!-- فوتر الموقع المشترك الموحد -->
  <%- include('partials/footer') %>

  <!-- ملف الجافاسكريبت المشترك -->
  <script src="/js/script.js"></script>

</body>
</html>