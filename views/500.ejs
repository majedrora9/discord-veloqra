<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth overflow-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Veloqra - 500 خطأ في الخادم</title>

  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="shortcut icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">

  <!-- Google Fonts: IBM Plex Sans Arabic & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;900&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Outlined -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['IBM Plex Sans Arabic', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              blue: '#4287f5',
              navy: '#0a122c',
              yellow: '#ffd000'
            }
          }
        }
      }
    }
  </script>

  <!-- ملف التنسيقات الرئيسي -->
  <link rel="stylesheet" href="/css/main.css">

  <style>
    /* تنسيق الـ Header ليعمل فوق الخلفية البيضاء بدون خلفية زرقاء */
    .page-error-header nav {
      margin-bottom: 0 !important;
      padding-top: 1.5rem;
    }

    .page-error-header nav > div:first-child {
      background-color: rgba(255, 255, 255, 0.85) !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 20px -2px rgba(10, 18, 44, 0.05) !important;
    }

    .page-error-header nav span,
    .page-error-header nav a {
      color: #0a122c !important;
    }

    .page-error-header nav .hidden.md\:flex a:hover {
      color: #4287f5 !important;
    }

    .page-error-header nav .hidden.md\:block a {
      background-color: #0a122c !important;
      color: #ffffff !important;
      border-color: #0a122c !important;
    }
    .page-error-header nav .hidden.md\:block a:hover {
      background-color: #1e293b !important;
    }

    .page-error-header #burgerBtn {
      background-color: #f1f5f9 !important;
      border-color: #cbd5e1 !important;
    }
    .page-error-header #burgerBtn span {
      color: #0a122c !important;
    }

    /* محتوى صفحة خطأ السيرفر 500 */
    .error-hero-wrap {
      position: relative;
      min-height: calc(100vh - 200px);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2.5rem 1.5rem;
      overflow: hidden;
      z-index: 5;
    }

    /* رقم 500 العملاق الشفاف المتلاشي في الخلفية */
    .bg-faded-500 {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: clamp(14rem, 28vw, 26rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -10px;
      user-select: none;
      pointer-events: none;
      z-index: 1;
      font-family: 'JetBrains Mono', monospace;
      background: linear-gradient(180deg, rgba(239, 68, 68, 0.12) 0%, rgba(66, 135, 245, 0.02) 75%, transparent 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: blur(1px);
    }

    /* محتوى الخطأ بدون أي كرت أو خلفية */
    .error-content-box {
      position: relative;
      z-index: 2;
      max-width: 580px;
      padding: 0;
      background: transparent;
      border: none;
      box-shadow: none;
      animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .error-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: #ef4444;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
    }

    .error-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.8rem;
      line-height: 1.3;
    }

    .text-gradient-red {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .error-desc {
      color: #64748b;
      font-size: 1.05rem;
      line-height: 1.8;
      margin-bottom: 2.5rem;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 640px) {
      .error-title {
        font-size: 1.75rem;
      }
    }
  </style>
</head>
<body class="loading-active bg-white text-slate-800 antialiased selection:bg-[#ffd000] selection:text-[#0a122c] flex flex-col min-h-screen">

  <!-- لودر سادة أزرق بخلفية بيضاء -->
  <div id="page-loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="simple-spinner"></div>
  </div>

  <!-- الهيدر بخلفية بيضاء نقية وبدون خلفيات زرقاء -->
  <header class="page-error-header w-full relative z-30 bg-white">
    <%- include('partials/header') %>
  </header>

  <!-- مساحة الخطأ الرئيسية -->
  <main class="w-full relative flex-1 bg-white">
    <div class="error-hero-wrap">
      
      <!-- رقم 500 العملاق الشفاف في الخلفية -->
      <div class="bg-faded-500" aria-hidden="true">500</div>

      <!-- محتوى الخطأ بدون أي كرت خلفي -->
      <div class="error-content-box">

        <h1 class="error-title">
          نواجه مشكلة مؤقتة <br>
          <span class="text-gradient-red">في تشغيل الخدمة</span>
        </h1>

        <p class="error-desc">
          <%= typeof message !== 'undefined' && message ? message : 'حدث خطأ غير متوقع أثناء معالجة طلبك، فريق التطوير يعمل على حله حالياً.' %>
        </p>

        <div class="flex items-center justify-center gap-3 sm:gap-4 flex-wrap">
          <!-- زر إعادة المحاولة مع أيقونة refresh -->
          <button onclick="window.location.reload()" class="group inline-flex items-center gap-2 px-6 sm:px-7 py-3 rounded-xl bg-[#ffd000] text-[#0a122c] font-bold text-xs sm:text-sm md:text-base shadow-lg shadow-black/10 hover:bg-[#ffe033] transition-all cursor-pointer border-none">
            <span>إعادة المحاولة</span>
            <span class="material-symbols-outlined text-lg sm:text-xl transition-transform duration-300 group-hover:rotate-180">refresh</span>
          </button>

          <!-- زر الدعم الفني -->
          <a href="https://discord.gg/ztPnPrPPM" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 sm:px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200/80 border border-slate-200 text-slate-800 font-semibold text-xs sm:text-sm md:text-base transition-colors">
            <span>الدعم الفني</span>
            <span class="material-symbols-outlined text-lg sm:text-xl text-slate-600">support_agent</span>
          </a>
        </div>

      </div>

    </div>
  </main>

  <!-- فوتر الموقع المشترك بعرض كامل -->
  <div class="w-full mt-auto">
    <%- include('partials/footer') %>
  </div>

  <!-- ملف الجافاسكريبت الموحد للحماية واللودر -->
  <script src="/js/script.js"></script>

</body>
</html>